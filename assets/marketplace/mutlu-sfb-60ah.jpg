at mutlu.com.tr!"},{"path":"ru/radio-advertisements","type":"page","component":"Media","metaTitle":"","metaDescription":""},{"path":"ru/news","type":"page","component":"News","metaTitle":"","metaDescription":""},{"path":"ru/tv-commercials","type":"page","component":"Media","metaTitle":"","metaDescription":""},{"path":"ru/not-found","type":"page","component":"NotFound","metaDescription":"","metaTitle":""},{"path":"ru/oem","type":"page","component":"Oem","metaTitle":"Mutlu Battery OEM - Original Product Manufacturer | Mutlu Battery","metaDescription":"Your questions about Mutlu Battery OEM and Original Product Manufacturer are waiting for you at mutlu.com.tr!"},{"path":"ru/industrial","type":"page","component":"Industrial","metaTitle":"Mutlu Battery Industrial - Original Product Manufacturer | Mutlu Battery","metaDescription":"Your questions about Mutlu Battery Industrial are waiting for you at mutlu.com.tr!"},{"path":"ru/certificates","type":"page","component":"Certificates","metaTitle":"Mutlu Battery Certificates | Mutlu Battery","metaDescription":"Your questions about the certificates of Mutlu Battery are waiting for you at mutlu.com.tr!"},{"path":"ru/ohs-environmental-documents","type":"page","component":"Certificates","metaTitle":"Mutlu Battery Certificates | Mutlu Battery","metaDescription":"Your questions about the certificates of Mutlu Battery are waiting for you at mutlu.com.tr!"},{"path":"ru/quality-certificates","type":"page","component":"Certificates","metaTitle":"Mutlu Battery Certificates | Mutlu Battery","metaDescription":"Your questions about the certificates of Mutlu Battery are waiting for you at mutlu.com.tr!"},{"path":"ru/domestic-product-certificates","type":"page","component":"Certificates","metaTitle":"Mutlu Battery Certificates | Mutlu Battery","metaDescription":"Your questions about the certificates of Mutlu Battery are waiting for you at mutlu.com.tr!"},{"path":"ru/rd-certificates","type":"page","component":"Certificates","metaTitle":"Mutlu Battery Certificates | Mutlu Battery","metaDescription":"Your questions about the certificates of Mutlu Battery are waiting for you at mutlu.com.tr!"},{"path":"ru/social-responsibility-projects","type":"page","component":"SocialResponsibility","metaTitle":"Social Responsibility Projects | Mutlu Battery","metaDescription":"Your questions about the social responsibility projects realized and targeted by Mutlu Akü are waiting for you at mutlu.com.tr!"},{"path":"ru/vision-and-mission","type":"page","component":"VisionMission","metaTitle":"Mutlu Battery Vision and Mission| Mutlu Battery","metaDescription":"Your questions about Mutlu Battery's corporate culture and values, investment, innovation and business conduct are waiting for you at mutlu.com.tr!"},{"path":"ru/world-of-batteries","type":"page","component":"BlogIndex","metaTitle":"World of Batteries | Mutlu Battery","metaDescription":"Your questions about the technological developments of Mutlu Battery are waiting for you at mutlu.com.tr!"},{"path":"ru/^/blog/(.*)","type":"page","component":"Blog","metaTitle":"Technological Developments | Mutlu Battery","metaDescription":"Your questions about the technological developments of Mutlu Battery are waiting for you at mutlu.com.tr!"},{"path":"ru/about-batteries","type":"page","component":"BlogCategory","metaTitle":"Technologies | Mutlu Battery","metaDescription":"Your questions about the technologies used by Mutlu Akü in its products are waiting for you at mutlu.com.tr!"},{"path":"ru/disclosure-text","type":"page","component":"LegalText","metaTitle":"Disclosure Text | Mutlu Battery","metaDescription":"Mutlu Battery Disclosure Text."}],"initialData":{"globalCategories":[{"id":47,"name":"Binek Araçlar","slug":"binek-arac-akuleri","categoryOrder":0,"isActive":1,"slogan":"Binek Araç Kategorisi Ürünler","lang":"tr","shortDescription":"\u003cp\u003eMutlu Binek Ara\u0026ccedil; Ak\u0026uuml;leri, sahip olduğu y\u0026uuml;ksek teknolojiyle ara\u0026ccedil;ların enerji ihtiyacını karşılar. Farklı yol ve iklim koşullarında \u0026uuml;st d\u0026uuml;zey performans sunan Mutlu Ak\u0026uuml;ler, otomobiller i\u0026ccedil;in tam kapalı ve bakım gerektirmeyen şekilde tasarlanmıştır. Standart \u0026ouml;zellikli ara\u0026ccedil;lara uygun Mutlu Binek Ara\u0026ccedil; Ak\u0026uuml;leri her sınıf aracın değişen performans beklentilerini karşılar. Mutlu Start-Stop teknolojili Binek Ara\u0026ccedil; Ak\u0026uuml;leri ise, daha uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml; ve y\u0026uuml;ksek performansı ile Start-Stop teknolojili ara\u0026ccedil;ların y\u0026uuml;ksek enerji gereksinimlerine cevap verir.\u003c/p\u003e\n","subCategories":[{"name":"Standart Binek Araçlar","slug":"standart-binek-araclar","lang":"tr","shortDescription":"\u003cp\u003eOtomotiv sekt\u0026ouml;r\u0026uuml;nde seri olarak \u0026uuml;retilen, klasik ara\u0026ccedil; \u0026ccedil;alıştırma prensibine sahip olan binek otomobiller ve SUV olarak ifade edilen sportif ara\u0026ccedil;lar, yaygın olarak kullanılır. Bu ara\u0026ccedil;lar Start-Stop \u0026ouml;zelliğine sahip olmasalar da, ara\u0026ccedil; i\u0026ccedil;erisinde ihtiya\u0026ccedil; duyulan bir\u0026ccedil;ok elektriksel donanımı barındırabilirler. \u0026Ouml;zellikle kent trafiğinde sık\u0026ccedil;a kullanılan sedan, hatchback ve station wagon tipindeki otomobillerde marş basma ihtiyacı ve i\u0026ccedil; donanımların elektrik ihtiyacı y\u0026uuml;ksektir. Aynı şekilde hem arazi hem de kent i\u0026ccedil;i gibi farklı yol ve s\u0026uuml;r\u0026uuml;ş şartlarında kullanılan SUV ara\u0026ccedil;larda da y\u0026uuml;ksek dayanımlı ak\u0026uuml;lerin tercih edilmesi gerekir. Bu kadar yaygın kullanılan ve klasik marş y\u0026ouml;ntemiyle \u0026ccedil;alışan her iki ara\u0026ccedil; tipi i\u0026ccedil;in de uzun \u0026ouml;m\u0026uuml;rl\u0026uuml;, bakım gerektirmeyen ve ara\u0026ccedil; \u0026uuml;reticilerinin kriterlerini karşılayan ak\u0026uuml;lerin kullanılması gerekir. Mutlu Ak\u0026uuml;; standart binek ara\u0026ccedil;lar i\u0026ccedil;in sunduğu geniş \u0026uuml;r\u0026uuml;n yelpazesiyle, farklı ara\u0026ccedil; tiplerinin y\u0026uuml;ksek enerji gereksinimlerini karşılar. Mutlu Ak\u0026uuml;\u0026rsquo;n\u0026uuml;n \u0026uuml;r\u0026uuml;n gamı i\u0026ccedil;erisinde yer alan EFB, SFB Avrupa Tip ve SFB Japon Tip Ak\u0026uuml;leri tercih edebilirsiniz.\u003c/p\u003e\n\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eMutlu Ak\u0026uuml;\u0026rsquo;n\u0026uuml;n standart binek ara\u0026ccedil;lar i\u0026ccedil;in sunduğu EFB Ak\u0026uuml;ler, geliştirilmiş sulu tip ak\u0026uuml; teknolojisine sahiptir. Standart ak\u0026uuml;lere g\u0026ouml;re %30\u0026rsquo;a kadar daha y\u0026uuml;ksek performans sunan Mutlu EFB Ak\u0026uuml;ler, 2 kata kadar daha uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml;yle de avantaj sağlar. Start-Stop \u0026ouml;zelliği olmayan ara\u0026ccedil;larda daha uzun s\u0026uuml;reli kullanım ve y\u0026uuml;ksek marş g\u0026uuml;c\u0026uuml; i\u0026ccedil;in Mutlu EFB Ak\u0026uuml;ler tercih edilebilir. Bakım gerektirmeyen \u0026uuml;r\u0026uuml;n teknolojileri, tam kapalı kapak sistemi ve standart ak\u0026uuml;lere g\u0026ouml;re daha y\u0026uuml;ksek titreşim dayanımlarıyla standart binek ara\u0026ccedil;ların ihtiya\u0026ccedil;larına en iyi şekilde cevap verirler.\u003c/p\u003e\n\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eMutlu SFB ak\u0026uuml;ler, SFB Avrupa Tip ve SFB Japon Tip Ak\u0026uuml; se\u0026ccedil;enekleriyle binek ara\u0026ccedil;ların gereksinimlerine cevap verir. SFB Avrupa Tip Ak\u0026uuml;ler, Avrupa k\u0026ouml;kenli standart binek ara\u0026ccedil;larda kullanılırken, SFB Japon Tip Ak\u0026uuml;ler ise Asya k\u0026ouml;kenli standart binek ara\u0026ccedil;larda kullanılır. Bu ak\u0026uuml;ler, ara\u0026ccedil;ların enerji ihtiyacını \u0026uuml;st d\u0026uuml;zeyde karşılarken, uzun kullanım \u0026ouml;mr\u0026uuml; sayesinde ara\u0026ccedil;ların kesintisiz \u0026ccedil;alışmasına katkı sağlar. Standart ak\u0026uuml;lere g\u0026ouml;re %25\u0026rsquo;e kadar daha y\u0026uuml;ksek performans ve titreşim dayanımıyla avantajlıdır. Bakım gerektirmeyen \u0026uuml;r\u0026uuml;n teknolojisine sahip SFB Avrupa Tip ve SFB Japon Tip Ak\u0026uuml;ler, tam kapalı kapak sistemleriyle maksimum g\u0026uuml;venlik sunarlar. Tasarımında yer alan kapak i\u0026ccedil;i labirent yapı, alev tutucu filtre, ergonomik kulp ve ak\u0026uuml; şarj seviyesini g\u0026ouml;steren indikat\u0026ouml;r gibi bileşenleriyle kullanıcı ve ara\u0026ccedil; dostudur.\u003c/p\u003e\n","imageUrls":[{"type":"list","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/87075.jpg"},{"type":"cover","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/12221.png"}]},{"name":"Start-Stop Teknolojili Binek Araçlar","slug":"start-stop-teknoloji-binek-araclar-akuleri","lang":"tr","shortDescription":"\u003cp\u003eG\u0026uuml;n\u0026uuml;m\u0026uuml;zde otomotiv\u0026nbsp;end\u0026uuml;strisinde \u0026uuml;retilen bir\u0026ccedil;ok binek ara\u0026ccedil;ta Start-Stop sistemi yer alır. Bu sistemde, seyir halindeki ara\u0026ccedil; durduğunda motor kapanır ve r\u0026ouml;lanti halinde oluşan yakıt t\u0026uuml;ketimi ile CO2 (karbondioksit) salımının \u0026ouml;n\u0026uuml;ne ge\u0026ccedil;ilir. 2015 yılından sonra, \u0026ldquo;d\u0026uuml;ş\u0026uuml;r\u0026uuml;lm\u0026uuml;ş CO2 salımı\u0026rdquo; hedefini yakalamak amacıyla \u0026ldquo;yeni nesil\u0026rdquo; taşıtlarda Start-Stop sistemi standart hale getirilmeye \u0026ccedil;alışılmaktadır. Bu sisteme sahip ara\u0026ccedil;lar, trafikteki dur-kalk hareketlerinde sık sık marş yaptığı i\u0026ccedil;in daha fazla ak\u0026uuml; enerjisine gereksinim duyar. Dolayısıyla standart ak\u0026uuml;lerden daha y\u0026uuml;ksek \u0026ccedil;evrimli ve hızlı şarj edilebilir ak\u0026uuml;lerin kullanılması gerekir. Start-Stop ak\u0026uuml;ler olarak tanımlanan ve \u0026ouml;zel olarak geliştirilen ak\u0026uuml; \u0026ccedil;eşitleri, ayrıca kendi i\u0026ccedil;lerinde de farklı \u0026ccedil;eşitlere ayrılır. Mutlu Ak\u0026uuml;; Start-Stop teknolojili binek ara\u0026ccedil;lar i\u0026ccedil;in en uygun ak\u0026uuml; se\u0026ccedil;eneklerini sunarak ara\u0026ccedil;ların her koşulda y\u0026uuml;ksek marş g\u0026uuml;c\u0026uuml;yle hareket kabiliyetini kazanmasına destek olur. Bu kapsamda otomobil ve SUV binek ara\u0026ccedil;larınız i\u0026ccedil;in Mutlu Ak\u0026uuml; \u0026uuml;r\u0026uuml;n gamından AGM ve EFB ak\u0026uuml;leri tercih edebilirsiniz.\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eMutlu Ak\u0026uuml;\u0026rsquo;n\u0026uuml;n Start-Stop teknolojili binek ara\u0026ccedil;lar i\u0026ccedil;in sunduğu AGM Ak\u0026uuml;ler, sahip olduğu VRLA teknolojisi sayesinde standart ak\u0026uuml;lere g\u0026ouml;re 3 kat daha uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml; ve y\u0026uuml;ksek şarj alma \u0026ouml;zelliği bulunmaktadır. Standart ak\u0026uuml;lere g\u0026ouml;re y\u0026uuml;zde 40\u0026rsquo;a kadar daha y\u0026uuml;ksek performans sağlayan AGM Ak\u0026uuml;ler, rejeneratif frenleme sistemine sahip \u0026uuml;st segment Start-Stop binek otomobiller i\u0026ccedil;in uygundur. Bu \u0026ouml;zelliğe sahip ara\u0026ccedil;larda fren enerjisi, depolanması amacıyla elektrik enerjisine \u0026ccedil;evrilerek AGM ak\u0026uuml;ye iletilir. Ak\u0026uuml; de alternat\u0026ouml;rden bağımsız olarak şarj olur. Bu işlem de motor \u0026uuml;zerinde alternat\u0026ouml;re daha az y\u0026uuml;k binmesini beraberinde getirir ve ara\u0026ccedil; yakıt t\u0026uuml;ketiminden tasarruf eder. Mutlu AGM Ak\u0026uuml;ler; ara\u0026ccedil; kısa bir s\u0026uuml;reliğine \u0026ccedil;alışsa bile \u0026ccedil;abuk şarj edilebilir. \u0026nbsp;Standart ak\u0026uuml;lere g\u0026ouml;re daha y\u0026uuml;ksek titreşim dayanımı g\u0026ouml;steren Mutlu AGM Ak\u0026uuml;ler, zorlu iklim koşullarında \u0026uuml;st\u0026uuml;n performans g\u0026ouml;sterir. \u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eMutlu EFB Ak\u0026uuml;ler, g\u0026uuml;\u0026ccedil;lendirilmiş i\u0026ccedil; yapısıyla uzun standart ak\u0026uuml;lere g\u0026ouml;re 2 kat daha uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml;ne sahiptir. \u0026nbsp;Start-Stop teknolojili binek ara\u0026ccedil;ların enerji gereksinimleri doğrultusunda \u0026ouml;zel olarak tasarlanmış Mutlu EFB Ak\u0026uuml;ler, standart ak\u0026uuml;lere g\u0026ouml;re y\u0026uuml;zde 30\u0026rsquo;a kadar daha y\u0026uuml;ksek performans sunar. Titreşim dayanımı \u0026ouml;zelliği sayesinde zorlu iklim ve yol koşullarında kullanıma uygundur. \u0026nbsp;Ara\u0026ccedil;larda bulunan Start-Stop sisteminin verimli bir şekilde kullanılabilmesi adına hızlı şarj alma \u0026ouml;zelliğiyle tasarlanmıştır. Start-Stop sistemi sayesinde Mutlu EFB Ak\u0026uuml;ler, d\u0026uuml;ş\u0026uuml;k karbon salımını da destekler.\u0026nbsp;\u003c/p\u003e\n","imageUrls":[{"type":"list","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/20654.png"},{"type":"cover","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/31495.png"}]}]},{"id":48,"name":"Hafif Ticari Araçlar","slug":"hafif-ticari-araclar","categoryOrder":1,"isActive":1,"slogan":"Hafif Ticari Araçlar","lang":"tr","shortDescription":"\u003cp\u003eMutlu Hafif Ticari Ara\u0026ccedil; Ak\u0026uuml;leri; g\u0026uuml;n i\u0026ccedil;ersinde yoğun kullanılan pick up, minivan, panelvan, kamyonet, minib\u0026uuml;s ve taksilerin enerji ihtiya\u0026ccedil;larını karşılar. G\u0026uuml;n\u0026uuml;m\u0026uuml;z hafif ticari ara\u0026ccedil;ları sahip oldukları y\u0026uuml;ksek elektronik donanımları ve elektrikli ekipmanlarıyla yoğun enerji t\u0026uuml;ketirler. \u0026Ouml;zellikle i\u0026ccedil; aydınlatma, klima kullanımı, navigasyon sistemleri, radyo gibi elektrikli alıcılara motor kapalı durumdayken de ihtiya\u0026ccedil; olabilir. Mutlu Ak\u0026uuml;, \u0026nbsp;geniş \u0026uuml;r\u0026uuml;n gamında yer alan SFB, EFB ve AGM teknolojili \u0026uuml;r\u0026uuml;nleriyle hafif ticari ara\u0026ccedil; kullanıcılarının beklentilerine cevap verir. \u0026nbsp;Her \u0026ccedil;alışma ve iklim koşulunda \u0026uuml;st d\u0026uuml;zey performans sunan Mutlu Hafif Ticari Ara\u0026ccedil; Ak\u0026uuml;leri, y\u0026uuml;ksek \u0026ccedil;evrim \u0026ouml;m\u0026uuml;rleriyle de tercih edilmektedir.\u003c/p\u003e\n","subCategories":[{"name":"Pick Up","slug":"pick-up-akuleri","lang":"tr","shortDescription":"\u003cp\u003eFarklı zemin ve iklim koşullarında kullanılan pick up ara\u0026ccedil;larda g\u0026uuml;\u0026ccedil;, en \u0026ouml;nemli fakt\u0026ouml;rd\u0026uuml;r. Pick up ara\u0026ccedil;ların kullanıldığı kayalık alanlar, bozuk yollar, ormanlık araziler ve kent kullanımları gibi değişken yol koşullarında gereken g\u0026uuml;c\u0026uuml;, pick up ak\u0026uuml;s\u0026uuml; sağlar. Mutlu Ak\u0026uuml;, 4x2, 4x4 veya off-road pick up ara\u0026ccedil;lar i\u0026ccedil;in en uygun ak\u0026uuml;lerini sunarak pick up\u0026rsquo;ların her zaman zorlu şartlarda y\u0026uuml;ksek performanslı s\u0026uuml;r\u0026uuml;şe hazır olmasını sağlar. Pick up\u0026#39;larınız i\u0026ccedil;in Mutlu Ak\u0026uuml; \u0026uuml;r\u0026uuml;n gamından EFB, SFB Avrupa Tip ve SFB Japon Tip Ak\u0026uuml;leri tercih edebilirsiniz.\u003cbr /\u003e\n\u003cbr /\u003e\nGeliştirilmiş sulu tip ak\u0026uuml; teknolojisine sahip Mutlu EFB Ak\u0026uuml;leri, Start-Stop teknolojili pick up ara\u0026ccedil;ların EFB Ak\u0026uuml; ihtiyacını karşılar. Standart \u0026ouml;zellikli pick up ara\u0026ccedil;larda da daha uzun s\u0026uuml;reli ve y\u0026uuml;ksek performanslı kullanım i\u0026ccedil;in Mutlu EFB Ak\u0026uuml;ler tercih edilebilir. Mutlu EFB Ak\u0026uuml;, standart ak\u0026uuml;lere g\u0026ouml;re %30\u0026rsquo;a kadar daha y\u0026uuml;ksek performans sunarken 2 kata kadar daha uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml;yle de avantaj sağlar. Yeni nesil pick up ara\u0026ccedil;larda yaygın olan Start-Stop teknolojisine uygun hızlı şarj alma \u0026ouml;zelliğiyle yola her zaman hazırdır. D\u0026uuml;ş\u0026uuml;k karbon salımını destekleyen Start-Stop teknolojili ara\u0026ccedil;lara uygun yapısıyla Mutlu EFB Ak\u0026uuml;ler, zorlu iklim şartlarında pick up ara\u0026ccedil;lar i\u0026ccedil;in \u0026uuml;st\u0026uuml;n performans sunar.\u003cbr /\u003e\n\u003cbr /\u003e\nMutlu Ak\u0026uuml;\u0026rsquo;n\u0026uuml;n pick up ara\u0026ccedil;lara uygun diğer bir \u0026uuml;r\u0026uuml;n ailesi ise SFB Ak\u0026uuml;lerdir. Mutlu SFB Japon Tip Ak\u0026uuml;ler, Asya k\u0026ouml;kenli ve Start-Stop \u0026ouml;zelliğine sahip olmayan pick up ara\u0026ccedil;larda kullanılır. Mutlu SFB Avrupa Tip Ak\u0026uuml;ler ise Avrupa k\u0026ouml;kenli, Start-Stop \u0026ouml;zelliğine sahip olmayan pick up ara\u0026ccedil;larda kullanılır. Mutlu SFB Ak\u0026uuml; teknolojisi, ara\u0026ccedil;ların elektrik ihtiyacını \u0026uuml;st d\u0026uuml;zeyde karşılar ve uzun kullanım \u0026ouml;mr\u0026uuml; sayesinde ara\u0026ccedil;ların kesintisiz \u0026ccedil;alışmasına katkı sağlar. SFB Ak\u0026uuml; ailesi, standart ak\u0026uuml;lere g\u0026ouml;re %25\u0026rsquo;e kadar y\u0026uuml;ksek performans sunar. Zorlu iklim şartlarındaki performansı ve y\u0026uuml;ksek titreşim dayanımıyla Mutlu SFB Ak\u0026uuml; \u0026uuml;r\u0026uuml;n ailesi, bakım gerektirmeyen tam kapalı kapak sistemine sahiptir.\u003c/p\u003e\n","imageUrls":[{"type":"list","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/69354.png"},{"type":"cover","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/80974.png"}]},{"name":"Minibüs","slug":"minibus-akuleri","lang":"tr","shortDescription":"\u003cp\u003eEn sık kullanılan toplu taşıma ara\u0026ccedil;ları arasında yer alan minib\u0026uuml;sler, boyutları ve s\u0026uuml;r\u0026uuml;ş kolaylıklarıyla kent hayatının ihtiya\u0026ccedil;larını karşılamaktadır. Aynı zamanda minib\u0026uuml;slerin van versiyonları da yine şehir i\u0026ccedil;i dağıtımda yaygın olarak yer alır. G\u0026uuml;n i\u0026ccedil;inde yoğun kullanılan ve y\u0026uuml;ksek enerji ihtiyacı olan minib\u0026uuml;slerin elektrik beslemesi, doğru minib\u0026uuml;s ak\u0026uuml;s\u0026uuml; ile yapılmalıdır. İster personel taşıma ve hatlı tarifede kullanılan, ister van tipiyle y\u0026uuml;k taşınan minib\u0026uuml;sleriniz i\u0026ccedil;in Mutlu Ak\u0026uuml;\u0026#39;n\u0026uuml;n \u0026uuml;r\u0026uuml;n gamından AGM, EFB, SFB Avrupa / Japon Tip ve SFB Seri 1 / Seri 2 Ağır Hizmet ak\u0026uuml;lerini tercih edebilirsiniz.\u003cbr /\u003e\n\u003cbr /\u003e\nMutlu Ak\u0026uuml;\u0026rsquo;n\u0026uuml;n, minib\u0026uuml;slerin ihtiyacı olan enerjiyi sağlamak i\u0026ccedil;in sunduğu \u0026uuml;r\u0026uuml;nler arasında yer alan Mutlu AGM Ak\u0026uuml;ler, \u0026ouml;zel i\u0026ccedil; yapısı ve VRLA teknolojisiyle standart ak\u0026uuml;lere g\u0026ouml;re y\u0026uuml;zde 40\u0026rsquo;a kadar daha y\u0026uuml;ksek performans sunar. Rejeneratif frenleme \u0026ouml;zelliği i\u0026ccedil;eren Start-Stop teknolojisine sahip minib\u0026uuml;slerde kullanılan AGM Ak\u0026uuml;ler, standart ak\u0026uuml;lere g\u0026ouml;re daha y\u0026uuml;ksek titreşim dayanımı sağlar.\u003cbr /\u003e\n\u003cbr /\u003e\nGeliştirilmiş sulu tip ak\u0026uuml; teknolojisine sahip Mutlu EFB Ak\u0026uuml;ler, 2 kata kadar daha uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml; ve Start-Stop teknolojisine uygun hızlı şarj alma \u0026ouml;zelliğiyle g\u0026uuml;n boyunca yoğun \u0026ccedil;alışan minib\u0026uuml;sler i\u0026ccedil;in ideal ak\u0026uuml;lerdir.\u003cbr /\u003e\n\u003cbr /\u003e\nMutlu Ak\u0026uuml;, bakım gerektirmeyen sulu tip ak\u0026uuml; teknolojisine sahip SFB ak\u0026uuml;leriyle de minib\u0026uuml;slerin ak\u0026uuml; ihtiyacını eksiksiz karşılar. Standart ak\u0026uuml;lere g\u0026ouml;re y\u0026uuml;zde 25\u0026rsquo;e kadar daha y\u0026uuml;ksek performans sağlayan Mutlu SFB ak\u0026uuml;lerden; SFB Japon Tip Ak\u0026uuml;ler Asya k\u0026ouml;kenli minib\u0026uuml;slerde, SFB Avrupa Tip Ak\u0026uuml;ler de Avrupa k\u0026ouml;kenli minib\u0026uuml;slerde kullanılır.\u003cbr /\u003e\n\u003cbr /\u003e\nMutlu Ak\u0026uuml;, daha y\u0026uuml;ksek performans ihtiyacı olan minib\u0026uuml;sler i\u0026ccedil;in ise SFB Seri 1 ve Seri 2 Ağır Hizmet (HD) Ak\u0026uuml;lerini sunar. SFB Seri 1 HD ve SFB Seri 2 HD Ak\u0026uuml;ler; zorlu iklimlere karşı daha y\u0026uuml;ksek performans sunmaları, bakım gerektirmeyen \u0026uuml;r\u0026uuml;n teknolojisi ve y\u0026uuml;ksek titreşim direnci \u0026ouml;zellikleriyle avantaj sağlar.\u003c/p\u003e\n","imageUrls":[{"type":"list","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/66988.png"},{"type":"cover","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/65373.png"}]},{"name":"Kamyonet","slug":"kamyonet-akuleri","lang":"tr","shortDescription":"\u003cp\u003eKamyonetler belli bir azami seviyeye kadar y\u0026uuml;k taşıyabilen ve ağırlıklı olarak kent i\u0026ccedil;erisinde \u0026ccedil;alışan ara\u0026ccedil;lardır. Eşya, inşaat malzemesi, gıda malzemesi taşımacılığı gibi bir\u0026ccedil;ok alanda kullanılabilirler. Kamyonetlere uygun ak\u0026uuml;lerin se\u0026ccedil;imi, ara\u0026ccedil;ların operasyonlarını kesintisiz s\u0026uuml;rd\u0026uuml;rmeleri a\u0026ccedil;ısından \u0026ouml;nemlidir. Mutlu Ak\u0026uuml;, kamyonetlerin ihtiyacı olan marş g\u0026uuml;c\u0026uuml;n\u0026uuml;n yanında, ara\u0026ccedil; \u0026ccedil;alışmadığı zamanlarda \u0026ccedil;eşitli ekipmanların gereksinim duyabileceği enerji desteğini sağlar. Kamyonetleriniz i\u0026ccedil;in, Mutlu Ak\u0026uuml; \u0026uuml;r\u0026uuml;n grubunda yer alan SFB Avrupa Tip, SFB Japon Tip, SFB Seri 1 Ağır Hizmet ve SFB Seri 2 Ağır Hizmet Ak\u0026uuml;leri tercih edebilirsiniz.\u003cbr /\u003e\n\u003cbr /\u003e\nMutlu Ak\u0026uuml;\u0026rsquo;n\u0026uuml;n kamyonetler i\u0026ccedil;in sunduğu SFB Avrupa Tip Ak\u0026uuml;ler, Avrupa k\u0026ouml;kenli kamyonetlerde kullanılırken, SFB Japon Tip Ak\u0026uuml;ler ise Asya k\u0026ouml;kenli kamyonetlerde tercih edilir. Uzun kullanım \u0026ouml;mr\u0026uuml; sayesinde ara\u0026ccedil;ların kesintisiz \u0026ccedil;alışmasına katkı sağlayan teknolojisiyle kamyonetlerin enerji ihtiyacını \u0026uuml;st d\u0026uuml;zeyde karşılar. SFB Avrupa Tip ve SFB Japon Tip Ak\u0026uuml;ler, standart ak\u0026uuml;lere g\u0026ouml;re %25\u0026rsquo;e kadar daha y\u0026uuml;ksek performansı ve titreşim dayanımlarıyla avantajlıdırlar. Tam kapalı kapak sistemiyle maksimum g\u0026uuml;venlik sunan SFB Avrupa Tip ve SFB Japon Tip Ak\u0026uuml;ler, bakım gerektirmeyen \u0026uuml;r\u0026uuml;n teknolojisine sahiptir. Kamyonetlerin \u0026ccedil;alıştığı zorlu iklim, arazi ve yol şartlarında, standart ak\u0026uuml;lere g\u0026ouml;re daha \u0026uuml;st\u0026uuml;n performans sergilerler.\u003cbr /\u003e\n\u003cbr /\u003e\nMutlu Ak\u0026uuml;\u0026rsquo;n\u0026uuml;n SFB teknolojisiyle sunduğu SFB Seri 1 Ağır Hizmet ve SFB Seri 2 Ağır Hizmet Ak\u0026uuml;ler, kamyonetler i\u0026ccedil;in tercih edilen ak\u0026uuml;ler arasında yer alır. Her iki ak\u0026uuml; grubu da bakım gerektirmeyen \u0026uuml;r\u0026uuml;n teknolojileri, zorlu koşullardaki \u0026uuml;st\u0026uuml;n performansları ve y\u0026uuml;ksek titreşim dayanımlarıyla avantaj sağlar. SFB Seri 1 Ağır Hizmet ve SFB Seri 2 Ağır Hizmet Ak\u0026uuml;ler, patentli kalsiyum (Ca) alaşımlı ızgara teknolojileriyle ağır hizmetlerde \u0026ccedil;alışan kamyonetler i\u0026ccedil;in uygun bir \u0026ccedil;\u0026ouml;z\u0026uuml;md\u0026uuml;r.\u003c/p\u003e\n","imageUrls":[{"type":"list","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/77504.png"},{"type":"cover","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/65656.png"}]},{"name":"Taksi","slug":"taksi-akuleri","lang":"tr","shortDescription":"\u003cp\u003eYoğun kullanıma sahip taksilerdeki enerji ihtiya\u0026ccedil;ları, standart binek otomobillere g\u0026ouml;re daha y\u0026uuml;ksektir. Neredeyse haftanın 7 g\u0026uuml;n\u0026uuml; 24 saat \u0026ccedil;alışabilen taksilerde kullanılan ak\u0026uuml;ler, uzun mesai saatlerine uyumlu olarak se\u0026ccedil;ilmelidir. \u0026Ouml;zellikle tepe lambası, sık kullanılan klima, aydınlatma, şarj kabloları ve navigasyon cihazı gibi elektrik t\u0026uuml;keten unsurlar g\u0026ouml;z \u0026ouml;n\u0026uuml;ne alındığında, taksi ak\u0026uuml;lerinin \u0026ouml;mr\u0026uuml; ve dayanımı \u0026uuml;st d\u0026uuml;zeyde olmalıdır. Mutlu Ak\u0026uuml; \u0026uuml;r\u0026uuml;n gamı, taksileriniz i\u0026ccedil;in uygun olacak şekilde uzun \u0026ccedil;alışma saatlerine karşı yeterli g\u0026uuml;c\u0026uuml; sunan EFB ve SFB Taksi Ak\u0026uuml;leri ile avantaj sağlar.\u003cbr /\u003e\n\u003cbr /\u003e\nMutlu Ak\u0026uuml;\u0026#39;n\u0026uuml;n geliştirilmiş sulu tip ak\u0026uuml; teknolojili EFB Ak\u0026uuml;leri, Start-Stop ara\u0026ccedil;lara uygun hızlı şarj alma \u0026ouml;zelliği, standart sulu tip ak\u0026uuml;lere g\u0026ouml;re 2 kat uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml; ve zorlu iklim şartlarında dayanıklılığıyla \u0026ouml;n plana \u0026ccedil;ıkar. Standart ak\u0026uuml;lere g\u0026ouml;re %30\u0026#39;a kadar daha y\u0026uuml;ksek performans sunan EFB Ak\u0026uuml;ler, aynı zamanda d\u0026uuml;ş\u0026uuml;k karbon salımını destekleyen Start-Stop \u0026ouml;zellikli taksilere uygunluk g\u0026ouml;sterir. Geliştirilmiş ızgara teknolojisiyle y\u0026uuml;ksek kısa devre dayanımı sunan Mutlu EFB Ak\u0026uuml;ler, artırılmış elektrolit rezerviyle de daha uzun kullanım sağlar.\u003cbr /\u003e\n\u003cbr /\u003e\nMutlu Ak\u0026uuml;; bakım gerektirmeyen sulu tip ak\u0026uuml; teknolojisine sahip, Mutlu SFB Taksi Ak\u0026uuml;leri ile taksilerin enerji ihtiyacını karşılar. Aracın marş g\u0026uuml;c\u0026uuml; ihtiya\u0026ccedil;larına cevap veren ve motor \u0026ccedil;alışmadığı durumlarda gerekli enerjiyi sağlayan Mutlu Taksi SFB Ak\u0026uuml;leri, y\u0026uuml;ksek \u0026ccedil;evrim \u0026ouml;mr\u0026uuml;yle ticari taksilerin beklentilerini karşılar. Standart ak\u0026uuml;lere g\u0026ouml;re %25\u0026rsquo;e kadar daha y\u0026uuml;ksek performans sağlayan Mutlu SFB Taksi Ak\u0026uuml;leri; zorlu iklim şartlarında standart ak\u0026uuml;lere g\u0026ouml;re daha \u0026uuml;st\u0026uuml;n performans sunar. Bakım gerektirmeyen \u0026uuml;r\u0026uuml;n teknolojisiyle de Mutlu SFB Taksi Ak\u0026uuml;leri, kullanıcılarına avantaj sağlar.\u003c/p\u003e\n","imageUrls":[{"type":"list","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/73881.png"},{"type":"cover","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/15799.png"}]},{"name":"Minivan / Panelvan","slug":"minivan-panelvan-akuleri","lang":"tr","shortDescription":"\u003cp\u003eHem kent i\u0026ccedil;i g\u0026uuml;nl\u0026uuml;k s\u0026uuml;r\u0026uuml;şlerde hem de uzun yolculuklarda tercih edilen panelvan ve minivanlar, yoğun mesai harcayabilen taşıtlardır. İla\u0026ccedil; taşımacılığından gıdaya, VIP hizmetlerden soğuk zincir taşımacılığına kadar pek \u0026ccedil;ok ticari ama\u0026ccedil;la kullanılabilen minivan veya panelvanlarda; ara\u0026ccedil; i\u0026ccedil;i radyo, klima ve aydınlatma gibi alıcılar sık\u0026ccedil;a kullanılır. \u0026Ouml;zellikle panelvanların ekstra donanım ve ekipmanları olabilir. Minivanlar ise panelvanlardan farklı olarak yolcu taşımacılığında ve bireysel kullanımda da tercih edilir. Gelişmiş teknolojilere ve l\u0026uuml;ks donanımlara sahip olabilen minivanlarda, yolcu konforuna y\u0026ouml;nelik donanımlar sorunsuz \u0026ccedil;alışmalıdır. Mutlu Ak\u0026uuml;, g\u0026uuml;nl\u0026uuml;k \u0026ccedil;alışma rutinlerini aksatmayacak şekilde minivan ve panelvanlara uygun ak\u0026uuml; se\u0026ccedil;eneklerine sahiptir. Mutlu Ak\u0026uuml; \u0026uuml;r\u0026uuml;n yelpazesi arasında yer alan AGM, EFB ve SFB Avrupa Tip / Japon Tip Ak\u0026uuml;leri, minivan ve panelvanlarınızda tercih edebilirsiniz.\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eStandart sulu tip ak\u0026uuml;lere g\u0026ouml;re 3 kat uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml;ne sahip olan Mutlu AGM Ak\u0026uuml;ler, rejeneratif frenleme \u0026ouml;zelliği i\u0026ccedil;eren Start-Stop teknolojisine sahip minivan ve panelvanların AGM Ak\u0026uuml; ihtiyacını karşılar. Mutlu AGM Ak\u0026uuml;ler; \u0026ouml;zel i\u0026ccedil; yapısı ve bakım gerektirmeyen VRLA teknolojisiyle standart ak\u0026uuml;lere g\u0026ouml;re y\u0026uuml;zde 40\u0026rsquo;a kadar daha y\u0026uuml;ksek performans sunar. Mutlu AGM Ak\u0026uuml;ler, zorlu iklim şartlarında da \u0026uuml;st\u0026uuml;n performansını s\u0026uuml;rd\u0026uuml;r\u0026uuml;r.\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eMutlu EFB Ak\u0026uuml;ler ise geliştirilmiş sulu tip ak\u0026uuml; teknolojisine sahiptir. Start-Stop teknolojili minivan ve panelvan ara\u0026ccedil;ların EFB Ak\u0026uuml; ihtiyacını karşılayan Mutlu EFB Ak\u0026uuml;ler, standart ak\u0026uuml;lere g\u0026ouml;re %30\u0026rsquo;a kadar daha y\u0026uuml;ksek performans sunar. 2 kata kadar daha uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml;yle ve Start-Stop teknolojisine uygun hızlı şarj alma \u0026ouml;zelliğiyle de ara\u0026ccedil;ları yolculuklara hazır tutar. D\u0026uuml;ş\u0026uuml;k karbon salımını destekleyen Start-Stop teknolojili ara\u0026ccedil;lara uygun yapısıyla Mutlu EFB Ak\u0026uuml;ler, zorlu iklim şartlarında standart ak\u0026uuml;lere g\u0026ouml;re daha \u0026uuml;st\u0026uuml;n performans sağlar.\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eSFB Ak\u0026uuml;ler, Mutlu Ak\u0026uuml;\u0026rsquo;n\u0026uuml;n minivan ve panelvan ara\u0026ccedil;lar i\u0026ccedil;in uygun olan diğer bir ak\u0026uuml; se\u0026ccedil;eneğidir. Mutlu SFB Japon Tip Ak\u0026uuml;ler Asya k\u0026ouml;kenli olup, Start-Stop \u0026ouml;zelliğine sahip olmayan minivan ve panelvanlarda kullanılır. Mutlu SFB Avrupa Tip Ak\u0026uuml;ler ise Avrupa k\u0026ouml;kenli Start-Stop \u0026ouml;zelliğine sahip olmayan minivan ve panelvanlar i\u0026ccedil;indir. Ara\u0026ccedil;ların enerji ihtiyacını \u0026uuml;st d\u0026uuml;zeyde karşılayan Mutlu SFB Ak\u0026uuml; teknolojisi, uzun kullanım \u0026ouml;mr\u0026uuml; sayesinde ara\u0026ccedil;ların kesintisiz \u0026ccedil;alışmasına katkı sağlar. Birbirinden farklı \u0026ouml;zellikleri bulunabilen minivan ve panelvanların, donanım seviyelerine bağlı olarak farklı kapasite alternatifleriyle sunulan SFB Ak\u0026uuml; ailesi, standart ak\u0026uuml;lere g\u0026ouml;re y\u0026uuml;zde 25\u0026rsquo;e kadar y\u0026uuml;ksek performans sunar.\u0026nbsp;\u003c/p\u003e\n","imageUrls":[{"type":"list","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/51436.png"},{"type":"cover","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/45565.png"}]}]},{"id":49,"name":"Ağır Ticari Araçlar","slug":"agir-ticari-arac-akuleri","categoryOrder":2,"isActive":1,"slogan":"Ağır Ticari Araçlar","lang":"tr","shortDescription":"\u003cp\u003eMutlu Ağır Ticari Ara\u0026ccedil; Ak\u0026uuml;leri; kamyon, tır, otob\u0026uuml;s, iş makineleri, inşaat ekipmanları, trakt\u0026ouml;r, zirai ve askeri ara\u0026ccedil;lar gibi ağır ticari ara\u0026ccedil; kategorisinde kullanım i\u0026ccedil;in tasarlanmıştır. Ağır ticari ara\u0026ccedil;ların operasyonlarını kesintisiz bir şekilde s\u0026uuml;rd\u0026uuml;rebilmeleri i\u0026ccedil;in gereken g\u0026uuml;c\u0026uuml; sağlayan Mutlu Ak\u0026uuml;ler; zorlu yol, arazi ve iklim koşullarında performansını d\u0026uuml;ş\u0026uuml;rmez. Ağır hizmet ve s\u0026uuml;per ağır hizmet tipi se\u0026ccedil;enekleriyle kullanıma sunulan uzun \u0026ouml;m\u0026uuml;rl\u0026uuml; Mutlu ağır ticari ara\u0026ccedil; ak\u0026uuml;leri; SFB ak\u0026uuml; teknolojisiyle kamyon, tır, otob\u0026uuml;s ve iş makinası kullanıcılarına uzman \u0026ccedil;\u0026ouml;z\u0026uuml;mler sağlar. Askeri ara\u0026ccedil;lar i\u0026ccedil;in ise SFB ve AGM teknolojili alternatifleri tercih edilebilir.\u0026nbsp;\u003c/p\u003e\n","subCategories":[{"name":"Askeri Araçlar","slug":"askeri-arac-akuleri","lang":"tr","shortDescription":"\u003cp\u003eSavunma sanayinin kullandığı askeri tank, panzer ve zırhlı tekerlekli ara\u0026ccedil;ların g\u0026ouml;revlerini eksiksiz ve sorunsuz yapabilmesi hayati \u0026ouml;nem taşır. Ara\u0026ccedil;ların kusursuz \u0026ccedil;alışmasında, tercih edilen ak\u0026uuml;n\u0026uuml;n rol\u0026uuml; b\u0026uuml;y\u0026uuml;kt\u0026uuml;r. Askeri ara\u0026ccedil; ak\u0026uuml;leri, marş basma g\u0026uuml;c\u0026uuml;n\u0026uuml;n yanı sıra haberleşme, navigasyon ve askeri operasyonlarda kullanılan bir\u0026ccedil;ok elektronik cihazın ihtiya\u0026ccedil; duyacağı enerjiyi sağlamakla g\u0026ouml;revlidir. Mutlu Ak\u0026uuml;; askeri ara\u0026ccedil;ların ihtiya\u0026ccedil; duyduğu y\u0026uuml;ksek dayanımı, uzun \u0026ouml;mr\u0026uuml; ve ara\u0026ccedil; i\u0026ccedil;i elektronik cihazların d\u0026uuml;zg\u0026uuml;n \u0026ccedil;alışması i\u0026ccedil;in gereken enerjiyi sağlar. Mutlu Ak\u0026uuml; \u0026uuml;r\u0026uuml;n gamından askeri ara\u0026ccedil;lar i\u0026ccedil;in uygun AGM ve SFB Ak\u0026uuml;leri tercih edilebilir.\u003cbr /\u003e\n\u003cbr /\u003e\nMutlu AGM Askeri Tip Ak\u0026uuml;ler, VRLA teknolojisine sahip olup NATO MIL-STD-810G standartlarına uygun \u0026uuml;r\u0026uuml;nlerdir. AGM seperat\u0026ouml;rler sayesinde g\u0026uuml;\u0026ccedil;lendirilmiş i\u0026ccedil; yapısı ve d\u0026ouml;k\u0026uuml;m teknolojili ızgaraları ile ekstra dayanım g\u0026ouml;sterir. Y\u0026uuml;ksek marş g\u0026uuml;c\u0026uuml; ve darbelere karşı mukavemeti sayesinde zorlu şartlarda kullanıma uygundur. Alev almayan ve yanmayı geciktirici plastik malzemeden \u0026uuml;retilen \u0026ouml;zel kutu tasarımı emniyeti sağlar.\u003cbr /\u003e\n\u003cbr /\u003e\nMutlu SFB Askeri Tip Ak\u0026uuml;ler, patentli kalsiyum (Ca) alaşımlı ızgara yapısı ve bakım gerektirmeyen \u0026uuml;r\u0026uuml;n teknolojisi ile \u0026uuml;st\u0026uuml;n sulu tip ak\u0026uuml;ler olarak beklentileri karşılar. Yanmayı geciktirici plastik malzemeden \u0026uuml;retilen \u0026ouml;zel kutu tasarımıyla y\u0026uuml;ksek g\u0026uuml;venlik sunar. Zorlu şartlarda standart ak\u0026uuml;lere g\u0026ouml;re daha \u0026uuml;st\u0026uuml;n performans sergileyen SFB Askeri Tip Ak\u0026uuml;ler, y\u0026uuml;ksek titreşim dayanımıyla da avantajlıdır.\u003c/p\u003e\n","imageUrls":[{"type":"list","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/73041.png"},{"type":"cover","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/25646.png"}]},{"name":"Traktör / Zirai Araçlar","slug":"traktor-zirai-arac-akuleri","lang":"tr","shortDescription":"\u003cp\u003eTarım faaliyetlerinin başarıyla ger\u0026ccedil;ekleştirilmesinde trakt\u0026ouml;r ve zirai ara\u0026ccedil;ların katkısı y\u0026uuml;ksektir. Bu ara\u0026ccedil;ların sorunsuz \u0026ccedil;alışmasında ise ak\u0026uuml;lerin rol\u0026uuml; b\u0026uuml;y\u0026uuml;kt\u0026uuml;r. Bir trakt\u0026ouml;r veya zirai ara\u0026ccedil; ak\u0026uuml;s\u0026uuml;; mevsim ve farklı hava koşullarında yeterli performans, arazi şartlarında titreşime karşı dayanım, y\u0026uuml;ksek \u0026ccedil;evrim \u0026ouml;mr\u0026uuml; ve devamlılık g\u0026ouml;steren marş basma kabiliyeti sunmalıdır. S\u0026ouml;z konusu ihtiya\u0026ccedil;lar doğrultusunda geliştirilen Mutlu Ak\u0026uuml;ler, tarım arazilerinin kesintisiz olarak işlenmesine yardımcı olur. Tarım ve zirai ara\u0026ccedil;larınız i\u0026ccedil;in Mutlu Ak\u0026uuml; \u0026uuml;r\u0026uuml;n ailesinden SFB Seri 1 Ağır Hizmet (HD) ve SFB Seri 2 Ağır Hizmet (HD) Ak\u0026uuml;lerini tercih edebilirsiniz.\u003cbr /\u003e\n\u003cbr /\u003e\nMutlu Ak\u0026uuml;\u0026#39;n\u0026uuml;n \u0026uuml;st\u0026uuml;n sulu tip ak\u0026uuml; teknolojisine sahip SFB Seri 1 HD ve SFB Seri 2 HD Ağır Hizmet Ak\u0026uuml;ler, tarım ve zirai ara\u0026ccedil; \u0026uuml;reticilerinin teknik ve \u0026uuml;st\u0026uuml;n performans beklentilerini karşılayan g\u0026uuml;venilir \u0026ccedil;\u0026ouml;z\u0026uuml;m ortaklarıdır. Mutlu SFB Seri 1 HD Ak\u0026uuml;ler; bakım gerektirmeyen \u0026uuml;r\u0026uuml;n teknolojileri, \u0026uuml;st\u0026uuml;n performansları ve korozyon diren\u0026ccedil;leriyle gereken enerjiyi kesintisiz sunar. Ak\u0026uuml; i\u0026ccedil;inde kullanılan \u0026ouml;zel plak sabitleme sistemi Hotmelt ile \u0026uuml;st d\u0026uuml;zey titreşim dayanımı sağlanır.\u003cbr /\u003e\n\u003cbr /\u003e\nMutlu Ak\u0026uuml;\u0026rsquo;n\u0026uuml;n bu alanda beklentileri karşılayan bir diğer ağır hizmet ak\u0026uuml;s\u0026uuml; SFB Seri 2 HD Ak\u0026uuml;ler ise, bakım gerektirmeyen uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml;ne sahip \u0026uuml;r\u0026uuml;nlerdir. Merkezi gaz \u0026ccedil;ıkış sistemi ve sızdırmaz kapak teknolojisiyle y\u0026uuml;ksek g\u0026uuml;venliklidir.\u003c/p\u003e\n","imageUrls":[{"type":"list","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/78429.png"},{"type":"cover","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/64244.png"}]},{"name":"İnşaat Ekipmanları","slug":"insaat-ekipman-akuleri","lang":"tr","shortDescription":"\u003cp\u003e\u0026Ccedil;eşitli \u0026ccedil;alışma alanlarında hizmet veren iş ve inşaat makineleri, hafriyat \u0026ccedil;ıkarmadan y\u0026uuml;klemeye, maden ocaklarından şantiye sahalarına kadar bir\u0026ccedil;ok farklı operasyonda kullanılır. Bu \u0026ccedil;alışmaların taahh\u0026uuml;t edilen zaman dilimi i\u0026ccedil;erisinde tamamlanması b\u0026uuml;y\u0026uuml;k \u0026ouml;nem taşır. Dolayısıyla iş ve inşaat makinelerinin sorunsuz ve kesintisiz \u0026ccedil;alışabilmesi i\u0026ccedil;in, d\u0026uuml;zenli olarak bakım ve onarımlarının yapılması kadar, kullanılan ak\u0026uuml;n\u0026uuml;n de yeterli dayanıma ve \u0026ouml;mre sahip olması gerekir. Mutlu Ak\u0026uuml;, bu kapsamda inşaat ekipmanları i\u0026ccedil;in uygun, zengin bir \u0026uuml;r\u0026uuml;n yelpazesi sunar. İnşaat ekipmanlarınız ve iş makineleriniz i\u0026ccedil;in Mutlu Ak\u0026uuml; \u0026uuml;r\u0026uuml;n gamından EFB Ticari, SFB Seri 1 S\u0026uuml;per Ağır Hizmet (SHD), SFB Seri 3 S\u0026uuml;per Ağır Hizmet (SHD), SFB Seri 1 Ağır Hizmet (HD) ve SFB Seri 2 Ağır Hizmet (HD) Ak\u0026uuml;leri tercih edebilirsiniz.\u003cbr /\u003e\n\u003cbr /\u003e\nMutlu Ak\u0026uuml;; iş makineleri ve her t\u0026uuml;rl\u0026uuml; inşaat ekipmanının enerji ihtiyacını karşılayacak geniş bir yelpazede ağır hizmet ve s\u0026uuml;per ağır hizmet ak\u0026uuml;leri \u0026uuml;retir. Mutlu Ak\u0026uuml;\u0026rsquo;n\u0026uuml;n \u0026uuml;st\u0026uuml;n sulu tip ak\u0026uuml; teknolojisini b\u0026uuml;nyesinde barındıran SFB \u0026uuml;r\u0026uuml;n ailesi; geliştirilmiş \u0026ouml;zel i\u0026ccedil; yapısı sayesinde uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml; ve y\u0026uuml;ksek performansa sahiptir. Bu ak\u0026uuml;lerden Mutlu SFB Seri 1 SHD Ak\u0026uuml;ler, bakım gerektirmeyen \u0026uuml;r\u0026uuml;n teknolojisiyle zorlu sahalarda işinizi kolaylaştırır. Mutlu SFB Seri 3 SHD Ak\u0026uuml;ler ise, dayanıklı \u0026uuml;r\u0026uuml;n teknolojisi ve y\u0026uuml;ksek titreşim direnciyle ara\u0026ccedil; kullanıcıları i\u0026ccedil;in ideal bir \u0026ccedil;\u0026ouml;z\u0026uuml;md\u0026uuml;r.\u003cbr /\u003e\n\u003cbr /\u003e\nMutlu SFB Seri 1 HD Ak\u0026uuml;ler, \u0026ccedil;alışma alanlarında ekipmanların ihtiya\u0026ccedil; duyduğu enerjiyi sorunsuz bi\u0026ccedil;imde sağlar. Ağır hizmet i\u0026ccedil;in geliştirilmiş patentli kalsiyum (Ca) alaşımlı ızgara teknolojisi ve bakım gerektirmeyen \u0026uuml;r\u0026uuml;n teknolojisine sahiptir. SFB Seri 2 HD Ak\u0026uuml;ler ise; zorlu arazi şartlarında y\u0026uuml;ksek titreşim dayanımı, merkezi gaz \u0026ccedil;ıkış sistemi, alev tutucu \u0026ouml;zelliği ve sızdırmaz kapak teknolojileriyle performans ile g\u0026uuml;venliği bir arada sunar.\u003c/p\u003e\n","imageUrls":[{"type":"list","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/93823.png"},{"type":"cover","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/61648.png"}]},{"name":"Kamyon / Tır","slug":"kamyon-tir-akuleri","lang":"tr","shortDescription":"\u003cp\u003eAğır vasıta grubunda yer alan kamyonlar ve tırlar, diğer ara\u0026ccedil; tiplerine g\u0026ouml;re hem marş g\u0026uuml;c\u0026uuml; gereksinimleri hem de elektriksel donanımları nedeniyle daha fazla enerjiye ihtiya\u0026ccedil; duyar. Şehirler arası ve uluslararası y\u0026uuml;k taşımacılığında kullanılan \u0026ccedil;ekiciler, inşaat kamyonları, kamu hizmetlerinde kullanılan yol s\u0026uuml;p\u0026uuml;rme, \u0026ccedil;\u0026ouml;p kamyonu ve itfaiye aracı gibi farklı yapıdaki ağır vasıtalarda, doğru ak\u0026uuml; se\u0026ccedil;imi b\u0026uuml;y\u0026uuml;k \u0026ouml;nem taşır. Mutlu Ak\u0026uuml;; kamyon ak\u0026uuml;s\u0026uuml; veya TIR ak\u0026uuml;s\u0026uuml;nde olması gereken uzun \u0026ouml;m\u0026uuml;r, sarsıntılara karşı dayanım g\u0026uuml;c\u0026uuml; ve uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml; gibi \u0026ouml;zelliklere sahip farklı kapasite değerlerinde \u0026uuml;r\u0026uuml;n alternatifleri sunar.\u0026nbsp;Kamyon ve tırlarınız i\u0026ccedil;in Mutlu Ak\u0026uuml; \u0026uuml;r\u0026uuml;n gamından EFB Ticari, AGM Ticari, SFB Seri 1 S\u0026uuml;per Ağır Hizmet (SHD), SFB Seri 3 S\u0026uuml;per Ağır Hizmet (SHD), SFB Seri 1 Ağır Hizmet (HD) ve SFB Seri 2 Ağır Hizmet (HD)\u0026nbsp;Ak\u0026uuml;leri tercih edebilirsiniz.\u003cbr /\u003e\n\u003cbr /\u003e\n\u003cbr /\u003e\nMutlu Ak\u0026uuml;, ağır vasıta ara\u0026ccedil; grubuna y\u0026ouml;nelik SFB teknolojili geniş \u0026uuml;r\u0026uuml;n yelpazesiyle, dayanıklı ve uzun \u0026ouml;m\u0026uuml;rl\u0026uuml; ak\u0026uuml;ler sunar. Mutlu SFB Ak\u0026uuml;ler, kamyon ve tırların elektriksel ihtiya\u0026ccedil;larını karşılamak \u0026uuml;zere Ağır Hizmet ve S\u0026uuml;per Ağır Hizmet \u0026uuml;r\u0026uuml;n gruplarıyla Seri 1, Seri 2 ve Seri 3 olarak sınıflandırılır.\u003cbr /\u003e\n\u003cbr /\u003e\nMutlu SFB Seri 1 SHD Ak\u0026uuml;ler, s\u0026uuml;per ağır hizmet kategorisinde olup y\u0026uuml;ksek titreşim dayanımı sayesinde zorlu \u0026ccedil;alışma şartlarında kullanılır. D\u0026ouml;k\u0026uuml;lmeyi geciktirici cam elyaflı PE seperat\u0026ouml;r ile uzun \u0026ouml;m\u0026uuml;rl\u0026uuml;d\u0026uuml;rler. SFB Seri 1 SHD Ak\u0026uuml;ler uygun kullanım koşullarında ekstra bakım hizmetlerine ihtiya\u0026ccedil; duymaz. Mutlu Ak\u0026uuml;\u0026#39;n\u0026uuml;n kamyon ve tırlar i\u0026ccedil;in uygun olan s\u0026uuml;per ağır hizmet kategorisindeki diğer bir ak\u0026uuml; grubu SFB Seri 3 SHD ise tasarımındaki merkezi gaz \u0026ccedil;ıkış sistemi, alev tutucu filtresi ve sızdırmaz kapak teknolojisi sayesinde g\u0026uuml;venliği \u0026uuml;st d\u0026uuml;zeyde sunar.\u003cbr /\u003e\n\u003cbr /\u003e\nMutlu Ak\u0026uuml;\u0026rsquo;n\u0026uuml;n SFB Seri 1 HD Ak\u0026uuml;leri, bakım gerektirmeyen \u0026uuml;r\u0026uuml;n teknolojisi, g\u0026uuml;\u0026ccedil;l\u0026uuml; i\u0026ccedil; yapısı ve y\u0026uuml;ksek titreşim dayanımıyla ağır hizmet kategorisinde fark yaratır. Aynı zamanda ağır hizmet ak\u0026uuml;ler i\u0026ccedil;in geliştirilmiş patentli kalsiyum (Ca) alaşımlı ızgara teknolojisiyle daha uzun kullanım \u0026ouml;mr\u0026uuml;ne sahiptir. Mutlu SFB Seri 2 HD Ak\u0026uuml;ler ise, zorlu arazi ve yol koşullarında sunduğu y\u0026uuml;ksek performans ve bakım gerektirmeyen \u0026uuml;r\u0026uuml;n teknolojisiyle ihtiya\u0026ccedil; ve beklentileri karşılar.\u003c/p\u003e\n\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eMutlu EFB Ticari Ak\u0026uuml;ler, y\u0026uuml;ksek titreşim dayanımı sayesinde zorlu \u0026ccedil;alışma şartlarında kullanıma uygun, bakım gerektirmeyen, uzun \u0026ouml;m\u0026uuml;rl\u0026uuml; ak\u0026uuml;lerdir. EFB Ticari Ak\u0026uuml;ler, daha uzun s\u0026uuml;reli kullanım ve y\u0026uuml;ksek performans i\u0026ccedil;in standart \u0026ouml;zellikli ticari ara\u0026ccedil;larda da tercih edilebilmektedir. Arka şasi kullanımına ugun ve gece konaklama konfor fonksiyonlarını destekler.\u003c/p\u003e\n\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eMutlu AGM Ticari Ak\u0026uuml;ler,\u0026nbsp;t\u0026uuml;m ara\u0026ccedil; tiplerine uygun ak\u0026uuml;ler yer almaktadır. Arka şasi kullanımına uygundur ve gece konaklama konfor fonksiyonlarını destekler.\u003c/p\u003e\n","imageUrls":[{"type":"cover","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/96502.png"},{"type":"list","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/22107.png"}]},{"name":"Otobüs","slug":"otobus-akuleri","lang":"tr","shortDescription":"\u003cp\u003eKent i\u0026ccedil;i toplu taşımanın en yaygın taşıtı olan tarifeli otob\u0026uuml;sler, g\u0026uuml;n i\u0026ccedil;erisinde yoğun \u0026ccedil;alışma s\u0026uuml;releriyle y\u0026uuml;ksek enerjiye ihtiya\u0026ccedil; duyarlar. Tarifeli otob\u0026uuml;sler, uğrayacağı duraklara zamanında ulaşabilmek i\u0026ccedil;in yolculukları esnasında herhangi bir sıkıntı yaşamamalıdır. Şehirler arası seyahatlerde kullanılan otob\u0026uuml;sler i\u0026ccedil;in de yolculuklarını kesintisiz ve sorunsuz devam ettirebilmek \u0026ccedil;ok \u0026ouml;nemlidir. Aynı zamanda her yolcu koltuğu sırasında bulunan aydınlatma lambaları ve koltuklarda yer alan LCD ekranlardan dolayı şehirler arası otob\u0026uuml;sler de y\u0026uuml;ksek enerji ihtiyacına sahiptir. Dolayısıyla bu otob\u0026uuml;sler i\u0026ccedil;in ak\u0026uuml;n\u0026uuml;n sorunsuz \u0026ccedil;alışması gereklidir. Mutlu Ak\u0026uuml; sunduğu geniş \u0026uuml;r\u0026uuml;n gamıyla; dayanıklı, y\u0026uuml;ksek titreşim direncine sahip, uzun \u0026ouml;m\u0026uuml;rl\u0026uuml; ve farklı kapasitelerde ak\u0026uuml; se\u0026ccedil;eneklerine sahiptir.\u0026nbsp;Otob\u0026uuml;sleriniz i\u0026ccedil;in Mutlu Ak\u0026uuml; \u0026uuml;r\u0026uuml;n yelpazesinden EFB Ticari, AGM Ticari, SFB Seri 1 S\u0026uuml;per Ağır Hizmet (SHD) ve SFB Seri 3 S\u0026uuml;per Ağır Hizmet (SHD) Ak\u0026uuml;leri tercih edebilirsiniz.\u003cbr /\u003e\n\u003cbr /\u003e\nMutlu SFB Seri 1 SHD Ak\u0026uuml;ler, kent i\u0026ccedil;i ve şehirler arası yolculuklarda otob\u0026uuml;slerin enerji ihtiya\u0026ccedil;larını karşılar. SLI teknolojisi ile \u0026uuml;retilmiş olan SFB Seri 1 SHD Ak\u0026uuml;ler, kalsiyum (Ca) alaşımlı yapısıyla bakım gerektirmeyen \u0026ouml;zelliktedir. Y\u0026uuml;ksek titreşim dayanımı sayesinde zorlu yol koşullarında kullanıma uygundur.\u003cbr /\u003e\n\u003cbr /\u003e\nOtob\u0026uuml;sler i\u0026ccedil;in \u0026uuml;st\u0026uuml;n SFB teknolojisinin sunulduğu diğer bir ak\u0026uuml; olan Mutlu SFB Seri 3 SHD Ak\u0026uuml;ler, bakım gerektirmeyen yapıları ve y\u0026uuml;ksek titreşim direnciyle yoğun mesai harcayan otob\u0026uuml;slerin ihtiya\u0026ccedil; duyduğu kesintisiz enerjiyi sağlar. Mutlu SFB Seri 3 SHD Ak\u0026uuml;ler, uzun \u0026ouml;m\u0026uuml;rl\u0026uuml; kullanımıyla bir otob\u0026uuml;s ak\u0026uuml;s\u0026uuml;nden beklenen performansı g\u0026ouml;sterir.\u003c/p\u003e\n\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eMutlu EFB Ticari Ak\u0026uuml;ler, y\u0026uuml;ksek titreşim dayanımı sayesinde zorlu \u0026ccedil;alışma şartlarında kullanıma uygun, bakım gerektirmeyen, uzun \u0026ouml;m\u0026uuml;rl\u0026uuml; ak\u0026uuml;lerdir. EFB Ticari Ak\u0026uuml;ler, daha uzun s\u0026uuml;reli kullanım ve y\u0026uuml;ksek performans i\u0026ccedil;in standart \u0026ouml;zellikli ticari ara\u0026ccedil;larda da tercih edilebilmektedir. Arka şasi kullanımına ugun ve gece konaklama konfor fonksiyonlarını destekler.\u003c/p\u003e\n\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eMutlu AGM Ticari Ak\u0026uuml;ler,\u0026nbsp;t\u0026uuml;m ara\u0026ccedil; tiplerine uygun ak\u0026uuml;ler yer almaktadır. Arka şasi kullanımına uygundur ve gece konaklama konfor fonksiyonlarını destekler.\u003c/p\u003e\n","imageUrls":[{"type":"list","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/13916.png"},{"type":"cover","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/94093.png"}]}]},{"id":50,"name":"Alternatif Enerji İhtiyaçları","slug":"alternatif-enerji-sistemleri","categoryOrder":3,"isActive":1,"slogan":"Alternatif Enerji İhtiyaçları","lang":"tr","shortDescription":"\u003cp\u003eAlternatif enerji ihtiya\u0026ccedil;larına uygun Mutlu Ak\u0026uuml;ler; ticari ve end\u0026uuml;striyel uygulamalardan evlere kadar bir\u0026ccedil;ok alanda kullanımı giderek artan enerji sistemleri i\u0026ccedil;in tasarlanmıştır. Bu tip sistemlerde ak\u0026uuml;lerden beklenen uzun \u0026ouml;m\u0026uuml;r, bakım gerektirmeme ve zorlu iklim koşullarında y\u0026uuml;ksek performans \u0026ouml;zelliklerini karşılayan Mutlu Ak\u0026uuml;ler; JEL, AGM, EFB, Full Enerji ve SFB teknolojili se\u0026ccedil;enekleriyle kullanıma sunulur. Kurulumunun ardından uzun s\u0026uuml;re m\u0026uuml;dahale edilmeyen solar sistemlerde, soğuk zincir gıda taşımacılığında kullanılan soğutucu sistemlerde, jenarat\u0026ouml;rlerde, temizlik ekipmanlarında \u0026nbsp;ve \u0026ccedil;alışırken kesinti kabul etmeyen UPS sistemlerinde bu tip ak\u0026uuml;ler tercih edilir.\u0026nbsp;\u003c/p\u003e\n","subCategories":[{"name":"Temizlik Ekipmanları","slug":"temizlik-ekipmanlari","lang":"tr","shortDescription":"\u003cp\u003eBelediyeler, end\u0026uuml;striyel tesisler, fabrikalar ve \u0026ccedil;eşitli ticari kuruluşlarda kullanılan temizlik ekipmanları birbirinden farklı \u0026ccedil;eşitlerde olabilir. \u0026Ccedil;alışma şekillerine ve kullanım alanlarına g\u0026ouml;re değişik \u0026ouml;zellikler g\u0026ouml;steren bu cihazlar i\u0026ccedil;in uygun temizlik ekipmanı ak\u0026uuml;s\u0026uuml; se\u0026ccedil;ilmelidir. Mutlu Ak\u0026uuml;, yapısına ve \u0026ccedil;alışma koşullarına g\u0026ouml;re farklı t\u0026uuml;rlerde temizlik ekipmanları i\u0026ccedil;in uygun ak\u0026uuml; se\u0026ccedil;eneklerini sunar. Temizlik ekipmanlarınız i\u0026ccedil;in Mutlu Ak\u0026uuml; \u0026uuml;r\u0026uuml;n gamında yer alan AGM ve Full Enerji Ak\u0026uuml;leri tercih edebilirsiniz.\u003cbr /\u003e\n\u003cbr /\u003e\nMutlu AGM Ak\u0026uuml;ler; \u0026ouml;zel i\u0026ccedil; yapıları ve bakım gerektirmeyen VRLA teknolojileriyle, temizlik ekipmanlarında y\u0026uuml;ksek performans sunar. Tam kapalı ve basın\u0026ccedil; kontrol valfli kapak sistemine sahip Mutlu AGM Ak\u0026uuml;ler, uzun \u0026ouml;m\u0026uuml;rl\u0026uuml; \u0026uuml;r\u0026uuml;n teknolojisi sayesinde temizlik ekipmanı ak\u0026uuml;s\u0026uuml; olarak avantaj sağlar.\u003cbr /\u003e\n\u003cbr /\u003e\nMutlu Full Enerji Ak\u0026uuml;ler, derin deşarja uygunlukları ve bakım gerektirmeyen yapılarıyla temizlik ekipmanlarında kullanım kolaylığı sağlar. Mutlu Full Enerji Ak\u0026uuml;ler, uzun s\u0026uuml;reli \u0026ccedil;alışma şartlarında standart ak\u0026uuml;lere oranla daha \u0026uuml;st\u0026uuml;n bir performans sergiler.\u003c/p\u003e\n","imageUrls":[{"type":"list","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/68899.png"},{"type":"cover","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/69931.png"}]},{"name":"UPS","slug":"ups-akuleri","lang":"tr","shortDescription":"\u003cp\u003eElektrik kesintilerinde devreye girip enerji sağlayan bir g\u0026uuml;\u0026ccedil; kaynağı olan UPS sistemleri (kesintisiz g\u0026uuml;\u0026ccedil; kaynağı) hastane, fabrika ve enerji depolama sistemleri gibi farklı alanlarda kullanılır. UPS\u0026rsquo;ler, DC gerilim kaynağı olan ak\u0026uuml;lerde depolanan enerjiyi AC gerilime d\u0026ouml;n\u0026uuml;şt\u0026uuml;r\u0026uuml;r ve sisteme istenilen enerjiyi sağlar. Dolayısıyla UPS ak\u0026uuml;s\u0026uuml;, elektrik kesintisi olduğu anda UPS\u0026rsquo;lere anında elektriği iletir. UPS sistemleri i\u0026ccedil;in gereken uzun \u0026ouml;m\u0026uuml;rl\u0026uuml; ak\u0026uuml; se\u0026ccedil;eneklerine sahip olan Mutlu Ak\u0026uuml;, AGM ve JEL Ak\u0026uuml;leri ile avantajlıdır.\u003cbr /\u003e\n\u003cbr /\u003e\nUPS\u0026#39;lerde tercih edilmesi gereken ak\u0026uuml;ler, ani olarak y\u0026uuml;ksek akım \u0026ccedil;ekilmelerine ve uzun s\u0026uuml;re şarj altında kalmaya uygun yapıda olmalıdır. Bakım gerektirmeyen ve y\u0026uuml;ksek performanslı Mutlu AGM Ak\u0026uuml;ler, UPS\u0026#39;ler i\u0026ccedil;in ideal bir \u0026ccedil;\u0026ouml;z\u0026uuml;md\u0026uuml;r. Dayanıklı \u0026uuml;r\u0026uuml;n teknolojisi ve uzun kullanım \u0026ouml;mr\u0026uuml; Mutlu AGM Ak\u0026uuml;lerin UPS\u0026#39;lerde tercih edilmesinin diğer bir nedenidir.\u003cbr /\u003e\n\u003cbr /\u003e\nMutlu Ak\u0026uuml;\u0026rsquo;n\u0026uuml;n bakım gerektirmeyen \u0026uuml;r\u0026uuml;n teknolojisine sahip JEL ak\u0026uuml; grubu da UPS\u0026#39;lerde kullanıma uygundur. Uzun kullanım \u0026ouml;mr\u0026uuml;yle JEL Ak\u0026uuml;ler, UPS sistemlerinde tercih edilir.\u003c/p\u003e\n","imageUrls":[{"type":"cover","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/12246.png"},{"type":"list","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/47314.png"}]},{"name":"Solar Sistemler","slug":"solar-sistemler","lang":"tr","shortDescription":"\u003cp\u003eG\u0026uuml;neş enerjisinden elektrik enerjisi elde etmekle g\u0026ouml;revli solar sistemlerde, enerjinin devamlılığını sağlayabilmek i\u0026ccedil;in uygun bir depolama \u0026uuml;r\u0026uuml;n\u0026uuml; kullanmak gerekir. Solar sistemlerin verimli \u0026ccedil;alışabilmesi adına depolama ama\u0026ccedil;lı kullanılacak ak\u0026uuml; de, bakım gerektirmeyen yapı ve uzun kullanım \u0026ouml;mr\u0026uuml;ne sahip olmalıdır. Solar sistemleriniz i\u0026ccedil;in, Mutlu Ak\u0026uuml; \u0026uuml;r\u0026uuml;n gamından JEL ve Full Enerji Ak\u0026uuml;leri tercih edebilirsiniz.\u003cbr /\u003e\n\u003cbr /\u003e\nMutlu Ak\u0026uuml;, g\u0026uuml;neş enerji depolama \u0026ccedil;\u0026ouml;z\u0026uuml;mlerine y\u0026ouml;nelik sunduğu \u0026uuml;r\u0026uuml;nlerle solar sistem ak\u0026uuml;lerinden beklenen gereksinimleri karşılar. Mutlu JEL Ak\u0026uuml;ler, VRLA teknolojisine sahip ak\u0026uuml;ler olup i\u0026ccedil;eriklerinde jel formunda elektrolitler barındırır. Bu y\u0026ouml;nleriyle ve \u0026ouml;zel basın\u0026ccedil; kontrol valfli kapak sistemleriyle de bakım gerektirmeyen niteliktedirler. JEL Ak\u0026uuml;ler, aynı zamanda standart ak\u0026uuml;lere g\u0026ouml;re daha y\u0026uuml;ksek \u0026ccedil;evrim \u0026ouml;mr\u0026uuml;yle de uzun s\u0026uuml;reli kullanılabilirler.\u003cbr /\u003e\n\u003cbr /\u003e\nMutlu Full Enerji Ak\u0026uuml;ler; bakım gerektirmeyen yapıları ve y\u0026uuml;ksek enerji gereksinimi olan solar uygulamalarda %50\u0026rsquo;ye kadar derin deşarj \u0026ouml;zelliğiyle g\u0026uuml;neş enerjisi \u0026ccedil;\u0026ouml;z\u0026uuml;mleri i\u0026ccedil;in kullanılabilirler. Solar sistemlerde verimli kullanım i\u0026ccedil;in, uygun şarj voltajı uygulanmalıdır.\u003c/p\u003e\n","imageUrls":[{"type":"list","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/76936.png"},{"type":"cover","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/38105.png"}]},{"name":"Soğutucu Sistemler","slug":"sogutucu-sistemler","lang":"tr","shortDescription":"\u003cp\u003eSoğutucu sistemler şehir i\u0026ccedil;i veya şehirler arası soğuk zincir gıda, ila\u0026ccedil; gibi bir\u0026ccedil;ok malzemenin taşımacılığında yaygın bir kullanım alanına sahiptir. Bu tip soğutucu sistemlere sahip ara\u0026ccedil;larda, taşınan malzemenin uygun sıcaklık aralığında muhafaza edilmesi b\u0026uuml;y\u0026uuml;k \u0026ouml;nem taşır. Sistemin verimli ve sorunsuz \u0026ccedil;alışabilmesi i\u0026ccedil;in gerekli elektrik enerjisinin temini sağlayacak, uygun bir soğutucu sistem ak\u0026uuml;s\u0026uuml; se\u0026ccedil;ilmelidir. Soğutucu sistemleriniz i\u0026ccedil;in Mutlu Ak\u0026uuml; \u0026uuml;r\u0026uuml;n gamından AGM ve EFB Ak\u0026uuml;leri tercih edebilirsiniz.\u003cbr /\u003e\n\u003cbr /\u003e\nMutlu Ak\u0026uuml;; soğutucu sistemlere y\u0026ouml;nelik olarak Mutlu AGM Ak\u0026uuml; teknolojisiyle uzun kullanım \u0026ouml;mr\u0026uuml; ve y\u0026uuml;ksek dayanım sunar. Soğutucuların en iyi şekilde \u0026ccedil;alışabilmesi i\u0026ccedil;in, y\u0026uuml;ksek performans ve verime sahiptir. Mutlu AGM Ak\u0026uuml;ler; \u0026ouml;zel i\u0026ccedil; yapıları, bakım gerektirmeyen VRLA teknolojileri ve y\u0026uuml;ksek titreşim dayanımlarıyla soğutucu sistemlerde kullanıma uygundur.\u003cbr /\u003e\n\u003cbr /\u003e\nDiğer bir \u0026ccedil;\u0026ouml;z\u0026uuml;m olan Mutlu EFB Ak\u0026uuml;ler ise geliştirilmiş sulu tip ak\u0026uuml; teknolojisine sahiptir. Zorlu iklim ve yol şartlarında; tam kapalı kapak sistemine sahip bakım gerektirmeyen yapısı, y\u0026uuml;ksek titreşim dayanımı ve uzun \u0026ouml;m\u0026uuml;rl\u0026uuml; \u0026uuml;r\u0026uuml;n teknolojisiyle soğutucu sistemlerde tercih sebebidir.\u003c/p\u003e\n","imageUrls":[{"type":"list","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/75934.png"},{"type":"cover","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/53464.png"}]},{"name":"Jeneratör","slug":"jenerator-akuleri","lang":"tr","shortDescription":"\u003cp\u003eMekanik enerjiyi elektrik enerjisine d\u0026ouml;n\u0026uuml;şt\u0026uuml;ren cihazlar olan jenerat\u0026ouml;rler, ticari ve end\u0026uuml;striyel uygulamalardan evlere kadar bir\u0026ccedil;ok alanda kullanılır. Kendi i\u0026ccedil;lerinde dizel, benzinli, biyo dizel, emulsifiye dizel, doğal gazlı, hidrojen ve propan gaz ilaveli olarak farklı \u0026ccedil;eşitlerde \u0026uuml;retilen jenerat\u0026ouml;rlerde; motorların sorunsuz işleyişi i\u0026ccedil;in en uygun jenerat\u0026ouml;r ak\u0026uuml;s\u0026uuml; tercih edilmelidir. Jenerat\u0026ouml;rleriniz i\u0026ccedil;in Mutlu Ak\u0026uuml; \u0026uuml;r\u0026uuml;n gamından; SFB Avrupa Tip, SFB Japon Tip, SFB Seri 1 Ağır Hizmet (HD) ve SFB Seri 2 Ağır Hizmet (HD) Ak\u0026uuml;leri tercih edebilirsiniz.\u003cbr /\u003e\n\u003cbr /\u003e\nMutlu Ak\u0026uuml; jenerat\u0026ouml;r kullanımları i\u0026ccedil;in geniş bir \u0026uuml;r\u0026uuml;n yelpazesi sunar. Bakım gerektirmeyen sulu tip ak\u0026uuml; teknolojisine sahip Mutlu SFB \u0026uuml;r\u0026uuml;n ailesinin \u0026uuml;yeleri, jenerat\u0026ouml;rlerin ak\u0026uuml; ihtiyacını karşılar. Jenerat\u0026ouml;rler i\u0026ccedil;in; standart ak\u0026uuml;lere g\u0026ouml;re y\u0026uuml;zde 25\u0026rsquo;e kadar daha y\u0026uuml;ksek performans sağlayan, tam kapalı kapak sistemine sahip SFB Avrupa Tip ve SFB Japon Tip Ak\u0026uuml;ler tercih edilebilir.\u003cbr /\u003e\n\u003cbr /\u003e\nMutlu Ak\u0026uuml;, SFB \u0026uuml;r\u0026uuml;n teknolojisine sahip ağır hizmet ak\u0026uuml;leri de jenerat\u0026ouml;rlerle kullanıma uygundur. Mutlu SFB Seri 1 Ağır Hizmet ve SFB Seri 2 Ağır Hizmet Ak\u0026uuml;ler, bakım gerektirmeyen dayanıklı \u0026uuml;r\u0026uuml;n yapısına sahiptir.\u003c/p\u003e\n","imageUrls":[{"type":"list","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/52208.png"},{"type":"cover","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/95529.png"}]}]},{"id":51,"name":"Hobi Araçları","slug":"hobi","categoryOrder":4,"isActive":1,"slogan":"Hobi Araçları","lang":"tr","shortDescription":"\u003cp\u003eHobi ama\u0026ccedil;lı kullanımlara uygun Mutlu Ak\u0026uuml;ler, g\u0026uuml;nl\u0026uuml;k hayat i\u0026ccedil;inde elektriksel enerjiye ihtiya\u0026ccedil; duyan bir\u0026ccedil;ok hobi uygulamasında tercih edilebilen enerji ak\u0026uuml;leridir. Bu ak\u0026uuml;ler, b\u0026uuml;nyesinde \u0026ccedil;ok sayıda elektrikli cihazı barındıran karavanlardan marin sekt\u0026ouml;r\u0026uuml;ne kadar geniş bir kullanım alanına hizmet ederler.\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eMarin uygulamalarında kullanılan Mutlu Ak\u0026uuml;ler; SFB Marin ve JEL teknolojili se\u0026ccedil;enekleriyle, y\u0026uuml;ksek performansı ve dayanıklılığıyla deniz yolu ulaşım ara\u0026ccedil;larının enerji gereksinimlerini karşılar. S\u0026uuml;rekli elektrik enerjisine ihtiya\u0026ccedil; duyan karavan ve motokaravanlarda ise yaşam kalitesini iyileştirmeye destek olan y\u0026uuml;ksek performanslı ak\u0026uuml; alternatifleri olarak tercih edilebilirler. AGM, JEL ve Full Enerji teknolojileriyle sunulan, maksimum performanslı ak\u0026uuml;ler karavanlardaki enerji gereksinimleri i\u0026ccedil;in ideal \u0026ccedil;\u0026ouml;z\u0026uuml;mlerdir.\u0026nbsp;\u003c/p\u003e\n","subCategories":[{"name":"Marin","slug":"marin-akuler","lang":"tr","shortDescription":"\u003cp\u003e\u003cbr /\u003e\nTekne, yat gibi deniz yolu ulaşım ara\u0026ccedil;ları hem hobi hem de ticari faaliyetlerde tercih edilir. Deniz yolu ulaşım ara\u0026ccedil;ları; farklı iklim ve hava koşullarında kuvvetli r\u0026uuml;zgar, nem, şiddetli yağmur gibi etkenlere maruz kalabilir. Ayrıca dalgalar nedeniyle de bu t\u0026uuml;r deniz ara\u0026ccedil;larında sarsıntılar yaşanabilir. Kıyıdan uzakta olan bir marin aracının sorunsuzca seyrine devam etmesi hem insan hayatı hem de zamanlama a\u0026ccedil;ısından \u0026ouml;nemlidir. Doğa koşulları veya marin aracı i\u0026ccedil;erisindeki elektriksel donanımların kullanımından \u0026ouml;t\u0026uuml;r\u0026uuml; ak\u0026uuml;de herhangi bir problem yaşanmaması gerekir. İ\u0026ccedil; donanımlardan \u0026ouml;zellikle; aydınlatma sistemi, d\u0026uuml;menle ilişkili elektronik sistemler, navigasyon ve GPS gibi y\u0026ouml;n/kontrol sistemleri ve g\u0026uuml;nl\u0026uuml;k ihtiyacı karşılayan mutfak temizlik ekipmanları gibi bir\u0026ccedil;ok uygulama i\u0026ccedil;in bu elektrik ihtiyacı ka\u0026ccedil;ınılmazdır. Tekne ve yat gibi deniz yolu ulaşımı / marin ara\u0026ccedil;larında, hem motorun doğru \u0026ccedil;alışması hem de elektriksel donanımların sağlıklı bir şekilde kullanımı i\u0026ccedil;in ak\u0026uuml; se\u0026ccedil;imi son derece \u0026ouml;nemlidir. Marin ak\u0026uuml;s\u0026uuml; veya tekne ak\u0026uuml;s\u0026uuml; olarak bilinen bu ak\u0026uuml;lerin; sıvı sızdırmamaları, r\u0026uuml;zgarlı koşullara uygun ve sallantılara karşı diren\u0026ccedil;li bir yapıda olmaları gerekir. Mutlu Ak\u0026uuml;\u0026#39;n\u0026uuml;n deniz yolu ulaşım ara\u0026ccedil;larının ihtiya\u0026ccedil;ları doğrultusunda geliştirdiği JEL ve SFB Marin ak\u0026uuml;leri tekne ve yatlarınız i\u0026ccedil;in tercih edebilirsiniz.\u003cbr /\u003e\n\u003cbr /\u003e\nMutlu Ak\u0026uuml;\u0026rsquo;n\u0026uuml;n marin grubuna y\u0026ouml;nelik sunduğu \u0026uuml;r\u0026uuml;nler arasında yer alan JEL Ak\u0026uuml;ler; kurşun-asit ak\u0026uuml;ler i\u0026ccedil;erisinde en y\u0026uuml;ksek \u0026ccedil;evrim \u0026ouml;mr\u0026uuml;ne sahiptir. Ak\u0026uuml; i\u0026ccedil;erisinde bulunan elektrolit sıvı, yerini jel formuna bırakır. Bu sayede sızdırmaz bir yapıdadır. JEL Ak\u0026uuml;\u0026#39;deki VRLA teknolojisi sayesinde, kullanım esnasında dışarı gaz \u0026ccedil;ıkışı olmaz. Bu y\u0026ouml;n\u0026uuml;yle kapalı alanlarda kullanıma uygundur. Mutlu JEL Ak\u0026uuml; teknolojisi, y\u0026uuml;ksek titreşim dayanımıyla, denizde karşılaşılabilecek koşullara uygundur.\u003cbr /\u003e\n\u003cbr /\u003e\nMutlu SFB Marin Ak\u0026uuml;ler; deniz taşımacılığında kullanılan ara\u0026ccedil;ların enerji ihtiya\u0026ccedil;larını karşılamak \u0026uuml;zere SFB teknolojisi ile \u0026uuml;retilmiş, bakım gerektirmeyen ak\u0026uuml;lerdir. \u0026Ouml;zel geliştirilmiş ızgara alaşımı, aktif madde ve \u0026ouml;zel elyaﬂı seperat\u0026ouml;rleri sayesinde standart ak\u0026uuml;lere g\u0026ouml;re daha y\u0026uuml;ksek \u0026ccedil;evrim \u0026ouml;mr\u0026uuml; sunar. Merkezi gaz \u0026ccedil;ıkış sistemi ve alev tutucu \u0026ouml;zelliğe sahip sızdırmaz kapak teknolojisiyle y\u0026uuml;ksek g\u0026uuml;venlik sağlar. Yanmayı geciktirici plastik malzemeden \u0026uuml;retilen Mutlu Ak\u0026uuml;ler, T\u0026uuml;rk Loydu sertifikasına sahiptir.\u003c/p\u003e\n","imageUrls":[{"type":"list","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/99236.png"},{"type":"cover","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/14152.png"}]},{"name":"Karavan","slug":"karavan-akuleri","lang":"tr","shortDescription":"\u003cp\u003eGezginlerin ve kamp tutkunlarının vazge\u0026ccedil;ilmezi olan karavan ve motokaravanlar, apayrı bir yaşam stilini beraberinde getirir. Karavanlar i\u0026ccedil;erisinde buzdolabından televizyona, ekstra aydınlatmadan iklimlendirmeye kadar bir\u0026ccedil;ok elektronik donanım ve cihaz yer alır. Kendine ait bir elektrik tesisat d\u0026uuml;zeneği bulunan karavanlar i\u0026ccedil;erisindeki bu donanım ve cihazlar; ihtiya\u0026ccedil;ları karşılayan ve konfor artıran niteliktedir. Mutlu Ak\u0026uuml;, karavan ve motokaravanlardaki cihazların sağlıklı bir şekilde kullanımı i\u0026ccedil;in uygun \u0026ccedil;\u0026ouml;z\u0026uuml;mler sunar. Karavanlarınız i\u0026ccedil;in Mutlu Ak\u0026uuml; \u0026uuml;r\u0026uuml;n gamında yer alan AGM, JEL ve Full Enerji Ak\u0026uuml;leri tercih edebilirsiniz.\u003cbr /\u003e\n\u003cbr /\u003e\nMutlu JEL Ak\u0026uuml;ler, VRLA teknolojisi sayesinde kullanım esnasında dışarı gaz \u0026ccedil;ıkışına izin vermedikleri i\u0026ccedil;in yaşam alanlarında kullanıma uygundur. Derin deşarj \u0026ouml;zelliği sayesinde karavanlarda kullanım i\u0026ccedil;in ideal ve uzun \u0026ouml;m\u0026uuml;rl\u0026uuml; ak\u0026uuml;lerdir. Y\u0026uuml;ksek titreşim dayanımı ve bakım gerektirmeyen teknolojisiyle perfomansı ve dayanımı bir arada sunar.\u003cbr /\u003e\n\u003cbr /\u003e\nMutlu Ak\u0026uuml;\u0026rsquo;n\u0026uuml;n karavan ve motokaravanlarda kullanıma uygun \u0026uuml;r\u0026uuml;nleri arasında yer alan Mutlu AGM Ak\u0026uuml;ler, \u0026ouml;zel i\u0026ccedil; yapısı ve VRLA teknolojisiyle tam kapalı, bakım gerektirmeyen ak\u0026uuml;lerdir. Yaşam alanlarında kullanıma uygun ve uzun \u0026ouml;m\u0026uuml;rl\u0026uuml; \u0026uuml;r\u0026uuml;nlerdir.\u003cbr /\u003e\n\u003cbr /\u003e\nMutlu Full Enerji Ak\u0026uuml;ler; geliştirilmiş i\u0026ccedil; yapılarıyla y\u0026uuml;ksek enerji gereksinimi olan uygulamalarda %50\u0026rsquo;ye kadar derin deşarj \u0026ouml;zelligine sahip, karavan ve motokaravanlarda kullanım i\u0026ccedil;in uygun ak\u0026uuml;lerdir. Bakım gerektirmeyen Mutlu Full Enerji Ak\u0026uuml;ler, zorlu iklim ve yol koşullarında kamp tutkunlarının dostudur.\u003c/p\u003e\n","imageUrls":[{"type":"list","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/97517.png"},{"type":"cover","image":"https://cdnd.mutlu.com.tr/category/crops/295x380/88325.png"}]}]},{"id":75,"name":"Endüstriyel","slug":"endustriyel-akuleri","categoryOrder":25,"isActive":1,"slogan":"Endüstriyel Kategorisi Ürünler","lang":"tr","shortDescription":"\u003cp\u003eEnd\u0026uuml;striyel ama\u0026ccedil;lı Mutlu Ak\u0026uuml;ler, bir\u0026ccedil;ok sekt\u0026ouml;r\u0026uuml;n farklı ihtiya\u0026ccedil; ve beklentilerine y\u0026ouml;nelik geliştirilmiş enerji \u0026ccedil;\u0026ouml;z\u0026uuml;mleridir. Hem kullanım alanları hem de kullanıcıların end\u0026uuml;striyel ama\u0026ccedil;lı ak\u0026uuml;lerden beklentileri starter ak\u0026uuml;lere g\u0026ouml;re farklılık g\u0026ouml;stermektedir. Elektrikli forkliftler, transpaletler, platform ve vin\u0026ccedil;ler, maden lokomotifleri, havacılık yer destek ekipmanları, istif makineleri, ak\u0026uuml;l\u0026uuml; \u0026ccedil;ekiciler, yer temizlik ara\u0026ccedil;ları, taşıyıcı konvey\u0026ouml;r sistemleri, telekom istasyonları, g\u0026uuml;\u0026ccedil; dağıtım istasyonları, santraller (g\u0026uuml;neş, r\u0026uuml;zgar gibi yenilenebilir enerji tesisleri ile termik ve hidroelektrik enerji \u0026uuml;retim tesisleri), g\u0026uuml;venlik sistemleri, raylı sistemler, bilgi işlem odaları, kesintisiz g\u0026uuml;\u0026ccedil; kaynakları (UPS) gibi bir\u0026ccedil;ok alanda Mutlu End\u0026uuml;striyel Ak\u0026uuml;ler tercih edilmektedir. Uzun \u0026ouml;m\u0026uuml;r ve minimum bakım avantajıyla dikkat \u0026ccedil;eken Mutlu End\u0026uuml;striyel Ak\u0026uuml;ler; Traksiyoner, Stasyoner(OPzS) ve VRLA \u0026uuml;r\u0026uuml;n gruplarıyla farklı kapasite ve voltaj değerlerinde en doğru \u0026ccedil;\u0026ouml;z\u0026uuml;mleri sağlamaktadır.\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eMutlu Traksiyoner ak\u0026uuml;ler, malzeme kaldırma ve taşımalarında, elektrikli taşıtlarda, ambalaj platformları ve y\u0026uuml;kseltmelerde, otomatik y\u0026ouml;nlendirmeli taşıtlarda ve \u0026ouml;zel bazı DC hareket sistemlerinde yaygın olarak kullanılmaktadır. T\u0026uuml;pl\u0026uuml; pozitif plak teknolojisi sayesinde derin deşarjlara dayanıklı ve uzun \u0026ouml;m\u0026uuml;rl\u0026uuml;d\u0026uuml;rler.\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eMutlu Stasyoner (OPzS) Ak\u0026uuml;ler, kesintisiz enerji tedariğinin kritik \u0026ouml;nem taşıdığı bir\u0026ccedil;ok sabit tesis uygulamasında kullanım i\u0026ccedil;in uygundur. Y\u0026uuml;ksek şarj-deşarj dayanımları sonucu uzun \u0026ouml;m\u0026uuml;r avantajına sahip Mutlu Stasyoner Ak\u0026uuml;ler, sistemlerin ihtiya\u0026ccedil; duyduğu kesintisiz enerjiyi sağlayan g\u0026uuml;\u0026ccedil; kaynaklarıdır.\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eMutlu VRLA Ak\u0026uuml;ler, sahip olduğu kuru tip \u0026uuml;r\u0026uuml;n teknolojisi ve tam kapalı kapak sistemleriyle uzun s\u0026uuml;reli sabit tesis uygulamalarında ideal \u0026ccedil;\u0026ouml;z\u0026uuml;m olarak \u0026ouml;ne \u0026ccedil;ıkar. Sağladıkları y\u0026uuml;ksek performans ve g\u0026uuml;venlik sayesinde Mutlu VRLA Ak\u0026uuml;ler; enerji, ulaşım ve telekom\u0026uuml;nikasyon gibi sekt\u0026ouml;rlerde yaygın olarak tercih edilmektedir.\u003c/p\u003e\n","subCategories":[]},{"id":76,"name":"Pil","slug":"pillerimiz","categoryOrder":26,"isActive":1,"slogan":"Pil Kategorisi Ürünler","lang":"tr","shortDescription":"\u003cp\u003eMutlu Alkalin Kalem Piller; uzaktan kumandalar, oyuncaklar, dijital cihazlar ve diğer k\u0026uuml;\u0026ccedil;\u0026uuml;k elektronik aletler gibi \u0026ccedil;eşitli alanlarda kullanıma uygun olarak tasarlanmıştır. G\u0026uuml;ndelik yaşamın vazge\u0026ccedil;ilmezi olan cihazlara g\u0026uuml;venilir enerji \u0026ccedil;\u0026ouml;z\u0026uuml;mleri sunan, \u0026nbsp;\u0026ccedil;evre dostu \u0026uuml;retime \u0026ouml;nem verilerek \u0026uuml;retilen piller; kullanım sonrası geri d\u0026ouml;n\u0026uuml;ş\u0026uuml;m imkanı sunmaktadır. Mutlu Alkalin Kalem Piller, uluslararası kalite standartlarına ve g\u0026uuml;venlik koşullarına uygun olarak \u0026nbsp;tasarlanarak cihazınız i\u0026ccedil;in g\u0026uuml;venilir koruma sağlar.\u003c/p\u003e\n","subCategories":[]}],"globalTechnologyGroups":[{"id":90,"group_name":"Lityum İyon Aküler","slug":"lityum-iyon-akuler","items":[{"id":90,"sector_id":46,"lang":"tr","name":"Lityum İyon Aküler","slogan":"","short_description":"\u003cp\u003eGeleceğin \u0026uuml;r\u0026uuml;n teknolojisi olarak kabul edilen Lityum İyon ak\u0026uuml;ler, teknik \u0026ouml;zellikleriyle de diğer enerji depolama \u0026ccedil;\u0026ouml;z\u0026uuml;mlerine g\u0026ouml;re \u0026ouml;n plana \u0026ccedil;ıkmaktadır. Mutlu Ak\u0026uuml; tarafından m\u0026uuml;şteri ihtiya\u0026ccedil; ve beklentilerine en uygun şekilde ve projeye \u0026ouml;zel olarak tasarlanan lityum iyon ak\u0026uuml;ler, bakım gerektirmeme \u0026ouml;zellikleriyle de kullanım kolaylığı sağlar. Y\u0026uuml;ksek performans ve uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml;ne sahip Lityum İyon Ak\u0026uuml;ler; otomotiv sekt\u0026ouml;r\u0026uuml;, forkliftler, istifleme makinaları, mekik sistemleri, solar sistemler, golf ara\u0026ccedil;ları, karavanlar, raylı sistem ulaşım ara\u0026ccedil;ları, temizlik makinaları, telekom istasyonları ve ev tipi depolama sistemleri gibi bir\u0026ccedil;ok alanda tercih edilir.\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eMutlu Lityum İyon ak\u0026uuml;ler, derin deşarj kapasiteleri sayesinde tekrar tekrar şarj edilebilir ve daha yavaş deşarj oldukları i\u0026ccedil;in uzun s\u0026uuml;reler maksimum performansla kullanılabilir. Gaz \u0026ccedil;ıkışı s\u0026ouml;z konusu olmadığı i\u0026ccedil;in kapalı alanlarda bile rahat\u0026ccedil;a muhafaza edilebilirler. Sıcaklığa karşı dayanımları ise olduk\u0026ccedil;a y\u0026uuml;ksektir ve sıcaklık değişimlerinden \u0026ccedil;ok daha az etkilenirler. Bu sayede farklı iklim ve sıcaklık koşullarında voltaj dalgalanmaları, korozyon veya ak\u0026uuml; şişmesi gibi problemler yaşanmaz. Lityum iyon ak\u0026uuml;ler, i\u0026ccedil;erisinde sıvı formda elektrolit bulunmadığı i\u0026ccedil;in asit taşması veya sızıntılarına karşı da mukavemetlidirler. \u0026nbsp;\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003e\u0026Ccedil;evreye duyarlı \u0026uuml;r\u0026uuml;n teknolojisiyle s\u0026uuml;rd\u0026uuml;r\u0026uuml;lebilirliğe katkı sağlayan Lityum İyon Ak\u0026uuml;ler, karşıladıkları y\u0026uuml;ksek test standartları ile de g\u0026uuml;ven verir. Benzer kapasitedeki farklı teknolojiyle \u0026uuml;retilmiş ak\u0026uuml;lere g\u0026ouml;re enerji verimliliklerinin daha y\u0026uuml;ksek olması, kurşun asit ak\u0026uuml;lere g\u0026ouml;re daha az enerji t\u0026uuml;ketmeleri sayesinde \u0026ouml;nemli maliyet avantajları vardır. Ak\u0026uuml; değişiminden kaynaklı duruşlara sebep olmaması operasyonel verimlilik artışı sağlar. Su ekleme, asit seviyesi kontrol etme gibi iş\u0026ccedil;ilik maliyetleri de yoktur. Aynı zamanda diğer ak\u0026uuml;lere g\u0026ouml;re daha az yer kaplamaları, hem end\u0026uuml;striyel ama\u0026ccedil;lı hem de ev tipi enerji depolama \u0026ccedil;\u0026ouml;z\u0026uuml;m\u0026uuml; olarak kullanımlarının \u0026ouml;ne \u0026ccedil;ıkan \u0026uuml;st\u0026uuml;nl\u0026uuml;klerindendir.\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eBatarya Y\u0026ouml;netim Sistemi (Battery Management System/BMS) sayesinde Lityum İyon Ak\u0026uuml;lerin; kapasite, voltaj, sıcaklık, şarj seviyesi (SoC) ve batarya sağlığı (SoH) s\u0026uuml;rekli olarak izlenebilir, ger\u0026ccedil;ek zamanlı kontrol ve takip sağlanır. B\u0026ouml;ylece daha uzun s\u0026uuml;reli ve y\u0026uuml;ksek performanslı kullanım elde edilerek duruşlar \u0026ouml;nlenir, ak\u0026uuml; kaynaklı operasyonel kesintiler yaşanmaz.\u003c/p\u003e\n","slug":"lityum-iyon-akuler","created_at":"2022-05-31T13:18:34.000000Z","updated_at":"2022-09-07T15:23:08.000000Z","long_description":"\u003cul\u003e\n\t\u003cli\u003eProjeye \u0026ouml;zel, m\u0026uuml;şteri ihtiya\u0026ccedil; ve beklentilerine en uygun \u0026ccedil;\u0026ouml;z\u0026uuml;mler\u003c/li\u003e\n\t\u003cli\u003e\u0026Ccedil;evreye duyarlı ve enerji verimliliği y\u0026uuml;ksek \u0026uuml;r\u0026uuml;nler sayesinde s\u0026uuml;rd\u0026uuml;r\u0026uuml;lebilirliğe katkı\u003c/li\u003e\n\t\u003cli\u003eUzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml;ne sahip, y\u0026uuml;ksek performanslı ve g\u0026uuml;venli \u0026uuml;r\u0026uuml;n teknolojisi\u003c/li\u003e\n\u003c/ul\u003e\n","group_name":"Lityum İyon Aküler","status_lang":1,"documents":{"id":197,"sector_id":46,"type":"coverWeb","path":"https://cdnd.mutlu.com.tr/sector/crops/_x_/43801-1.png","video_embed":"","created_at":"2022-05-31T14:27:21.000000Z","updated_at":"2022-05-31T14:27:21.000000Z","rank":0,"original_filename":null,"lang":null,"description1":"","description2":""}}]},{"id":159,"group_name":"AGM Aküler","slug":"agm-ticari-akuler","items":[{"id":159,"sector_id":54,"lang":"tr","name":"AGM Ticari Aküler","slogan":"","short_description":"\u003cp\u003eVRLA teknolojisine sahip AGM Ticari Ak\u0026uuml;ler; bir\u0026ccedil;ok ara\u0026ccedil; ve farklı kullanım alanı olmak \u0026uuml;zere geniş bir yelpazede tercih edilmektedir. Mutlu AGM Ticari Ak\u0026uuml;ler, ara\u0026ccedil;lardaki motorların \u0026ccedil;alışması ve ekipmanlar i\u0026ccedil;in ihtiya\u0026ccedil; duyulan enerjiyi sağlar. Standart ak\u0026uuml;lere kıyasla 4 kata kadar daha uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml;ne sahip Mutlu AGM Ticari Ak\u0026uuml;ler, y\u0026uuml;zde 40\u0026rsquo;a kadar daha y\u0026uuml;ksek performans sunar. Ayrıca y\u0026uuml;ksek titreşim dayanımı sayesinde; zorlu iklimlerde, değişken hava sıcaklıklarında ve yoğun \u0026ccedil;alışma şartlarında standart ak\u0026uuml;lere kıyasla daha \u0026uuml;st\u0026uuml;n performansı sergiler. Mutlu AGM Ticari Ak\u0026uuml;ler; d\u0026ouml;k\u0026uuml;m teknolojili ızgaraları, cam elyaf seperat\u0026ouml;rleri, \u0026ouml;zel basın\u0026ccedil; kontrol valfli (VRLA) kapak sistemi ile uzun \u0026ouml;m\u0026uuml;rl\u0026uuml;d\u0026uuml;r.\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eAra\u0026ccedil; \u0026uuml;reticilerinin teknik ve \u0026uuml;st\u0026uuml;n performans beklentilerini karşılayan Mutlu AGM Ticari Ak\u0026uuml;ler, Start-Stop teknolojisine uygun olarak hızlı şarj alma \u0026ouml;zelliğine sahiptir. Mutlu AGM Ticari Ak\u0026uuml;ler, t\u0026uuml;m ara\u0026ccedil; tiplerine uygun ak\u0026uuml;ler yer almaktadır. Arka şasi kullanımına uygundur ve gece konaklama konfor fonksiyonlarını destekler. \u0026nbsp;\u003c/p\u003e\n","slug":"agm-ticari-akuler","created_at":"2026-02-27T12:01:12.000000Z","updated_at":"2026-02-27T12:01:12.000000Z","long_description":"\u003cul\u003e\n\t\u003cli\u003eRejeneratif frenleme \u0026ouml;zelliği i\u0026ccedil;eren gelişmiş Start-Stop teknolojisine sahip ara\u0026ccedil;lar i\u0026ccedil;in \u0026ouml;zel tasarım\u003c/li\u003e\n\t\u003cli\u003eVRLA teknolojisi sayesinde, standart sulu tip ak\u0026uuml;lere g\u0026ouml;re 4 kat daha uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml; ve y\u0026uuml;ksek şarj alma kapasitesi\u003c/li\u003e\n\t\u003cli\u003eAra\u0026ccedil; \u0026uuml;reticilerinin teknik ve \u0026uuml;st\u0026uuml;n performans beklentilerini karşılayan geniş \u0026uuml;r\u0026uuml;n gamı\u003c/li\u003e\n\u003c/ul\u003e\n","group_name":"AGM Aküler","status_lang":1,"documents":{"id":455,"sector_id":54,"type":"coverWeb","path":"https://cdnd.mutlu.com.tr/sector/crops/_x_/40421.png","video_embed":"","created_at":"2026-03-04T06:37:01.000000Z","updated_at":"2026-03-04T06:37:01.000000Z","rank":0,"original_filename":null,"lang":"tr","description1":"","description2":""}},{"id":64,"sector_id":38,"lang":"tr","name":"AGM Aküler","slogan":"","short_description":"\u003cp\u003eVRLA teknolojisine sahip AGM Ak\u0026uuml;ler; bir\u0026ccedil;ok ara\u0026ccedil; ve farklı kullanım alanı olmak \u0026uuml;zere geniş bir yelpazede tercih edilmektedir. Mutlu AGM Ak\u0026uuml;ler, ara\u0026ccedil;lardaki motorların \u0026ccedil;alışması ve ekipmanlar i\u0026ccedil;in ihtiya\u0026ccedil; duyulan enerjiyi sağlar. Standart ak\u0026uuml;lere kıyasla 3 kata kadar daha uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml;ne sahip Mutlu AGM Ak\u0026uuml;ler, y\u0026uuml;zde 40\u0026rsquo;a kadar daha y\u0026uuml;ksek performans sunar. Ayrıca y\u0026uuml;ksek titreşim dayanımı sayesinde; zorlu iklimlerde, değişken hava sıcaklıklarında ve yoğun \u0026ccedil;alışma şartlarında standart ak\u0026uuml;lere kıyasla daha \u0026uuml;st\u0026uuml;n performansı sergiler. Mutlu AGM Ak\u0026uuml;ler; d\u0026ouml;k\u0026uuml;m teknolojili ızgaraları, cam elyaf seperat\u0026ouml;rleri, \u0026ouml;zel basın\u0026ccedil; kontrol valfli (VRLA) kapak sistemi ile uzun \u0026ouml;m\u0026uuml;rl\u0026uuml;d\u0026uuml;r.\u003c/p\u003e\n\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eAra\u0026ccedil; \u0026uuml;reticilerinin teknik ve \u0026uuml;st\u0026uuml;n performans beklentilerini karşılayan Mutlu AGM Ak\u0026uuml;ler, Start-Stop teknolojisine uygun olarak hızlı şarj alma \u0026ouml;zelliğine sahiptir. Mutlu AGM Ak\u0026uuml;ler, yeni nesil rejeneratif frenleme sistemine sahip Start-Stop \u0026ouml;zellikli binek ara\u0026ccedil;ların ihtiya\u0026ccedil;ları g\u0026ouml;z \u0026ouml;n\u0026uuml;nde bulundurularak tasarlanmıştır. Bu sistemlerde fren enerjisi geri kazanılmaktadır. Yoğun enerji ihtiyacı olan Start-Stop ve rejeneratif frenleme sistemine sahip minivan ve panelvan ara\u0026ccedil;larda da Mutlu AGM Ak\u0026uuml;ler, uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml;yle avantaj sağlar. Benzer \u0026ouml;zelliklere sahip, gerek personel taşımacılığı gerek y\u0026uuml;ksek i\u0026ccedil; donanımıyla VIP taşımacılıkta kullanılan minib\u0026uuml;slerde de Mutlu AGM Ak\u0026uuml;ler tercih edilir. Mutlu AGM Ak\u0026uuml;ler, \u0026ouml;zg\u0026uuml;r gezginlerin ve kamp tutkunlarının vazge\u0026ccedil;ilmezi olan karavan ve motokaravanlarda da enerji ihtiya\u0026ccedil;larını karşılar.\u003cbr /\u003e\nSoğuk zincir taşımacılığında, soğutucu sistemlerde de Mutlu AGM Ak\u0026uuml;ler kullanılabilir. Uzun kullanım \u0026ouml;m\u0026uuml;rl\u0026uuml; Mutlu AGM Ak\u0026uuml;ler, temizlik ekipmanları ve UPS sistemlerinde de kullanılabilir. \u0026nbsp;\u003c/p\u003e\n","slug":"agm-akuler","created_at":"2021-05-19T13:38:24.000000Z","updated_at":"2022-03-17T09:06:01.000000Z","long_description":"\u003cul\u003e\n\t\u003cli\u003eRejeneratif frenleme \u0026ouml;zelliği i\u0026ccedil;eren gelişmiş Start-Stop teknolojisine sahip ara\u0026ccedil;lar i\u0026ccedil;in \u0026ouml;zel tasarım\u003c/li\u003e\n\t\u003cli\u003eVRLA teknolojisi sayesinde, standart sulu tip ak\u0026uuml;lere g\u0026ouml;re 3 kat daha uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml; ve y\u0026uuml;ksek şarj alma kapasitesi\u003c/li\u003e\n\t\u003cli\u003eAra\u0026ccedil; \u0026uuml;reticilerinin teknik ve \u0026uuml;st\u0026uuml;n performans beklentilerini karşılayan geniş \u0026uuml;r\u0026uuml;n gamı\u003c/li\u003e\n\u003c/ul\u003e\n","group_name":"AGM Aküler","status_lang":1,"documents":{"id":418,"sector_id":38,"type":"coverWeb","path":"https://cdnd.mutlu.com.tr/sector/crops/_x_/77883.png","video_embed":"","created_at":"2024-10-22T11:36:46.000000Z","updated_at":"2024-10-22T11:36:46.000000Z","rank":0,"original_filename":null,"lang":"tr","description1":"","description2":""}},{"id":60,"sector_id":34,"lang":"tr","name":"AGM Askeri Tip Aküler","slogan":"","short_description":"\u003cp\u003eMutlu AGM Askeri Tip Ak\u0026uuml;ler, askeri ara\u0026ccedil;ların \u0026ccedil;alışması i\u0026ccedil;in gereken marş g\u0026uuml;c\u0026uuml;n\u0026uuml; karşılayan uzun \u0026ouml;m\u0026uuml;rl\u0026uuml; kuru tip ak\u0026uuml;lerdir. Aynı zamanda askeri ara\u0026ccedil;lar, misyonlarına g\u0026ouml;re elektrikle \u0026ccedil;alışan bir\u0026ccedil;ok dahili ve harici ekipmanı, donanımı taşıyabilir. Bu kapsamda \u0026nbsp;Mutlu AGM Askeri Tip Ak\u0026uuml;ler, askeri ara\u0026ccedil;larda yer alan elektronik donanım ve te\u0026ccedil;hizatların ihtiya\u0026ccedil; duyduğu elektrik enerjisini sağlar. Temelinde VRLA (emdirilmiş cam elyaf) teknolojisini barındıran AGM Askeri Tip Ak\u0026uuml;ler; g\u0026uuml;\u0026ccedil;lendirilmiş i\u0026ccedil; yapısı ve d\u0026ouml;k\u0026uuml;m teknolojili ızgaralarıyla ekstra dayanım g\u0026ouml;sterir. AGM Ak\u0026uuml; teknolojisi, en gelişmiş sistemlere sahip ara\u0026ccedil;larda kullanıldığı i\u0026ccedil;in teknolojik ve hassas donanımları b\u0026uuml;nyesinde barındıran askeri ara\u0026ccedil;lar i\u0026ccedil;in de son derece uygundur. NATO MIL-STD-810G standartlarına g\u0026ouml;re \u0026uuml;retilen AGM Askeri Tip Ak\u0026uuml;ler, y\u0026uuml;ksek marş g\u0026uuml;c\u0026uuml; ve g\u0026uuml;\u0026ccedil;lendirilmiş i\u0026ccedil; yapılarıyla askeri ara\u0026ccedil;larda ihtiya\u0026ccedil; duyulan y\u0026uuml;ksek performansı sunar. AGM Askeri Tip Ak\u0026uuml;ler\u0026rsquo;in alev almayan ve yanmayı geciktirici plastik malzemeden \u0026uuml;retilen \u0026ouml;zel kutu tasarımı ise maksimum seviyede g\u0026uuml;venlik ve emniyet sağlar. Sızdırmaz yapıda oluşu, s\u0026uuml;lfatlaşma olmaması ve bakım gerektirmemesi bu ak\u0026uuml;lerin \u0026ouml;ne \u0026ccedil;ıkan avantajlarındandır.\u003c/p\u003e\n\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eMutlu Ak\u0026uuml;\u0026rsquo;n\u0026uuml;n AGM Askeri Tip Ak\u0026uuml;leri, savunma sanayinin kullandığı askeri tank, panzer ve zırhlı tekerlekli ara\u0026ccedil;ların enerji ihtiya\u0026ccedil;larını karşılar. Y\u0026uuml;ksek performansa sahip AGM Askeri Tip Ak\u0026uuml;ler; haberleşme, navigasyon ve askeri operasyonlarda kullanılan bir\u0026ccedil;ok elektronik cihazın gereksinim duyacağı elektriği de temin eder. Darbelere karşı mukavemeti ve y\u0026uuml;ksek titreşim dayanımı sayesinde, zorlu g\u0026ouml;revlerde, engebeli arazilerde ve değişken iklim şartlarında kullanıma uygundur. AGM Askeri Tip Ak\u0026uuml;ler, \u0026ouml;zel pirin\u0026ccedil; yapıdaki kutup başları sayesinde, standart ak\u0026uuml;lere oranla \u0026ccedil;ok y\u0026uuml;ksek akımlara karşı \u0026uuml;st d\u0026uuml;zey dayanım sunar.\u0026nbsp;\u003c/p\u003e\n","slug":"agm-askeri-tip-akuler","created_at":"2021-05-16T18:25:17.000000Z","updated_at":"2021-08-16T07:59:55.000000Z","long_description":"\u003cul\u003e\n\t\u003cli\u003eAskeri tip ara\u0026ccedil;larda kullanım i\u0026ccedil;in geliştirilmiş, NATO MIL-STD-810G standartlarına uygun, VRLA ak\u0026uuml; teknolojisi\u003c/li\u003e\n\t\u003cli\u003eDarbelere karşı dayanımı sayesinde zorlu iklim şartlarında y\u0026uuml;ksek performans\u003c/li\u003e\n\t\u003cli\u003eY\u0026uuml;ksek marş g\u0026uuml;c\u0026uuml; ve g\u0026uuml;\u0026ccedil;lendirilmiş i\u0026ccedil; yapı\u003c/li\u003e\n\t\u003cli\u003eYanmayı geciktirici plastik malzemeden \u0026uuml;retilen \u0026ouml;zel kutu tasarımı sayesinde y\u0026uuml;ksek g\u0026uuml;venlik\u003c/li\u003e\n\u003c/ul\u003e\n","group_name":"AGM Aküler","status_lang":1,"documents":{"id":55,"sector_id":34,"type":"coverWeb","path":"https://cdnd.mutlu.com.tr/sector/crops/_x_/AGM-Askeri-Tip-Akuler.png","video_embed":"-","created_at":"2021-06-01T00:00:00.000000Z","updated_at":"2021-06-01T00:00:00.000000Z","rank":0,"original_filename":null,"lang":null,"description1":null,"description2":null}}]},{"id":154,"group_name":"Endüstriyel Aküler","slug":"pillerimiz","items":[{"id":154,"sector_id":49,"lang":"tr","name":"Pil","slogan":"Pil","short_description":"\u003cp\u003eMutlu Alkalin Kalem Piller; uzaktan kumandalar, oyuncaklar, dijital cihazlar ve diğer k\u0026uuml;\u0026ccedil;\u0026uuml;k elektronik aletler gibi \u0026ccedil;eşitli alanlarda kullanıma uygun olarak tasarlanmıştır. G\u0026uuml;ndelik yaşamın vazge\u0026ccedil;ilmezi olan cihazlara g\u0026uuml;venilir enerji \u0026ccedil;\u0026ouml;z\u0026uuml;mleri sunan, \u0026nbsp;\u0026ccedil;evre dostu \u0026uuml;retime \u0026ouml;nem verilerek \u0026uuml;retilen piller; kullanım sonrası geri d\u0026ouml;n\u0026uuml;ş\u0026uuml;m imkanı sunmaktadır. Mutlu Alkalin Kalem Piller, uluslararası kalite standartlarına ve g\u0026uuml;venlik koşullarına uygun olarak \u0026nbsp;tasarlanarak cihazınız i\u0026ccedil;in g\u0026uuml;venilir koruma sağlar.\u0026nbsp;\u003c/p\u003e\n","slug":"pillerimiz","created_at":"2025-01-31T10:53:55.000000Z","updated_at":"2025-12-16T08:43:18.000000Z","long_description":"\u003cul\u003e\n\t\u003cli\u003eMutlu Alkalin Kalem Piller ile ilgili t\u0026uuml;m ayrıntıları aşağıdaki PDF dosyalarından inceleyebilirsiniz. (Kullanma kılavuzu olarak oluşturduğumuz pdfler burada altında eklenecek.)\u003c/li\u003e\n\u003c/ul\u003e\n","group_name":"Endüstriyel Aküler","status_lang":1,"documents":{"id":439,"sector_id":49,"type":"coverWeb","path":"https://cdnd.mutlu.com.tr/sector/crops/_x_/76076.jpg","video_embed":"-","created_at":"2025-12-16T11:34:08.000000Z","updated_at":"2025-12-16T11:34:11.000000Z","rank":0,"original_filename":null,"lang":"tr","description1":null,"description2":null}},{"id":68,"sector_id":42,"lang":"tr","name":"Traksiyoner Aküler","slogan":"","short_description":"\u003cp\u003e\u0026Ouml;zellikle \u0026ccedil;evre fakt\u0026ouml;r\u0026uuml;n\u0026uuml;n \u0026ouml;nemli olduğu kapalı alanlarda temiz enerji kaynağı olarak \u0026ouml;ne \u0026ccedil;ıkan Traksiyoner Ak\u0026uuml;ler, elektrik ile \u0026ccedil;alışan ara\u0026ccedil;larda g\u0026uuml;\u0026ccedil; kaynağı olarak tercih edilir. DIN ve BS standartlarında geniş bir \u0026uuml;r\u0026uuml;n gamına sahip Mutlu Traksiyoner Ak\u0026uuml;lerde t\u0026uuml;pl\u0026uuml; plak teknolojisi (PzS, PzSB, PzSBL) kullanılmaktadır. T\u0026uuml;pl\u0026uuml; pozitif plak teknolojisi sayesinde derin deşarjlara dayanıklı ve uzun \u0026ouml;m\u0026uuml;rl\u0026uuml;d\u0026uuml;rler.\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eKurşun asit ak\u0026uuml;lerin temel prensiplerine g\u0026ouml;re \u0026ccedil;alışan Mutlu Traksiyoner Ak\u0026uuml;ler, \u0026ccedil;ok yaygın bir end\u0026uuml;striyel ama\u0026ccedil;lı kullanım alanına sahiptir. \u0026nbsp;Elektrikli forkliftler, transpaletler, platform ve vin\u0026ccedil;ler, maden lokomotifleri, havacılık yer destek ekipmanları, istif makineleri, ak\u0026uuml;l\u0026uuml; \u0026ccedil;ekiciler, yer temizlik ara\u0026ccedil;ları ve taşıyıcı konvey\u0026ouml;r sistemleri ihtiya\u0026ccedil; duydukları elektrik enerjisini Mutlu Traksiyoner Ak\u0026uuml;ler sayesinde karşılamaktadır.\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eMutlu Traksiyoner Ak\u0026uuml;lerin i\u0026ccedil; yapısında yer alan aktif madde ve ızgaraların \u0026ouml;zel tasarımlı dokumasız tip t\u0026uuml;pler i\u0026ccedil;erisine yerleştirilmesi sayesinde aktif madde uzun s\u0026uuml;re plakta kalır, b\u0026ouml;ylece ak\u0026uuml;n\u0026uuml;n uzun \u0026ouml;m\u0026uuml;rl\u0026uuml; olması sağlanır. Optimize edilmiş d\u0026uuml;ş\u0026uuml;k antimonlu ızgara alaşımları sayesinde ise y\u0026uuml;ksek korozyon direnci ve minimum su kaybı ortaya \u0026ccedil;ıkar. Pozitif plakları zarf şeklinde saran seperat\u0026ouml;rler de kısa devre riskini ortadan kaldırır.\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eAk\u0026uuml; bileşenleri, aside ve darbelere dayanıklı polipropilen malzemeden \u0026uuml;retilmiş kutular i\u0026ccedil;erisinde yer alır. Kapak \u0026uuml;zerinde bulunan sızdırmazlık contaları, kutup başlarının sızdırmazlığını sağlar. Ak\u0026uuml; kutularının alt tarafında bulunan prizma vasıtasıyla zamanla plaklardan d\u0026ouml;k\u0026uuml;lebilecek tortular toplanarak kısa devre oluşması \u0026ouml;nlenir. Kapak \u0026uuml;zerinde ise şarj esnasında oluşan gazların ak\u0026uuml;den \u0026ccedil;ıkışına izin veren buşonlar yer alır. H\u0026uuml;creler i\u0026ccedil;erisindeki elektrolit seviyesini eşitlemeyi sağlayan otomatik dolum sistemi, h\u0026uuml;cre i\u0026ccedil;erisine verilen hava ile elektrolitin etkin bir şekilde karıştırılabildiği air mix sistemi ve elektrolit seviyelerinin Led ışığı aracılığıyla kolayca takip edilebildiği seviye sens\u0026ouml;r\u0026uuml; ise m\u0026uuml;şteri isteklerine g\u0026ouml;re opsiyonel olarak sunulur.\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eMutlu Traksiyoner Ak\u0026uuml;ler; BS Tip, DIN/Flexible Tip, DIN/Perfect Tip ve 6V Golf ak\u0026uuml;s\u0026uuml; se\u0026ccedil;enekleriyle m\u0026uuml;şteri ihtiya\u0026ccedil; ve beklentilerine uygun olarak tasarlanır. (PzS) tipi ak\u0026uuml;ler 120Ah\u0026rsquo;den 1550Ah\u0026#39;e; BS (PzSB) tipi ak\u0026uuml;ler ise 80Ah\u0026rsquo;den 900Ah\u0026rsquo;e kadar değişen kapasite alternatifleriyle Mutlu Traksiyoner \u0026uuml;r\u0026uuml;n gamında yer alır.\u003c/p\u003e\n","slug":"traksiyoner-akuler","created_at":"2021-12-23T07:30:38.000000Z","updated_at":"2021-12-23T07:30:38.000000Z","long_description":"\u003cul\u003e\n\t\u003cli\u003eEnjeksiyon teknolojisi ile \u0026uuml;retilmiş, korozyona karşı dayanıklı ızgaralar\u003c/li\u003e\n\t\u003cli\u003eSu ekleme ve elektrolit yoğunluğunu \u0026ouml;l\u0026ccedil;meye imkan veren a\u0026ccedil;ılabilir kapaklı buşonlar\u003c/li\u003e\n\t\u003cli\u003eY\u0026uuml;ksek poroziteli ve delinme direncine sahip seperat\u0026ouml;rler sayesinde d\u0026uuml;ş\u0026uuml;k i\u0026ccedil; diren\u0026ccedil; ve y\u0026uuml;ksek asit hacmi\u003c/li\u003e\n\u003c/ul\u003e\n","group_name":"Endüstriyel Aküler","status_lang":1,"documents":{"id":4,"sector_id":42,"type":"coverWeb","path":"https://cdnd.mutlu.com.tr/sector/crops/_x_/84970-1.png","video_embed":"","created_at":"2021-12-23T08:48:00.000000Z","updated_at":"2021-12-23T08:48:00.000000Z","rank":0,"original_filename":null,"lang":null,"description1":null,"description2":null}},{"id":69,"sector_id":43,"lang":"tr","name":"Stasyoner Aküler","slogan":"","short_description":"\u003cp\u003eMutlu Stasyoner (OPzS) Ak\u0026uuml;ler, genel kurşun asit sabit tesis ak\u0026uuml;lerinin teknolojik olarak geliştirilmiş bi\u0026ccedil;imidir. Kullanıcı i\u0026ccedil;in y\u0026uuml;zd\u0026uuml;rme gerilimiyle \u0026ccedil;alışma sisteminde, minimum bakım ve d\u0026uuml;ş\u0026uuml;k enerji maliyeti dikkate alınarak, \u0026ouml;zel şekilde dizayn edilip \u0026uuml;retilmişlerdir. Temel \u0026ouml;zelliği, d\u0026uuml;ş\u0026uuml;k antimonlu kurşun alaşımı nedeniyle kendi kendine az deşarj olması ve bu sayede su kaybını b\u0026uuml;y\u0026uuml;k \u0026ouml;l\u0026ccedil;\u0026uuml;de azaltmış olmasıdır. Aktif maddeyi tutuşu ve şarj-deşarj kabiliyeti y\u0026uuml;ksektir.\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eTam şarjlı ve kullanıma hazır olarak sevk edilen Mutlu Stasyoner Ak\u0026uuml;ler; hızlı ve g\u0026uuml;venli bir şekilde, \u0026ccedil;ok fazla eğitime ihtiya\u0026ccedil; duymadan montaj yapılabilirler. Normal y\u0026uuml;zd\u0026uuml;rme şarjı altında 2-3 yıl veya daha fazla s\u0026uuml;re i\u0026ccedil;in saf su ilavesi gerektirmezler. Kutuların \u0026uuml;zerinde, şeffaf plastiklerde elektrolit seviyesini g\u0026ouml;steren min/max seviye \u0026ccedil;izgileri yer alır. Yapıştırılarak monte edilmiş kapak ve \u0026ouml;zel olarak \u0026uuml;retilmiş seramik buşonları sayesinde dışarıya asit sı\u0026ccedil;rama ve sızması olmaz.\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eMutlu Stasyoner (OPzS) Ak\u0026uuml;lerin i\u0026ccedil; yapısında yer alan enjeksiyon teknolojisiyle \u0026uuml;retilmiş, korozyona karşı dayanıklı ızgaralar ve %99,99 saflık derecesine sahip kurşundan \u0026uuml;retilen aktif madde pozitif plakları oluşturur. \u0026nbsp;Y\u0026uuml;ksek performans sağlayan, \u0026ouml;zel hamur form\u0026uuml;l\u0026uuml;ne sahip negatif plaklar ise aktif maddeyi uzun s\u0026uuml;re \u0026uuml;zerinde muhafaza eden negatif ızgaralardan meydana gelir. Y\u0026uuml;ksek poroziteli ve delinme direncine sahip yaprak tip seperat\u0026ouml;rler kullanılır. D\u0026uuml;ş\u0026uuml;k antimonlu ızgara alaşımları, y\u0026uuml;ksek korozyon direnci ve minimum su kaybı sağlar.\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eMutlu Stasyoner (OPzS) Ak\u0026uuml;lerde aside ve darbelere dayanıklı malzemeden \u0026uuml;retilmiş şeffaf g\u0026ouml;r\u0026uuml;n\u0026uuml;ml\u0026uuml; kutular kullanılır. (SAN kutu ve ABS kapak) Kutuların alt tarafındaki prizmalar sayesinde kısa devre riski ortadan kalkar. Kapak \u0026uuml;zerinde kutup başlarının sızdırmaz olmasını sağlayan sızdırmazlık contaları ve su ekleme ile elektrolit yoğunluğunu \u0026ouml;l\u0026ccedil;meye imkan veren a\u0026ccedil;ılabilir seramik buşonlar alır. 1.200 - 1.500 şarj-deşarj \u0026nbsp;devresine dayanıklı Mutlu Stasyoner ak\u0026uuml;lerin , 15 yıl ve \u0026uuml;zerinde kullanım \u0026ouml;m\u0026uuml;rleri vardır.\u003c/p\u003e\n\n\u003cp\u003eKapasiteleri 150Ah - 5.000Ah arasında değişen Mutlu Stasyoner (OPzS) Ak\u0026uuml;ler; TSE ve DIN standartlarına g\u0026ouml;re \u0026uuml;retilmekte ve elektriksel değerleri \u0026ouml;l\u0026ccedil;\u0026uuml;mlenmektedir. Telekom istasyonları, g\u0026uuml;\u0026ccedil; dağıtım istasyonları, g\u0026uuml;neş enerjisi santralleri, r\u0026uuml;zgar enerjisi santralleri, termik santraller, hidroelektrik enerji santralleri, g\u0026uuml;venlik sistemleri, raylı sistemler, bilgi işlem odaları ve kesintisiz g\u0026uuml;\u0026ccedil; kaynakları (UPS) gibi \u0026ccedil;ok yaygın bir kullanım alanına sahiptirler.\u003c/p\u003e\n","slug":"stasyoner-akuler","created_at":"2021-12-23T07:33:31.000000Z","updated_at":"2021-12-23T07:33:31.000000Z","long_description":"\u003cul\u003e\n\t\u003cli\u003eY\u0026uuml;ksek şarj-deşarj dayanımları sayesinde 15 yıl ve \u0026uuml;zeri uzun \u0026ouml;m\u0026uuml;r\u0026nbsp;\u003c/li\u003e\n\t\u003cli\u003eUzun s\u0026uuml;reler su ilavesi ve bakım gerektirmeyen \u0026uuml;r\u0026uuml;n teknolojisi\u0026nbsp;\u003c/li\u003e\n\t\u003cli\u003eElektrolit yoğunluğunu \u0026ouml;l\u0026ccedil;meyi sağlayan şeffaf kutu ve seramik buşonlar\u003c/li\u003e\n\u003c/ul\u003e\n","group_name":"Endüstriyel Aküler","status_lang":1,"documents":{"id":141,"sector_id":43,"type":"coverWeb","path":"https://cdnd.mutlu.com.tr/sector/crops/_x_/73457-1.png","video_embed":"","created_at":"2021-12-23T08:49:03.000000Z","updated_at":"2021-12-23T08:49:03.000000Z","rank":0,"original_filename":null,"lang":null,"description1":"","description2":""}},{"id":70,"sector_id":44,"lang":"tr","name":"VRLA Aküler","slogan":"","short_description":"\u003cp\u003eMutlu VRLA ak\u0026uuml;ler; sabit tesis uygulamalarında \u0026ouml;ne \u0026ccedil;ıkan, kuru tip, tam kapalı kapak teknolojisine sahip \u0026uuml;r\u0026uuml;nlerdir. Kesintisiz enerji sağlama ve dengeleme alanlarında ideal \u0026ccedil;\u0026ouml;z\u0026uuml;m olarak kullanılan Mutlu VRLA teknolojili sabit tesis ak\u0026uuml;leri, y\u0026uuml;ksek dayanıklılığa ve uzun \u0026ouml;mre sahiptir. İ\u0026ccedil; yapılarında y\u0026uuml;ksek kısa devre dayanımı sağlayan emdirilmiş cam elyaf seperat\u0026ouml;rler yer alır ve valfli, bakım gerektirmeyen \u0026uuml;r\u0026uuml;n teknolojisiyle \u0026uuml;retilirler.\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eStandart VRLA,\u0026nbsp;VRLA, UPS ve 2V AGM olarak sınıflandırılan Mutlu VRLA ak\u0026uuml;lerin \u0026ccedil;ok yaygın uygulama alanı s\u0026ouml;z konusudur. Telekom istasyonları, g\u0026uuml;\u0026ccedil; dağıtım istasyonları, g\u0026uuml;neş enerjisi santralleri, r\u0026uuml;zgar enerjisi santralleri, termik santraller, hidroelektrik enerji santralleri, g\u0026uuml;venlik sistemleri, raylı sistemler, yangın alarm sistemleri, bilgi işlem odaları ve kesintisiz g\u0026uuml;\u0026ccedil; kaynakları (UPS) gibi bir\u0026ccedil;ok alanda g\u0026uuml;\u0026ccedil; kaynağı olarak kullanılabilmektedirler.\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eMutlu VRLA Ak\u0026uuml;ler, uzun s\u0026uuml;reli uygulamalar i\u0026ccedil;in y\u0026uuml;ksek performans ve g\u0026uuml;venlik sağlar. Alev geciktirici kutularda \u0026uuml;retilen, d\u0026uuml;ş\u0026uuml;k basın\u0026ccedil;lı otomatik kapanan valf kontrol\u0026uuml;ne sahip bu tip ak\u0026uuml;lerde \u0026ldquo;gaz geri d\u0026ouml;n\u0026uuml;ş\u0026uuml;m\u0026rdquo; (gas recombination) sistemi sayesinde ak\u0026uuml; i\u0026ccedil;erisindeki gazın geri kazanımı sağlanmaktadır. \u0026nbsp;Kapalı sistem ak\u0026uuml;lerde bakıma gereksinim duyulmaması, cihaz i\u0026ccedil;i dahil kapalı yerlerde, hatta yatay veya dikey pozisyonlarda kullanılabilmesi \u0026ouml;ne \u0026ccedil;ıkan \u0026uuml;st\u0026uuml;n \u0026uuml;r\u0026uuml;n \u0026ouml;zelliklerindendir.\u003c/p\u003e\n\n\u003cp\u003eİ\u0026ccedil;erisinde serbest formda asit bulundurmadığı i\u0026ccedil;in sızdırmaz \u0026ouml;zellikteki Mutlu VRLA Ak\u0026uuml;ler, d\u0026ouml;k\u0026uuml;m teknolojili ve \u0026ouml;zel form\u0026uuml;le sahip ızgara alaşımları sayesinde uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml;ne sahiptir. Derin deşarj dayanımları ve d\u0026uuml;ş\u0026uuml;k i\u0026ccedil; diren\u0026ccedil;leri uzun s\u0026uuml;reli kullanım sağlar. Mutlu VRLA ak\u0026uuml;ler \u0026uuml;retilirken; darbelere karşı dayanıklı ABS kutu kapak teknolojisi kullanılır ve gerekli kurulum malzemesiyle birlikte sevk edilir. 2V ak\u0026uuml;ler i\u0026ccedil;in m\u0026uuml;şteri talebi doğrultusunda, \u0026ouml;zel raf sistemi de temin edilebilir. \u0026nbsp;\u003c/p\u003e\n","slug":"vrla-akuler","created_at":"2021-12-23T07:34:32.000000Z","updated_at":"2022-03-28T13:07:02.000000Z","long_description":"\u003cul\u003e\n\t\u003cli\u003eFarklı uygulama alanları ve operasyonel ihtiya\u0026ccedil;lara \u0026ouml;zel tasarım\u003c/li\u003e\n\t\u003cli\u003eVRLA teknolojili, bakım gerektirmeyen, uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml;ne sahip \u0026uuml;r\u0026uuml;nler\u003c/li\u003e\n\t\u003cli\u003eABS kutu ve kapak teknolojisi sayesinde y\u0026uuml;ksek fiziksel dayanım\u003c/li\u003e\n\u003c/ul\u003e\n","group_name":"Endüstriyel Aküler","status_lang":1,"documents":{"id":139,"sector_id":44,"type":"coverWeb","path":"https://cdnd.mutlu.com.tr/sector/crops/_x_/61866-1.png","video_embed":"","created_at":"2021-12-23T08:48:00.000000Z","updated_at":"2021-12-23T08:48:00.000000Z","rank":0,"original_filename":null,"lang":null,"description1":"","description2":""}}]},{"id":54,"group_name":"EFB Aküler","slug":"efb-akuler","items":[{"id":54,"sector_id":28,"lang":"tr","name":"EFB Aküler","slogan":"","short_description":"\u003cp\u003eEFB Ak\u0026uuml;ler; hem karbon emisyon salımını hem de yakıt t\u0026uuml;ketimini en aza indirgemeyi hedef alan otomobil ve ticari ara\u0026ccedil;larda y\u0026uuml;ksek verimlilik sağlayan sulu tip ak\u0026uuml;lerdir. Farklı iklim koşulları ve sıcaklık derecelerinde kullanıma uygun Mutlu EFB Ak\u0026uuml;ler, standart ak\u0026uuml;lere oranla y\u0026uuml;zde 30\u0026rsquo;a kadar daha y\u0026uuml;ksek performans ve iki kata kadar daha uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml;ne sahiptir. Bakım gerektirmeyen \u0026uuml;r\u0026uuml;n teknolojileri, artırılmış elektrolit rezervleri ve tam kapalı sızdırmaz kapak sistemleriyle hem emniyetli hem de uzun \u0026ouml;m\u0026uuml;rl\u0026uuml; kullanım sağlar. Tam \u0026ccedil;er\u0026ccedil;eveli ızgara teknolojisi ile y\u0026uuml;ksek kısa devre dayanımına sahip Mutlu EFB Ak\u0026uuml;ler, d\u0026uuml;ş\u0026uuml;k karbon salımını destekleyen Start-Stop ara\u0026ccedil;lar i\u0026ccedil;in yenilik\u0026ccedil;i ak\u0026uuml; \u0026ccedil;\u0026ouml;z\u0026uuml;mleri barındırırlar.\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eStandart binek ara\u0026ccedil;larda uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml; sunan Mutlu EFB Ak\u0026uuml;ler, Start-Stop teknolojisine sahip binek ara\u0026ccedil;larda da hızlı şarj alma \u0026ouml;zellikleriyle avantajlıdırlar. Y\u0026uuml;ksek titreşim dayanımı g\u0026ouml;steren yapılarıyla zorlu arazi koşullarından kent i\u0026ccedil;i kullanımlara varana kadar farklı alanlarda kullanılan pick up ara\u0026ccedil;lar i\u0026ccedil;in son derece uygundurlar. Y\u0026uuml;k ve kargo taşımacılığında kullanılan panelvan ve minivanlarda ise standart ak\u0026uuml;lere oranla daha y\u0026uuml;ksek performans sunarlar. Minib\u0026uuml;slerde uzun kullanım \u0026ouml;mr\u0026uuml;yle avantaj sağlayan Mutlu EFB Ak\u0026uuml;ler, g\u0026uuml;n\u0026uuml;n \u0026ouml;nemli bir saatini yollarda ge\u0026ccedil;iren ticari taksilere de \u0026uuml;st\u0026uuml;n marş basma g\u0026uuml;c\u0026uuml; sağlar. \u0026nbsp;Mutlu EFB Ak\u0026uuml;ler, bakım gerektirmeyen teknolojileri ve uzun \u0026ccedil;evrim \u0026ouml;m\u0026uuml;rleriyle ara\u0026ccedil;lar dışında soğutucu ekipman ve sistemlerde de tercih edilirler.\u003c/p\u003e\n","slug":"efb-akuler","created_at":"2021-05-16T18:24:20.000000Z","updated_at":"2022-03-17T09:17:19.000000Z","long_description":"\u003cul\u003e\n\t\u003cli\u003eStart-Stop teknolojisine sahip veya y\u0026uuml;ksek enerji ihtiyacı olan standart ara\u0026ccedil;lar i\u0026ccedil;in \u0026ouml;zel tasarım\u003c/li\u003e\n\t\u003cli\u003eEFB teknolojisi sayesinde, standart sulu tip ak\u0026uuml;lere g\u0026ouml;re 2 kat daha uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml; ve y\u0026uuml;ksek şarj alma kapasitesi\u003c/li\u003e\n\t\u003cli\u003eAra\u0026ccedil; \u0026uuml;reticilerinin teknik ve \u0026uuml;st\u0026uuml;n performans beklentilerini karşılayan geniş \u0026uuml;r\u0026uuml;n gamı\u003c/li\u003e\n\u003c/ul\u003e\n","group_name":"EFB Aküler","status_lang":1,"documents":{"id":415,"sector_id":28,"type":"coverWeb","path":"https://cdnd.mutlu.com.tr/sector/crops/_x_/22782.png","video_embed":"","created_at":"2024-10-21T15:11:55.000000Z","updated_at":"2024-10-21T15:11:55.000000Z","rank":0,"original_filename":null,"lang":"tr","description1":"","description2":""}},{"id":66,"sector_id":40,"lang":"tr","name":"EFB Ticari Aküler","slogan":"","short_description":"\u003cp\u003eMutlu EFB Ticari Ak\u0026uuml;ler, Start-Stop \u0026ouml;zelliğine sahip ağır ticari ara\u0026ccedil;lar ve inşaat ekipmanları gibi ağır hizmet ara\u0026ccedil;larında kullanıma uygun, geliştirilmiş sulu tip ak\u0026uuml; teknolojisine sahip ak\u0026uuml;lerdir. Yoğun \u0026ccedil;alışma şartlarında faaliyet g\u0026ouml;steren ticari ara\u0026ccedil;ların ve belli y\u0026uuml;kler altında \u0026ccedil;alışan iş makinelerinin marş ihtiyacını karşılayan EFB Ticari Ak\u0026uuml;ler, motor \u0026ccedil;alışmadığı durumlarda da ara\u0026ccedil;ların ihtiya\u0026ccedil; duyduğu elektrik enerjisini temin eder. G\u0026uuml;\u0026ccedil;lendirilmiş i\u0026ccedil; yapıları sayesinde standart sulu tip ak\u0026uuml;lere g\u0026ouml;re 2 kat daha uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml; sunan EFB Ticari Ak\u0026uuml;ler, hızlı şarj alma \u0026ouml;zelliğine de sahiptir. Merkezi gaz \u0026ccedil;ıkış sistemi ve alev tutucu \u0026ouml;zelliği bulunan sızdırmaz kapak teknolojisi ise EFB Ticari Ak\u0026uuml;ler\u0026rsquo;in \u0026uuml;st\u0026uuml;n g\u0026uuml;venlik \u0026ouml;zellikleri arasında yer alır. EFB Ticari Ak\u0026uuml;ler\u0026rsquo;in tam \u0026ccedil;er\u0026ccedil;eveli ızgara teknolojisi de kısa devre dayanımıyla uzun \u0026ouml;m\u0026uuml;rl\u0026uuml; kullanıma katkı sağlar. İ\u0026ccedil;erisinde yer alan \u0026ouml;zel plak sabitleme sistemi (Hotmelt) sayesinde y\u0026uuml;ksek titreşim dayanım \u0026ouml;zelliği sunan EFB Ticari Ak\u0026uuml;ler, zorlu \u0026ccedil;alışma koşullarına uygundur. Mutlu EFB Ticari Ak\u0026uuml;ler, bakım gerektirmeyen yapıları ve uzun \u0026ouml;m\u0026uuml;rl\u0026uuml; oluşlarıyla da avantajlıdır. Mutlu EFB Ticari Ak\u0026uuml;ler, daha uzun bir kullanım \u0026ouml;mr\u0026uuml; i\u0026ccedil;in Start-Stop \u0026ouml;zelliğine sahip olmayan ticari ara\u0026ccedil;lar ve inşaat ekipmanlarında da kullanılabilmektedir.\u003c/p\u003e\n\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eAra\u0026ccedil; ve ekipman \u0026uuml;reticilerinin teknik ve y\u0026uuml;ksek performans beklentilerini karşılayan Mutlu EFB Ticari Ak\u0026uuml;ler, ağır vasıta ve ağır hizmet ara\u0026ccedil;ları olarak bilinen kamyon, tır, otob\u0026uuml;s ve inşaat ekipmanlarında tercih edilir. EFB Ticari Ak\u0026uuml;ler, lojistik taşımacılıkta kullanılan, yolcu taşımacılığında g\u0026ouml;rev alan ve inşaat sahalarında \u0026ccedil;alışan ara\u0026ccedil;ların enerji gereksinimlerini \u0026uuml;st d\u0026uuml;zeyde karşılar. Uzun kilometreler yapan tır ve kamyon grubu ara\u0026ccedil;larda uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml;yle avantaj sağlayan Mutlu EFB Ticari Ak\u0026uuml;ler, \u0026ccedil;alışma temposunun saatle ve sefer sayısıyla \u0026ouml;l\u0026ccedil;\u0026uuml;ld\u0026uuml;ğ\u0026uuml; inşaat \u0026ndash; hafriyat kamyonlarında da titreşim dayanımlarıyla \u0026ouml;n plana \u0026ccedil;ıkar. Sızdırmaz yapıları, uzun \u0026ouml;m\u0026uuml;r avantajları ve zorlu iklim şartlarındaki performanslarıyla \u0026nbsp;kazıcı y\u0026uuml;kleyici, lastik tekerlekli y\u0026uuml;kleyici, ekskavat\u0026ouml;r, asfalt serici, silindir, dozer ve greyder gibi bir\u0026ccedil;ok iş ve inşaat makinelerinde de tercih edilir. Mutlu EFB Ticari Ak\u0026uuml;ler, şehir i\u0026ccedil;i ve şehirler arası yolculuk hizmeti sunan otob\u0026uuml;slerin de enerji ihtiya\u0026ccedil;larını maksimum seviyede karşılar. Otob\u0026uuml;slerde marş ihtiyacı i\u0026ccedil;in gereken enerjiyi sağlayan Mutlu EFB Ticari Ak\u0026uuml;ler, yolcu koltuğu sırasında bulunan aydınlatma lambaları, tavan lambaları ve koltuk arkalarında yer alan LCD ekran kullanımlarından kaynaklı gereken enerjiyi ara\u0026ccedil;lara kesintisizce sunar.\u003c/p\u003e\n","slug":"efb-ticari-akuler","created_at":"2021-09-13T09:33:11.000000Z","updated_at":"2021-09-13T13:08:48.000000Z","long_description":"\u003cul\u003e\n\t\u003cli\u003eStart-Stop teknolojisine sahip veya y\u0026uuml;ksek enerji ihtiyacı olan standart \u0026ouml;zellikli ticari ara\u0026ccedil;lar i\u0026ccedil;in \u0026ouml;zel tasarım\u003c/li\u003e\n\t\u003cli\u003eEFB teknolojisi sayesinde, standart sulu tip ak\u0026uuml;lere g\u0026ouml;re 2 kat daha uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml;\u003c/li\u003e\n\t\u003cli\u003eMerkezi gaz \u0026ccedil;ıkış sistemi ve alev tutucu \u0026ouml;zelliği ile y\u0026uuml;ksek g\u0026uuml;venlik sağlayan sızdırmaz kapak teknolojisi\u003c/li\u003e\n\u003c/ul\u003e\n","group_name":"EFB Aküler","status_lang":1,"documents":{"id":422,"sector_id":40,"type":"coverWeb","path":"https://cdnd.mutlu.com.tr/sector/crops/_x_/50760.png","video_embed":"","created_at":"2024-10-22T11:49:54.000000Z","updated_at":"2024-10-22T11:49:54.000000Z","rank":0,"original_filename":null,"lang":"tr","description1":"","description2":""}}]},{"id":53,"group_name":"SFB Aküler","slug":"sfb-avrupa-tip-akuler","items":[{"id":53,"sector_id":27,"lang":"tr","name":"SFB Avrupa Tip Aküler","slogan":"","short_description":"\u003cp\u003eMutlu SFB Avrupa Tip Ak\u0026uuml;ler, genellikle Avrupa k\u0026ouml;kenli ara\u0026ccedil;larda kullanılır ve ara\u0026ccedil; motoruna \u0026ccedil;alışması i\u0026ccedil;in gereken g\u0026uuml;c\u0026uuml; sunar. Motor \u0026ccedil;alışmadığı zamanlarda ise ara\u0026ccedil; i\u0026ccedil;i elektriksel donanımların enerji ihtiyacını karşılar. Pick up ara\u0026ccedil;lardan minib\u0026uuml;slere kadar geniş bir kullanım alanına hitap eden SFB Avrupa Tip Ak\u0026uuml;ler, ara\u0026ccedil; \u0026uuml;reticilerinin teknik ve \u0026uuml;st\u0026uuml;n performans beklentilerini karşılayan \u0026ouml;zellikleriyle g\u0026uuml;venilir bir \u0026ccedil;\u0026ouml;z\u0026uuml;m ortağıdır. SFB Avrupa Tip Ak\u0026uuml;ler, standart ak\u0026uuml;lere g\u0026ouml;re %25\u0026rsquo;e kadar daha y\u0026uuml;ksek performansa sahiptir. Patentli kalsiyum (Ca) alaşımlı ızgara teknolojisine sahip olan SFB Avrupa Tip Ak\u0026uuml;ler, tam kapalı kapak sistemleriyle bakım gerektirmeyen yapıdadır. Zorlu iklim şartlarında standart ak\u0026uuml;lere g\u0026ouml;re daha fazla performans sunan SFB Avrupa Tip Ak\u0026uuml;ler, aynı zamanda y\u0026uuml;ksek titreşim dayanımıyla farklı yol koşullarına da uygunluk g\u0026ouml;sterir. Modern bir tasarıma sahip Mutlu SFB Avrupa Tip Ak\u0026uuml;lerde; \u0026ouml;zel kapak i\u0026ccedil;i labirent yapı, alev tutucu filtre, \u0026ouml;zel ergonomik kulp ve ak\u0026uuml; şarj seviyesini g\u0026ouml;steren indikat\u0026ouml;r yer alır.\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eMutlu SFB Avrupa Tip Ak\u0026uuml;ler, Start-Stop \u0026ouml;zelliği olmayan standart binek ara\u0026ccedil;larda bakım gerektirmeyen ve uzun \u0026ouml;m\u0026uuml;rl\u0026uuml; \u0026uuml;r\u0026uuml;n teknolojisiyle kullanıma uygundur. Pick up ara\u0026ccedil;ların yoğun olarak kullanıldığı engebeli araziler ve kent kullanımları gibi değişken yol koşullarında titreşim dayanımları ve \u0026uuml;st\u0026uuml;n performanslarıyla beklentileri karşılarlar. İla\u0026ccedil; taşımacılığından gıdaya, soğuk zincir taşımacılığından kargo hizmetlerine kadar bir\u0026ccedil;ok iş kolunda kullanılan panelvan ve minivan ara\u0026ccedil;larda ise uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml; ile kesintisiz \u0026ccedil;alışmalara imkan verirler. Mutlu SFB Avrupa Tip Ak\u0026uuml;ler, kamyonetlerde de zorlu iklim ve yol şartlarında y\u0026uuml;ksek performans ve dayanıklılık sunarlar. Tam kapalı kapak sistemine sahip Mutlu SFB Avrupa Tip Ak\u0026uuml;ler; g\u0026uuml;n i\u0026ccedil;erisinde kesintisiz \u0026ccedil;alışan ve yolcu taşımacılığı yapan hatlı minib\u0026uuml;s, \u0026ouml;ğrenci ve personel minib\u0026uuml;s\u0026uuml;, VIP minib\u0026uuml;s gibi ara\u0026ccedil;larda da yaygın şekilde kullanılırlar. Otomotiv sekt\u0026ouml;r\u0026uuml; dışında da g\u0026uuml;\u0026ccedil; kaynakları olan jenerat\u0026ouml;rlerde kullanılan Mutlu SFB Avrupa Tip Ak\u0026uuml;ler, jenerat\u0026ouml;r motorlarının d\u0026uuml;zenli işleyişi i\u0026ccedil;in gereken enerjiyi temin ederler.\u003c/p\u003e\n","slug":"sfb-avrupa-tip-akuler","created_at":"2021-05-16T18:24:11.000000Z","updated_at":"2022-01-12T09:20:41.000000Z","long_description":"\u003cul\u003e\n\t\u003cli\u003eAvrupa k\u0026ouml;kenli standart \u0026ouml;zellikli ara\u0026ccedil;ların elektriksel gereksinimlerini karşılamak \u0026uuml;zere geliştirilmiş, uzun \u0026ouml;m\u0026uuml;rl\u0026uuml; \u0026uuml;r\u0026uuml;n teknolojisi\u003c/li\u003e\n\t\u003cli\u003eZorlu iklim koşullarında ihtiya\u0026ccedil; duyulan y\u0026uuml;ksek marş g\u0026uuml;c\u0026uuml;\u003c/li\u003e\n\t\u003cli\u003eAra\u0026ccedil; \u0026uuml;reticilerinin teknik ve \u0026uuml;st\u0026uuml;n performans beklentilerini karşılayan geniş \u0026uuml;r\u0026uuml;n gamı\u003c/li\u003e\n\u003c/ul\u003e\n","group_name":"SFB Aküler","status_lang":1,"documents":{"id":413,"sector_id":27,"type":"coverWeb","path":"https://cdnd.mutlu.com.tr/sector/crops/_x_/14274.png","video_embed":"","created_at":"2024-10-21T13:48:49.000000Z","updated_at":"2024-10-21T13:48:49.000000Z","rank":0,"original_filename":null,"lang":"tr","description1":"","description2":""}},{"id":52,"sector_id":26,"lang":"tr","name":"SFB Japon Tip Aküler","slogan":"","short_description":"\u003cp\u003eMutlu SFB Japon Tip Ak\u0026uuml;ler, genellikle Asya k\u0026ouml;kenli ara\u0026ccedil;larda kullanılır ve ara\u0026ccedil; motoruna \u0026ccedil;alışması i\u0026ccedil;in gereken g\u0026uuml;c\u0026uuml; sunarlar. Motor \u0026ccedil;alışmadığı zamanlarda ise ara\u0026ccedil; i\u0026ccedil;i elektriksel donanımların enerji ihtiyacını karşılarlar. Standart \u0026ouml;zellikli binek ara\u0026ccedil;lardan, pick up, panelvan ve minib\u0026uuml;slere kadar geniş bir kullanım alanında tercih edilen SFB Japon Tip Ak\u0026uuml;ler, ara\u0026ccedil; \u0026uuml;reticilerinin teknik ve \u0026uuml;st\u0026uuml;n performans beklentilerini karşılayan \u0026ouml;zellikleriyle g\u0026uuml;venilir \u0026ccedil;\u0026ouml;z\u0026uuml;m ortağıdır. Mutlu SFB Japon Tip Ak\u0026uuml;ler, tam kapalı kapak sistemi ve bakım gerektirmeyen \u0026uuml;r\u0026uuml;n teknolojileriyle kullanım kolaylığı sağlar. Zorlu iklim şartlarında standart ak\u0026uuml;lere g\u0026ouml;re daha fazla performans sunan SFB Japon Tip Ak\u0026uuml;ler, aynı zamanda y\u0026uuml;ksek titreşim dayanımıyla farklı yol koşullarında sorunsuzca kullanılabilmektedirler. Standart ak\u0026uuml;lere g\u0026ouml;re %25\u0026rsquo;e kadar daha y\u0026uuml;ksek performansa sahip Mutlu SFB Japon Tip Ak\u0026uuml;lerde; \u0026ouml;zel kapak i\u0026ccedil;i labirent yapı, alev tutucu filtre, \u0026ouml;zel ergonomik kulp ve ak\u0026uuml; şarj seviyesini g\u0026ouml;steren indikat\u0026ouml;r yer alır. \u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eMutlu SFB Japon Tip Ak\u0026uuml;ler, Start-Stop \u0026ouml;zelliği olmayan standart binek ara\u0026ccedil;ların yoğun enerji ihtiya\u0026ccedil;larını karşılar. Y\u0026uuml;ksek titreşim dayanımı ve marş basma g\u0026uuml;c\u0026uuml;yle de pick up ara\u0026ccedil;larda kullanım i\u0026ccedil;in uygundur. Bir\u0026ccedil;ok iş kolunda kullanılan panelvan ve minivan ara\u0026ccedil;larda ise uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml; ile kullanıcı dostudur. Mutlu SFB Japon Tip Ak\u0026uuml;ler, kamyonetlerde de \u0026uuml;st\u0026uuml;n performans sağlar. \u0026nbsp;Yoğun \u0026ccedil;alışma saatleri ve y\u0026uuml;ksek enerji gereksinimleri olan minib\u0026uuml;sler i\u0026ccedil;in de uzun \u0026ouml;m\u0026uuml;rl\u0026uuml; Mutlu SFB Japon Tip Ak\u0026uuml;ler tercih edilir. Mutlu SFB Japon Tip Ak\u0026uuml;lerin diğer bir kullanım alanı da jenerat\u0026ouml;rlerdir.\u003c/p\u003e\n","slug":"sfb-japon-tip-akuler","created_at":"2021-05-16T18:23:55.000000Z","updated_at":"2023-12-13T07:41:07.000000Z","long_description":"\u003cul\u003e\n\t\u003cli\u003eAsya k\u0026ouml;kenli standart \u0026ouml;zellikli ara\u0026ccedil;ların elektriksel gereksinimlerini karşılamak \u0026uuml;zere geliştirilmiş, uzun \u0026ouml;m\u0026uuml;rl\u0026uuml; \u0026uuml;r\u0026uuml;n teknolojisi\u003c/li\u003e\n\t\u003cli\u003eZorlu iklim koşullarında ihtiya\u0026ccedil; duyulan y\u0026uuml;ksek marş g\u0026uuml;c\u0026uuml;\u003c/li\u003e\n\t\u003cli\u003eAra\u0026ccedil; \u0026uuml;reticilerinin teknik ve \u0026uuml;st\u0026uuml;n performans beklentilerini karşılayan geniş \u0026uuml;r\u0026uuml;n gamı\u003c/li\u003e\n\u003c/ul\u003e\n","group_name":"SFB Aküler","status_lang":1,"documents":{"id":411,"sector_id":26,"type":"coverWeb","path":"https://cdnd.mutlu.com.tr/sector/crops/_x_/63835.png","video_embed":"","created_at":"2024-10-21T12:11:49.000000Z","updated_at":"2024-10-21T12:11:49.000000Z","rank":0,"original_filename":null,"lang":"tr","description1":"","description2":""}},{"id":61,"sector_id":35,"lang":"tr","name":"SFB Marin Aküler","slogan":"","short_description":"\u003cp\u003eMutlu SFB Marin Ak\u0026uuml;ler; \u0026uuml;st\u0026uuml;n performanslarıyla deniz yolu ulaşım ara\u0026ccedil;larının enerji ihtiya\u0026ccedil;larını karşılamak \u0026uuml;zere sulu tip ak\u0026uuml; teknolojisiyle tasarlanmıştır. SFB Marin Ak\u0026uuml;ler, tekne ve yat gibi ara\u0026ccedil;larda motorun ihtiyacı olan marş basma g\u0026uuml;c\u0026uuml;n\u0026uuml; karşılar. Aynı zamanda marin tipi ara\u0026ccedil;larda yer alan bazı elektriksel cihaz ve donanımların ihtiya\u0026ccedil; duyduğu enerjinin temin edilmesini sağlar. Merkezi gaz \u0026ccedil;ıkış sistemine ve alev tutucu filtreye sahip kapak teknolojisi ile y\u0026uuml;ksek g\u0026uuml;venlik sunar. SFB teknolojisine \u0026ouml;zel geliştirilmiş ızgara yapısı, aktif maddesi ve \u0026ouml;zel elyaﬂı seperat\u0026ouml;rleri bulunmaktadır. SFB Marin Ak\u0026uuml;ler patentli yeni tasarım ergonomik taşıma kulbu ile koruma kapağına ve bakım gerektirmeyen \u0026uuml;r\u0026uuml;n teknolojisine sahiptir. Yanmayı geciktirici plastik malzemeden \u0026uuml;retilen SFB Marin Ak\u0026uuml;ler, T\u0026uuml;rk Loydu sertifikasıyla belgelendirilmiştir.\u003c/p\u003e\n\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eMutlu Ak\u0026uuml;\u0026rsquo;n\u0026uuml;n SFB Marin Ak\u0026uuml;leri, \u0026nbsp;standart ak\u0026uuml;lere g\u0026ouml;re daha y\u0026uuml;ksek \u0026ccedil;evrim \u0026ouml;mr\u0026uuml;yle maliyet avantajı sağlar. SFB Marin Ak\u0026uuml;lerin g\u0026uuml;\u0026ccedil;l\u0026uuml; i\u0026ccedil; yapıları, uzun \u0026ouml;m\u0026uuml;rle birlikte y\u0026uuml;ksek kısa devre dayanımını da sağlar. Deniz ortamında sık\u0026ccedil;a yaşanan nemli ve r\u0026uuml;zgarlı koşullarda dayanımını koruyan SFB Marin Ak\u0026uuml;ler, y\u0026uuml;ksek sıcaklıklarda da yapısını muhafaza eder. Ayrıca uzun zamanlar devam eden sarsıntılara ve titreşimlere karşı y\u0026uuml;ksek diren\u0026ccedil; sunması, SFB Marin Ak\u0026uuml;lerin \u0026ouml;ne \u0026ccedil;ıkan \u0026ouml;zelliklerindendir. 55 derece eğime kadar elektroliti muhafaza eden yapısıyla da, dalgalaların yaşandığı seyahatlerde g\u0026uuml;venli bir kullanım sunar.\u0026nbsp;\u003c/p\u003e\n","slug":"sfb-marin-akuler","created_at":"2021-05-16T18:25:25.000000Z","updated_at":"2021-08-16T08:00:05.000000Z","long_description":"\u003cul\u003e\n\t\u003cli\u003eDeniz yolu ulaşım ara\u0026ccedil;ları i\u0026ccedil;in \u0026ouml;zel olarak geliştirilmiş, T\u0026uuml;rk Loydu sertifikalı, sulu tip ak\u0026uuml; teknolojisi\u003c/li\u003e\n\t\u003cli\u003eMerkezi gaz \u0026ccedil;ıkış sistemli ve alev tutucu \u0026ouml;zelliğe sahip sızdırmaz kapak teknolojisiyle y\u0026uuml;ksek g\u0026uuml;venlik\u003c/li\u003e\n\t\u003cli\u003eG\u0026uuml;\u0026ccedil;lendirilmiş i\u0026ccedil; yapısı sayesinde standart ak\u0026uuml;lere g\u0026ouml;re daha uzun \u0026ouml;m\u0026uuml;r\u003c/li\u003e\n\u003c/ul\u003e\n","group_name":"SFB Aküler","status_lang":1,"documents":{"id":425,"sector_id":35,"type":"coverWeb","path":"https://cdnd.mutlu.com.tr/sector/crops/_x_/11884.png","video_embed":"","created_at":"2024-10-22T13:02:53.000000Z","updated_at":"2024-10-22T13:02:53.000000Z","rank":0,"original_filename":null,"lang":"tr","description1":"","description2":""}},{"id":56,"sector_id":30,"lang":"tr","name":"SFB Seri 1 HD Aküler","slogan":"","short_description":"\u003cp\u003eMutlu SFB Seri 1 Ağır Hizmet (HD) Ak\u0026uuml;ler; ağır ticari ara\u0026ccedil;lar, kamyonetler, minib\u0026uuml;sler, tarım ekipmanları, inşaat ara\u0026ccedil;ları ve jenerat\u0026ouml;rlerde kullanıma uygun olan, SLI teknolojisine sahip ak\u0026uuml;lerdir. Motorların \u0026ccedil;alışması i\u0026ccedil;in gereken marş g\u0026uuml;c\u0026uuml;n\u0026uuml; karşılayan SFB Seri 1 HD Ak\u0026uuml;ler, motor \u0026ccedil;alışmazken de ara\u0026ccedil; donanımları ve ekipmanların elektriksel ihtiya\u0026ccedil;larını temin eder. Patentli, kalsiyum (Ca) alaşımlı ızgara teknolojisine sahip olan SFB Seri 1 HD Ak\u0026uuml;ler, bu sayede bakım gerektirmeyen yapıdadır. \u0026nbsp;\u0026Ouml;zel tasarım ızgaraları ve aşınmayı \u0026ouml;nleyici korozyon diren\u0026ccedil;leriyle daha fazla dayanıklılık sunarlar. \u0026Ouml;zel plak sabitleme sistemi (Hotmelt) sayesinde y\u0026uuml;ksek vibrasyon dayanımı \u0026ouml;zelliği g\u0026ouml;sterirken, ağır hizmet tipi ara\u0026ccedil;ların ve ekipmanların faaliyet g\u0026ouml;sterdiği zorlu \u0026ccedil;alışma ve iklim koşullarına uyumludur. Sızdırmaz kapak teknolojisi, merkezi gaz \u0026ccedil;ıkış sistemi ve alev tutucu \u0026ouml;zelliği ile y\u0026uuml;ksek g\u0026uuml;venliklidir. SFB Seri 1 HD Ak\u0026uuml;ler; \u0026nbsp;minimum deşarj \u0026ouml;zelliği ve uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml; sayesinde, ara\u0026ccedil;ların kesintisiz \u0026ccedil;alışmasına katkı sağlarlar.\u003c/p\u003e\n\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eAra\u0026ccedil; \u0026uuml;reticilerinin teknik ve \u0026uuml;st\u0026uuml;n performans beklentilerini karşılayan Mutlu SFB Seri 1 HD Ak\u0026uuml;ler; ağır hizmet grubu altında geniş bir yelpazeye y\u0026ouml;nelik \u0026ccedil;\u0026ouml;z\u0026uuml;mler sunar. Bu \u0026ccedil;\u0026ouml;z\u0026uuml;mlerden biri, dağıtım ve evden eve nakliyat gibi ağırlıklı olarak kent i\u0026ccedil;inde hizmet veren kamyonetler i\u0026ccedil;in gereken enerjiyi sağlamaktır. SFB Seri 1 HD Ak\u0026uuml;ler; personel ve okul servisi, şehir i\u0026ccedil;i yolcu taşımacılığı ve VIP hizmet sunan minib\u0026uuml;slerde de bakım gerektirmeyen yapısıyla kullanıma uygundur. \u0026nbsp;Ağır y\u0026uuml;klerle yapılan uzun yolculuklarda, uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml; ve minimum deşarj \u0026ouml;zelliğiyle kamyon ve tır kullanıcılarının da tercih sebebidir. \u0026nbsp;İnşaat sahaları, mermer ve maden ocakları gibi alanlarda faaliyet g\u0026ouml;steren iş makinesi ve ekipmanların ihtiyacı olan enerjiyi sağlar. \u0026nbsp;SFB Seri 1 HD Ak\u0026uuml;ler, \u0026nbsp;tarım arazilerinde trakt\u0026ouml;r ve \u0026ccedil;eşitli zirai ara\u0026ccedil;larda kullanılarak y\u0026uuml;ksek vibrasyon dayanımıyla avantaj sağlar. G\u0026uuml;venlikli yapısıyla, elektrik kesintilerinde devreye giren jenerat\u0026ouml;rler i\u0026ccedil;in de kullanıma uygundur.\u0026nbsp;\u003c/p\u003e\n","slug":"sfb-seri-1-hd-akuler","created_at":"2021-05-16T18:24:38.000000Z","updated_at":"2021-08-16T07:58:56.000000Z","long_description":"\u003cul\u003e\n\t\u003cli\u003eZorlu \u0026ccedil;alışma ve iklim koşullarında kullanıma uygun, bakım gerektirmeyen \u0026uuml;r\u0026uuml;n teknolojisi\u003c/li\u003e\n\t\u003cli\u003eLabirent tip buşonlu, g\u0026uuml;venli kapak yapısı\u003c/li\u003e\n\t\u003cli\u003eAra\u0026ccedil; \u0026uuml;reticilerinin teknik ve \u0026uuml;st\u0026uuml;n performans beklentilerini karşılayan geniş \u0026uuml;r\u0026uuml;n gamı\u003c/li\u003e\n\u003c/ul\u003e\n","group_name":"SFB Aküler","status_lang":1,"documents":{"id":429,"sector_id":30,"type":"coverWeb","path":"https://cdnd.mutlu.com.tr/sector/crops/_x_/63308.png","video_embed":"","created_at":"2024-10-22T13:20:35.000000Z","updated_at":"2024-10-22T13:20:35.000000Z","rank":0,"original_filename":null,"lang":"tr","description1":"","description2":""}},{"id":57,"sector_id":31,"lang":"tr","name":"SFB Seri 1 SHD Aküler","slogan":"","short_description":"\u003cp\u003eMutlu SFB Seri 1 S\u0026uuml;per Ağır Hizmet (SHD) Ak\u0026uuml;ler, ağır ticari ara\u0026ccedil;larda kullanıma uygun, SLI teknolojisine sahip ak\u0026uuml;lerdir. Yoğun mesai şartları altında \u0026ccedil;alışan ağır vasıtaların marş ihtiyacını karşılayan SFB Seri 1 SHD Ak\u0026uuml;ler, ara\u0026ccedil; motorunun \u0026ccedil;alışmadığı durumlarda da ihtiya\u0026ccedil; duyulan elektrik enerjisini sağlar. Mutlu SFB Seri 1 SHD Ak\u0026uuml;ler; \u0026ouml;zel tasarım ızgaraları, g\u0026uuml;\u0026ccedil;l\u0026uuml; seperat\u0026ouml;rleri ve aşınmayı \u0026ouml;nleyen korozyon diren\u0026ccedil;leri sayesinde artırılmış dayanıklılık sunar. İ\u0026ccedil;erisinde kullanılan \u0026ouml;zel plak sabitleme sistemi (Hotmelt) sayesinde ise vibrasyon dayanımı \u0026uuml;st d\u0026uuml;zeye \u0026ccedil;ıkartılmıştır. Zorlu ve uzun \u0026ccedil;alışma şartlarında, sağlam tasarımı ve y\u0026uuml;ksek titreşim dayanımı sayesinde g\u0026uuml;venle kullanılan Mutlu SFB Seri 1 SHD Ak\u0026uuml;ler, patentli kalsiyum alaşımlı ızgara yapılarıyla da bakım gerektirmeyen \u0026ouml;zellikte olup uygun kullanım koşulları sağlandığında ekstra bakım hizmetine ihtiya\u0026ccedil; duymamaktadırlar. SFB teknolojisiyle uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml; ve minimum deşarj \u0026ouml;zelliğine sahiptirler.\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eAra\u0026ccedil; \u0026uuml;reticilerinin teknik ve \u0026uuml;st\u0026uuml;n performans beklentilerini karşılayan Mutlu SFB Seri 1 SHD Ak\u0026uuml;ler, ağır vasıtalar arasında yer alan kamyon, tır, otob\u0026uuml;s ve inşaat ekipmanlarında kullanılır. \u0026nbsp;Lojistik taşımacılık alanında ve inşaat sahalarında g\u0026ouml;rev yapan kamyon ve tırların beklentilerini \u0026uuml;st d\u0026uuml;zeyde karşılayan SFB Seri 1 SHD Ak\u0026uuml;ler; şehirler arası ve uluslar arası taşımacılıkta uzun kilometreler yapan tır / kamyon grubuna, uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml; ve y\u0026uuml;ksek performans sunar. Tozlu inşaat sahalarında \u0026ccedil;alışan kamyonlarda da maksimum dayanım ve \u0026uuml;st\u0026uuml;n vibrasyon direnciyle katkı sağlar. SFB Seri 1 SHD Ak\u0026uuml;ler, hem şehir i\u0026ccedil;i hem de şehirler arası yolculuk hizmeti veren otob\u0026uuml;s gruplarında y\u0026uuml;ksek performansıyla tercih edilir. \u0026nbsp;\u0026Ouml;zellikle her yolcu koltuğu sırasında bulunan aydınlatma lambaları ve koltuk arkalarında yer alan LCD ekran kullanımlarından dolayı ara\u0026ccedil;lardaki y\u0026uuml;ksek elektrik enerjisi ihtiya\u0026ccedil;larına cevap verir. \u0026nbsp;Gerek hafriyat sahalarında gerek maden ve mermer sahalarında, en zorlu şartlarda \u0026ccedil;alışan iş makineleri ve inşaat ekipmanlarında da SFB Seri 1 SHD Ak\u0026uuml;ler kullanılır. Sızdırmaz yapısı ve vibrasyon dayanımıyla kazıcı y\u0026uuml;kleyici, lastik tekerlekli y\u0026uuml;kleyici, ekskavat\u0026ouml;r, silindir ve greyder gibi bir\u0026ccedil;ok iş ve inşaat makinelerinde avantaj sağlayan SFB Seri 1 SHD Ak\u0026uuml;ler, y\u0026uuml;ksek ısılara dayanımıyla da standart ak\u0026uuml;lere g\u0026ouml;re daha \u0026uuml;st\u0026uuml;nd\u0026uuml;r.\u0026nbsp;\u003c/p\u003e\n","slug":"sfb-seri-1-shd-akuler","created_at":"2021-05-16T18:24:49.000000Z","updated_at":"2021-08-16T07:59:15.000000Z","long_description":"\u003cul\u003e\n\t\u003cli\u003eZorlu iklim koşullarında kullanıma uygun, uzun \u0026ouml;m\u0026uuml;rl\u0026uuml; ve bakım gerektirmeyen \u0026uuml;r\u0026uuml;n teknolojisi\u003c/li\u003e\n\t\u003cli\u003eLabirent tip buşonlu, g\u0026uuml;venli kapak yapısı\u003c/li\u003e\n\t\u003cli\u003eY\u0026uuml;ksek titreşim direnciyle zorlu \u0026ccedil;alışma şartlarında kullanıma uygun, dayanıklı \u0026uuml;r\u0026uuml;n grubu\u003c/li\u003e\n\t\u003cli\u003eAra\u0026ccedil; \u0026uuml;reticilerinin teknik ve \u0026uuml;st\u0026uuml;n performans beklentilerini karşılayan geniş \u0026uuml;r\u0026uuml;n gamı\u003c/li\u003e\n\u003c/ul\u003e\n","group_name":"SFB Aküler","status_lang":1,"documents":{"id":428,"sector_id":31,"type":"coverWeb","path":"https://cdnd.mutlu.com.tr/sector/crops/_x_/22737.png","video_embed":"","created_at":"2024-10-22T13:09:43.000000Z","updated_at":"2024-10-22T13:09:43.000000Z","rank":0,"original_filename":null,"lang":"tr","description1":"","description2":""}},{"id":58,"sector_id":32,"lang":"tr","name":"SFB Seri 2 HD Aküler","slogan":"","short_description":"\u003cp\u003eMutlu SFB Seri 2 Ağır Hizmet (HD) Ak\u0026uuml;ler; ticari ve ağır ticari ara\u0026ccedil;ların enerji ihiya\u0026ccedil;larını performanslı bir şekilde karşılamak \u0026uuml;zere SLI teknolojisiyle geliştirilmiştir. Motorlar i\u0026ccedil;in gereken y\u0026uuml;ksek marş basma g\u0026uuml;c\u0026uuml;n\u0026uuml; sunan SFB Seri 2 HD ak\u0026uuml;ler, aynı zamanda g\u0026uuml;n\u0026uuml;m\u0026uuml;zde elektronik donanımları daha da artan ticari ara\u0026ccedil;ların ihtiya\u0026ccedil; duyduğu enerjiyi karşılar. Patentli, kalsiyum (Ca) alaşımlı ızgara yapısıyla bakım gerektirmeyen \u0026ouml;zellikte olup uygun kullanım koşullarında ekstra bakım hizmetine de ihtiya\u0026ccedil; duymaz. Y\u0026uuml;ksek titreşim dayanımı sayesinde zorlu \u0026ccedil;alışma şartlarında g\u0026uuml;venli kullanıma sahiptir. Ak\u0026uuml;lerin titreşim dayanımı; i\u0026ccedil; yapısındaki Hotmelt adı verilen \u0026ouml;zel plak sabitleme sistemi ile sağlanır. SFB Seri 2 HD Ak\u0026uuml;ler, standart ak\u0026uuml;lere oranla daha y\u0026uuml;ksek \u0026ccedil;evrim \u0026ouml;mr\u0026uuml;ne sahip olmasıyla maliyet a\u0026ccedil;ısından avantajlıdır. Ticari ara\u0026ccedil;lar i\u0026ccedil;in en y\u0026uuml;ksek motor \u0026ccedil;alıştırma g\u0026uuml;c\u0026uuml;n\u0026uuml; sağlayarak, ilk g\u0026uuml;nden itibaren zorlu iklim ve \u0026ccedil;alışma şartlarında standart ak\u0026uuml;lere oranla daha \u0026uuml;st\u0026uuml;n performans sunar.\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eMutlu SFB Seri 2 HD Ak\u0026uuml;ler, ticari ara\u0026ccedil;lar, tarım ve inşaat ekipmanları ile jenerat\u0026ouml;rlerde kullanılır. Kent i\u0026ccedil;i dağıtım ve nakliye hizmetleri sunan, vin\u0026ccedil; gibi donanımlarla operasyon ger\u0026ccedil;ekleştirilebilen kamyonetlerde SFB Seri 2 HD Ak\u0026uuml;ler \u0026uuml;st d\u0026uuml;zey performansla \u0026ccedil;alışır. SFB Seri 2 HD Ak\u0026uuml;ler, g\u0026uuml;n i\u0026ccedil;inde elektronik ekipmanların yoğun olarak kullanıldığı minib\u0026uuml;slerde de y\u0026uuml;ksek marş basma kapasitesi sunar. Başta klima ve aydınlatma olmak \u0026uuml;zere bir\u0026ccedil;ok i\u0026ccedil; donanımın park halindeyken de yaygın olarak kullanıldığı tır ve kamyonlarda, SFB Seri 2 HD Ak\u0026uuml;ler uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml;yle avantaj sağlar. Değişken iklim koşullarında operasyon yapan uzun yol ve inşaat kamyonlarında y\u0026uuml;ksek dayanım g\u0026ouml;sterir. Zorlu şantiye sahaları ile mermer ve maden ocaklarında kullanılan iş makinelerinde ise SFB Seri 2 HD Ak\u0026uuml;ler, \u0026uuml;st\u0026uuml;n titreşim dayanımı ve g\u0026uuml;venlik \u0026ouml;zellikleriyle \u0026ouml;ne \u0026ccedil;ıkar. SFB Seri 2 HD Ak\u0026uuml;ler, \u0026uuml;st\u0026uuml;n marş basma kapasitesi ve bakım gerektirmeyen teknolojisiyle tarım arazilerinde, trakt\u0026ouml;rler ve zirai ara\u0026ccedil;larda kullanılır. SFB Seri 2 HD Ak\u0026uuml;ler ayrıca ev, iş yerleri ve end\u0026uuml;striyel sahalarda yaygın olarak kullanılan jenerat\u0026ouml;rlerin ihtiya\u0026ccedil; duyduğu elektrik enerjisini de temin eder.\u0026nbsp;\u003c/p\u003e\n","slug":"sfb-seri-2-hd-akuler","created_at":"2021-05-16T18:24:58.000000Z","updated_at":"2021-08-16T07:59:30.000000Z","long_description":"\u003cul\u003e\n\t\u003cli\u003eZorlu \u0026ccedil;alışma ve iklim koşullarında kullanıma uygun, bakım gerektirmeyen \u0026uuml;r\u0026uuml;n teknolojisi\u003c/li\u003e\n\t\u003cli\u003eMerkezi gaz \u0026ccedil;ıkış sistemi ve alev tutucu \u0026ouml;zelliğiyle y\u0026uuml;ksek g\u0026uuml;venlik sağlayan sızdırmaz kapak yapısı\u003c/li\u003e\n\t\u003cli\u003eAra\u0026ccedil; \u0026uuml;reticilerinin teknik ve \u0026uuml;st\u0026uuml;n performans beklentilerini karşılayan geniş \u0026uuml;r\u0026uuml;n gamı\u003c/li\u003e\n\u003c/ul\u003e\n","group_name":"SFB Aküler","status_lang":1,"documents":{"id":423,"sector_id":32,"type":"coverWeb","path":"https://cdnd.mutlu.com.tr/sector/crops/_x_/37799.png","video_embed":"","created_at":"2024-10-22T13:00:47.000000Z","updated_at":"2024-10-22T13:00:47.000000Z","rank":0,"original_filename":null,"lang":"tr","description1":"","description2":""}},{"id":59,"sector_id":33,"lang":"tr","name":"SFB Seri 3 SHD Aküler","slogan":"","short_description":"\u003cp\u003eMutlu SFB Seri 3 S\u0026uuml;per Ağır Hizmet (SHD) Ak\u0026uuml;ler, ağır ticari ara\u0026ccedil;larda kullanıma uygun, değişen enerji ihtiya\u0026ccedil;larına g\u0026ouml;re geliştirilmiş ve SLI teknolojisine sahip ak\u0026uuml;lerdir. Yoğun ve g\u0026uuml;\u0026ccedil; şartlar altında \u0026ccedil;alışan kamyon, tır, otob\u0026uuml;s ve inşaat ekipmanlarının ihtiyacı olan marş g\u0026uuml;c\u0026uuml;n\u0026uuml; sunar. Ayrıca motor kapalı konumdayken gereken elektrik enerjisini de karşılar. SFB Seri 3 SHD Ak\u0026uuml;ler, ağır ticari ara\u0026ccedil;lar i\u0026ccedil;in her t\u0026uuml;r zorlu iklim ve \u0026ccedil;alışma koşulunda gerekli motor \u0026ccedil;alıştırma performansını sağlar. Standart ak\u0026uuml;lere g\u0026ouml;re daha y\u0026uuml;ksek \u0026ccedil;evrim \u0026ouml;mr\u0026uuml; sunan SFB Seri 3 SHD Ak\u0026uuml;ler, bu sayede maliyet avantajlıdır. G\u0026uuml;\u0026ccedil;l\u0026uuml; i\u0026ccedil; yapısı (d\u0026ouml;k\u0026uuml;m teknolojili ızgaralar ve cam elyaflı seperat\u0026ouml;rler) ile \u0026uuml;st\u0026uuml;n \u0026ouml;m\u0026uuml;r dayanımı ve dayanıklılığa sahiptir. Bakım gerektirmeyen yapısı ve y\u0026uuml;ksek titreşim direnci ile aralıksız \u0026ccedil;alışma koşullarına uyum g\u0026ouml;sterir.\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eMutlu Ak\u0026uuml;\u0026rsquo;n\u0026uuml;n s\u0026uuml;per ağır hizmet grubunda sunduğu SFB Seri 3 SHD Ak\u0026uuml;ler; yurt i\u0026ccedil;i ve yurt dışı nakliye ağlarında faaliyet g\u0026ouml;steren ve inşaat sahalarında zorlu \u0026ccedil;alışmalara imza atan kamyon ve tır gruplarının enerji ihtiya\u0026ccedil;larını karşılar. Uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml; ve dayanıklılığıyla avantaj sağlar. Ayrıca \u0026ccedil;\u0026ouml;p kamyonu, itfaiye, ağır tonaj vin\u0026ccedil; ve vidanj\u0026ouml;r uygulamalı kamyonlarda da y\u0026uuml;ksek marş basma g\u0026uuml;c\u0026uuml;yle \u0026ccedil;alışır. SFB Seri 3 SHD Ak\u0026uuml;ler otob\u0026uuml;slerde ise, \u0026nbsp;gerek kent i\u0026ccedil;i tarifeli gerek turizm ama\u0026ccedil;lı seyahatlerde y\u0026uuml;ksek performansla marş basma ve elektriksel donanım ihtiya\u0026ccedil;larına cevap verir. \u0026Ouml;zellikle aydınlatmalar ve LCD ekranlarla dolu seyahat otob\u0026uuml;slerinde tam performans g\u0026ouml;sterir. Aynı zamanda SFB Seri 3 SHD Ak\u0026uuml;ler; hafriyat sahaları, mermer ocakları, madenler, taş ocakları gibi alanlarda \u0026ccedil;alışan iş ve inşaat makinelerinin ihtiya\u0026ccedil; duyduğu enerjiyi temin eder. Sızdırmaz yapısı ve titreşim dayanımıyla kazıcı y\u0026uuml;kleyici, lastik tekerlekli y\u0026uuml;kleyici, ekskavat\u0026ouml;r, silindir ve greyder gibi bir\u0026ccedil;ok iş ve inşaat makinelerinde g\u0026uuml;venle kullanılabilir.\u0026nbsp;\u003c/p\u003e\n","slug":"sfb-seri-3-shd-akuler","created_at":"2021-05-16T18:25:08.000000Z","updated_at":"2021-08-16T07:59:41.000000Z","long_description":"\u003cul\u003e\n\t\u003cli\u003eZorlu iklim koşullarında kullanıma uygun, uzun \u0026ouml;m\u0026uuml;rl\u0026uuml; ve bakım gerektirmeyen \u0026uuml;r\u0026uuml;n teknolojisi\u003c/li\u003e\n\t\u003cli\u003eMerkezi gaz \u0026ccedil;ıkış sistemi ve alev tutucu \u0026ouml;zelliğiyle y\u0026uuml;ksek g\u0026uuml;venlik sağlayan sızdırmaz kapak yapısı\u003c/li\u003e\n\t\u003cli\u003eY\u0026uuml;ksek titreşim direnciyle zorlu \u0026ccedil;alışma şartlarında kullanıma uygun, dayanıklı \u0026uuml;r\u0026uuml;n teknolojisi\u003c/li\u003e\n\t\u003cli\u003eAra\u0026ccedil; \u0026uuml;reticilerinin teknik ve \u0026uuml;st\u0026uuml;n performans beklentilerini karşılayan geniş \u0026uuml;r\u0026uuml;n gamı\u003c/li\u003e\n\u003c/ul\u003e\n","group_name":"SFB Aküler","status_lang":1,"documents":{"id":424,"sector_id":33,"type":"coverWeb","path":"https://cdnd.mutlu.com.tr/sector/crops/_x_/91283.png","video_embed":"","created_at":"2024-10-22T13:01:55.000000Z","updated_at":"2024-10-22T13:01:55.000000Z","rank":0,"original_filename":null,"lang":"tr","description1":"","description2":""}},{"id":55,"sector_id":29,"lang":"tr","name":"SFB Taksi Aküleri","slogan":"","short_description":"\u003cp\u003eMutlu SFB Taksi Ak\u0026uuml;leri t\u0026uuml;m iklim ve trafik koşullarında taksinin yolcusunu gideceği noktaya kadar sorunsuz bir şekilde ulaştırması i\u0026ccedil;in gereken elektriksel enerjiyi sağlar. Bir taksinin g\u0026uuml;n i\u0026ccedil;erisinde kat ettiği mesafe ve ara\u0026ccedil; motorunu \u0026ccedil;alıştırma sayısı, diğer ara\u0026ccedil;lara g\u0026ouml;re \u0026ccedil;ok daha fazladır. Tepe lambası, ara\u0026ccedil; i\u0026ccedil;inde kullanılan taksimetre, navigasyon, telsiz, klima, radyo ve i\u0026ccedil; aydınlatmalar da taksilerin hem hareket halindeyken hem de motor kapalıyken kullanılan donanım ve cihazlarıdır. SFB Taksi Ak\u0026uuml;leri, taksilerin ticari faaliyetini sağlıklı yapabilmesi, taşıma hizmetini sorunsuz s\u0026uuml;rd\u0026uuml;rebilmesi ve kent trafiğini aksatacak y\u0026ouml;nde ak\u0026uuml; kaynaklı problemler yaşatmaması i\u0026ccedil;in ihtiya\u0026ccedil; duyulan enerjiyi sağlar. Bu kapsamda SFB Taksi Ak\u0026uuml;leri, standart ak\u0026uuml;lere oranla daha y\u0026uuml;ksek marş basma g\u0026uuml;c\u0026uuml;ne, titreşim dayanımına ve daha uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml;ne sahip olacak şekilde tasarlanmıştır.\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eMutlu Ak\u0026uuml;\u0026rsquo;n\u0026uuml;n ticari taksiler i\u0026ccedil;in \u0026ouml;zel olarak i\u0026ccedil;in geliştirdiği SFB Taksi Ak\u0026uuml;leri, SLI teknolojisine sahip sulu tip ak\u0026uuml;lerdir. Taksilerin marş ihtiyacını karşılayan SFB Taksi Ak\u0026uuml;leri, standart ak\u0026uuml;lere g\u0026ouml;re % 25\u0026rsquo;e kadar daha y\u0026uuml;ksek performans sunar. Uzun \u0026ccedil;alışma saatlerinde aracın ihtiya\u0026ccedil; duyduğu marş g\u0026uuml;c\u0026uuml;n\u0026uuml; ve motor \u0026ccedil;alışmadığında gereken enerjiyi \u0026uuml;retir. Patentli, kalsiyum (Ca) alaşımlı ızgara teknolojisine sahip olan SFB Taksi Ak\u0026uuml;leri, standart ak\u0026uuml;lere g\u0026ouml;re iki kat daha uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml;yle tasarlanmıştır. Bakım gerektirmeyen yapısı \u0026nbsp;ile kullanım kolaylığı sağlar. Standart ak\u0026uuml;lere g\u0026ouml;re daha y\u0026uuml;ksek titreşim dayanımına sahip olan SFB Taksi Ak\u0026uuml;leri, zorlu iklim şartlarında da y\u0026uuml;ksek performansla taksi kullanıcılarının dostudur.\u003c/p\u003e\n","slug":"sfb-taksi-akuleri","created_at":"2021-05-16T18:24:29.000000Z","updated_at":"2021-08-16T07:58:47.000000Z","long_description":"\u003cul\u003e\n\t\u003cli\u003eTaksilerin y\u0026uuml;ksek enerji ihtiya\u0026ccedil;larını karşılamak i\u0026ccedil;in tasarlanmış, y\u0026uuml;ksek kapasite ve marş g\u0026uuml;c\u0026uuml;ne sahip \u0026uuml;r\u0026uuml;n grubu\u003c/li\u003e\n\t\u003cli\u003eStandart ak\u0026uuml;lere g\u0026ouml;re daha sık kullanıma uygun, uzun \u0026ccedil;evrim \u0026ouml;mr\u0026uuml;\u003c/li\u003e\n\t\u003cli\u003eBakım gerektirmeyen \u0026uuml;r\u0026uuml;n teknolojisi\u003c/li\u003e\n\u003c/ul\u003e\n","group_name":"SFB Aküler","status_lang":1,"documents":{"id":426,"sector_id":29,"type":"coverWeb","path":"https://cdnd.mutlu.com.tr/sector/crops/_x_/92074.png","video_embed":"","created_at":"2024-10-22T13:06:51.000000Z","updated_at":"2024-10-22T13:06:51.000000Z","rank":0,"original_filename":null,"lang":"tr","description1":"","description2":""}},{"id":65,"sector_id":39,"lang":"tr","name":"SFB Askeri Tip Aküler","slogan":"","short_description":"\u003cp\u003eMutlu SFB Askeri Tip Ak\u0026uuml;ler, askeri ara\u0026ccedil; motorlarının \u0026ccedil;alışması i\u0026ccedil;in gereken marş g\u0026uuml;c\u0026uuml;n\u0026uuml; karşılayan SLI teknolojisine sahip sulu tip ak\u0026uuml;lerdir. Aynı zamanda ara\u0026ccedil;larda yer alan elektronik donanım ve te\u0026ccedil;hizatların ihtiya\u0026ccedil; duyduğu elektrik enerjisini sağlar. Patentli, kalsiyum (Ca) alaşımlı ızgara teknolojisiyle bakım gerektirmeyen yapıdadırlar. Mutlu SFB Askeri Tip Ak\u0026uuml;ler, y\u0026uuml;ksek marş g\u0026uuml;c\u0026uuml;, g\u0026uuml;\u0026ccedil;lendirilmiş i\u0026ccedil; yapıları ve darbelere karşı y\u0026uuml;ksek dayanımı gibi \u0026ouml;zellikleri sayesinde zorlu iklim şartlarına uygundur. Standart ak\u0026uuml;lere g\u0026ouml;re daha y\u0026uuml;ksek titreşim dayanımı sunmasıyla, engebeli arazilerde kullanım kolaylığı sağlar. Yanmayı geciktirici plastik malzemeden \u0026uuml;retilen \u0026ouml;zel kutu tasarımı ise maksimum seviyede g\u0026uuml;venliği ve emniyeti sunar. SFB Askeri Tip Ak\u0026uuml;ler, NATO VG95928 standardına uygun olarak \u0026uuml;retilmektedir.\u003c/p\u003e\n\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eMutlu Ak\u0026uuml;\u0026rsquo;n\u0026uuml;n SFB Askeri Tip Ak\u0026uuml;leri, savunma sanayinin kullandığı; kamyon, tank, panzer ve zırhlı ara\u0026ccedil;ların g\u0026ouml;revlerini uygun bir şekilde yapabilmesine destek olur. Ara\u0026ccedil;larda haberleşme, navigasyon ve cihaz şarj sistemleri gibi bir\u0026ccedil;ok elektrik ihtiyacı olan donanım ve ekipman i\u0026ccedil;in gereken enerjiyi sağlar. Y\u0026uuml;ksek titreşim direnci ve darbelere karşı dayanımı sayesinde, engebeli arazilerdeki zorlu g\u0026ouml;rev koşullarında ve değişken iklim şartlarında kullanıma uygundur. Y\u0026uuml;ksek marş g\u0026uuml;c\u0026uuml; ve standart ak\u0026uuml;lere oranla daha y\u0026uuml;ksek titreşim dayanımına sahip olması SFB Askeri Tip Ak\u0026uuml;lerin en \u0026ouml;nemli avantajları arasındadır.\u0026nbsp;\u003c/p\u003e\n","slug":"sfb-askeri-tip-akuler","created_at":"2021-05-19T13:39:05.000000Z","updated_at":"2021-08-16T08:00:49.000000Z","long_description":"\u003cul\u003e\n\t\u003cli\u003eAskeri tip ara\u0026ccedil;larda kullanım i\u0026ccedil;in geliştirilmiş, NATO VG95928 standartlarına uygun, sulu tip ak\u0026uuml; teknolojisi\u003c/li\u003e\n\t\u003cli\u003eY\u0026uuml;ksek marş g\u0026uuml;c\u0026uuml; ve g\u0026uuml;\u0026ccedil;lendirilmiş i\u0026ccedil; yapı\u003c/li\u003e\n\t\u003cli\u003eDarbelere karşı dayanımı sayesinde zorlu iklim şartlarında kullanım\u003c/li\u003e\n\t\u003cli\u003eYanmayı geciktirici plastik malzemeden \u0026uuml;retilen \u0026ouml;zel kutu tasarımı sayesinde y\u0026uuml;ksek g\u0026uuml;venlik\u003c/li\u003e\n\u003c/ul\u003e\n","group_name":"SFB Aküler","status_lang":1,"documents":{"id":90,"sector_id":39,"type":"coverWeb","path":"https://cdnd.mutlu.com.tr/sector/crops/_x_/SFB-Askeri-Tip-Akuler.png","video_embed":"","created_at":"2021-08-10T09:56:55.000000Z","updated_at":"2021-08-10T09:56:55.000000Z","rank":0,"original_filename":null,"lang":null,"description1":"","description2":""}}]},{"id":63,"group_name":"JEL Aküler","slug":"jel-akuler","items":[{"id":63,"sector_id":37,"lang":"tr","name":"JEL Aküler","slogan":"","short_description":"\u003cp\u003eMutlu JEL Ak\u0026uuml;ler; VRLA teknolojisine sahip, kuru ak\u0026uuml; kategorisinde yer alan ve bir\u0026ccedil;ok alanda kullanılabilen \u0026uuml;r\u0026uuml;nlerdir. İ\u0026ccedil;erisinde sıvı halde elektrolitin bulunmadığı jelleşmiş bir formu barındıran Mutlu JEL Ak\u0026uuml;ler\u0026rsquo;de, sıvı d\u0026ouml;k\u0026uuml;lmesi gibi problemler g\u0026ouml;r\u0026uuml;lmez. Mutlu JEL Ak\u0026uuml;ler, aynı zamanda minimum gaz \u0026ccedil;ıkışı \u0026ouml;zellikleriyle kapalı alanlarda kullanıma uygundur. \u0026Ouml;zellikle hobi ama\u0026ccedil;lı kullanımlarda, deniz ulaşımında ve \u0026ccedil;eşitli enerji sistemlerinde uzun kullanım \u0026ouml;mr\u0026uuml; ve dayanımıyla tercih edilirler. Bakım gerektirmeyen \u0026uuml;r\u0026uuml;n teknolojisine sahip Mutlu JEL ak\u0026uuml;ler, y\u0026uuml;ksek şarj-deşarj \u0026ccedil;evrimleri yapabilir ve derin deşarja uygundur. Zorlu iklim şartlarında standart ak\u0026uuml;lere g\u0026ouml;re daha \u0026uuml;st\u0026uuml;n performansla \u0026ccedil;alışan JEL Ak\u0026uuml;ler, y\u0026uuml;ksek titreşim dayanımlarıyla da bir\u0026ccedil;ok farklı kullanıma uyum sağlarlar.\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eMutlu JEL Ak\u0026uuml;ler, marin sekt\u0026ouml;r\u0026uuml; olarak bilinen tekne ve yat gibi deniz yolu ulaşım ara\u0026ccedil;larında yaygın olarak kullanılırlar. Mutlu JEL Ak\u0026uuml; teknolojisi, y\u0026uuml;ksek titreşim dayanımı sayesinde denizde karşılaşılabilecek zorlu iklim ve hava şartlarında kullanıma uygundur. Karavanlarda da uzun s\u0026uuml;re sorunsuzca kullanılabildikleri i\u0026ccedil;in Mutlu JEL Ak\u0026uuml;ler tercih edilebilir. \u0026nbsp;Sundukları y\u0026uuml;ksek performansla karavan i\u0026ccedil;erisinde yer alan elektriksel donanımların enerji ihtiya\u0026ccedil;larını da karşılarlar. Mutlu JEL Ak\u0026uuml;ler, g\u0026uuml;neş enerjisinden elektrik enerjisi elde eden solar sistemlerde de depolama ekipmanı olarak kullanılırlar. Bakım gerektirmeyen \u0026uuml;r\u0026uuml;n teknolojisiyle Mutlu JEL Ak\u0026uuml;ler, UPS sistemlerinin kullanıldığı hastane, santral, fabrika gibi alanlarda kesintisiz enerji sağlanmasına katkıda bulunur.\u0026nbsp;\u003c/p\u003e\n","slug":"jel-akuler","created_at":"2021-05-16T18:25:44.000000Z","updated_at":"2021-08-16T08:00:33.000000Z","long_description":"\u003cul\u003e\n\t\u003cli\u003eKurşun-asit ak\u0026uuml;ler arasındaki en y\u0026uuml;ksek \u0026ccedil;evrim \u0026ouml;mr\u0026uuml;ne sahip \u0026uuml;r\u0026uuml;n teknolojisi\u003c/li\u003e\n\t\u003cli\u003eDışarı gaz \u0026ccedil;ıkışı olmayan, kapalı alanlarda kullanıma uygun \u0026uuml;r\u0026uuml;n grubu\u003c/li\u003e\n\t\u003cli\u003eVRLA teknolojisi sayesinde uzun kullanım \u0026ouml;mr\u0026uuml;\u003c/li\u003e\n\u003c/ul\u003e\n","group_name":"JEL Aküler","status_lang":1,"documents":{"id":412,"sector_id":37,"type":"coverWeb","path":"https://cdnd.mutlu.com.tr/sector/crops/_x_/43984.png","video_embed":"","created_at":"2024-10-21T13:42:23.000000Z","updated_at":"2024-10-21T13:42:23.000000Z","rank":0,"original_filename":null,"lang":"tr","description1":"","description2":""}}]},{"id":62,"group_name":"Full Enerji Aküler","slug":"full-enerji-akuler","items":[{"id":62,"sector_id":36,"lang":"tr","name":"Full Enerji Aküler","slogan":"","short_description":"\u003cp\u003eMutlu Full Enerji Ak\u0026uuml;ler; uzun s\u0026uuml;reler boyunca \u0026ccedil;alışması gereken, \u0026nbsp;hobi veya ticari ama\u0026ccedil;lı olarak tercih edilebilen, enerji depolama \u0026ccedil;\u0026ouml;z\u0026uuml;mlerinde kullanılmak \u0026uuml;zere tasarlanmış ak\u0026uuml;lerdir. \u0026nbsp;D\u0026uuml;ş\u0026uuml;k su kaybı \u0026ouml;zelliğiyle \u0026ouml;ne \u0026ccedil;ıkan ve bakım gerektirmeyen \u0026uuml;r\u0026uuml;n teknolojisine sahiptir. Bir\u0026ccedil;ok farklı alanda kullanılabilen Full Enerji Ak\u0026uuml;ler, \u0026ouml;zellikle karavan, solar sistemler ve temizlik ekipmanları gibi devamlılık isteyen alanlarda kritik bir g\u0026uuml;\u0026ccedil; kaynağı olarak tercih edilmektedir. Geliştirilmiş i\u0026ccedil; yapısıyla y\u0026uuml;ksek \u0026ccedil;evrim \u0026ouml;mr\u0026uuml; sunar. Mutlu Full Enerji Ak\u0026uuml;ler, y\u0026uuml;ksek enerji gereksinimi olan uygulamalarda ise %50\u0026rsquo;ye kadar derin deşarj \u0026ouml;zelliğine sahiptir. Kalsiyum (Ca) alaşımlı ızgara teknolojili Mutlu Full Enerji Ak\u0026uuml;ler, \u0026ouml;zel tasarım koruma kapakları, g\u0026uuml;\u0026ccedil;lendirilmiş kurşun bağlantı giriftleri ve alev tutucu filtreleriyle g\u0026uuml;venli bir yapıdadır. \u0026nbsp;Mutlu Full Enerji Ak\u0026uuml;ler, zorlu iklim ve \u0026ccedil;alışma şartlarında standart ak\u0026uuml;lere g\u0026ouml;re daha \u0026uuml;st\u0026uuml;n bir performans ve titreşim dayanımı sunar.\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003e\u0026nbsp;\u003c/p\u003e\n\n\u003cp\u003eMutlu Ak\u0026uuml;\u0026rsquo;n\u0026uuml;n geniş bir kullanım alanı i\u0026ccedil;in sunduğu Full Enerji Ak\u0026uuml;ler, karavanlarda uzun soluklu olarak kullanılan buzdolabından televizyona, ekstra aydınlatmadan klimaya kadar bir\u0026ccedil;ok elektronik donanım ve cihazın ihtiyacı olan g\u0026uuml;c\u0026uuml; sunar. Farklı iklim koşullarında y\u0026uuml;ksek performansla \u0026ccedil;alışarak karavan kullanıcılarını yarı yolda bırakmaz. Kurulumunun ardından bakıma ihtiya\u0026ccedil; duymadan g\u0026uuml;neş enerjisini depolayan solar sistemlerde de bakım gerektirmeyen ak\u0026uuml;ler kullanılır. Bu kapsamda Full Enerji Ak\u0026uuml;ler, solar sistemlerde kullanım i\u0026ccedil;in de uygundur. Derin deşarja uygun yapısıyla kullanımı boyunca \u0026uuml;st\u0026uuml;n bir performans sergiler. Temizlik ekipmanları da g\u0026uuml;n i\u0026ccedil;inde uzun saatler boyunca kullanılabilen cihazlardır. Bu nedenle Full Enerji Ak\u0026uuml;ler, y\u0026uuml;ksek performanslarıyla temizlik ekipmanları i\u0026ccedil;in de uygun bir \u0026ccedil;\u0026ouml;z\u0026uuml;md\u0026uuml;r. \u0026Ouml;zellikle belediyeler, end\u0026uuml;striyel tesisler, fabrikalar ve \u0026ccedil;eşitli \u0026ouml;zel kuruluşlarda kullanılan farklı boyuttaki temizlik ekipmanlarında, Full Enerji Ak\u0026uuml;leri tercih edilir.\u0026nbsp;\u003c/p\u003e\n","slug":"full-enerji-akuler","created_at":"2021-05-16T18:25:34.000000Z","updated_at":"2021-08-16T08:00:15.000000Z","long_description":"\u003cul\u003e\n\t\u003cli\u003eEnerji depolama \u0026ccedil;\u0026ouml;z\u0026uuml;mlerinde kullanılmak \u0026uuml;zere tasarlanmış, y\u0026uuml;ksek \u0026ccedil;evrim \u0026ouml;mr\u0026uuml;ne sahip ak\u0026uuml; teknolojisi\u003c/li\u003e\n\t\u003cli\u003e%50\u0026rsquo;ye kadar derin deşarj (deep cycle) kapasitesi\u003c/li\u003e\n\t\u003cli\u003eKalsiyum (Ca) alaşımlı ızgara yapısı sayesinde bakım gerektirmeyen \u0026uuml;r\u0026uuml;n teknolojisi\u003c/li\u003e\n\u003c/ul\u003e\n","group_name":"Full Enerji Aküler","status_lang":1,"documents":{"id":427,"sector_id":36,"type":"coverWeb","path":"https://cdnd.mutlu.com.tr/sector/crops/_x_/44441.png","video_embed":"","created_at":"2024-10-22T13:08:13.000000Z","updated_at":"2024-10-22T13:08:13.000000Z","rank":0,"original_filename":null,"lang":"tr","description1":"","description2":""}}]}],"globalBlogCategories":[{"Id":22,"name":"Akü Hakkında","lang":"tr","slug":"aku-hakkinda"},{"Id":23,"name":"Akü Sözlük","lang":"tr","slug":"aku-sozluk"},{"Id":30,"name":"Tarihçe","lang":"tr","slug":"tarihce"}]},"redirectRoutes":[{"from":"/ar-ge-merkezi","to":"/arge-merkezi-ve-yatirimlar"},{"from":"/expanded","to":"/aku-hakkinda"},{"from":"/urunler/starter/hobi-ve-alternatif-enerji-akuleri/sfb/110","to":"/sfb-marin-akuler"},{"from":"/haberler/mutlu-aku-rusyada-teknolojilerini-tanitti","to":"/mutlu-aku-rusyada-teknolojilerini-tanitti"},{"from":"/punch","to":"/aku-hakkinda"},{"from":"/olcme","to":"/aku-olcumu-nasil-yapilir"},{"from":"/aku-takviyesi-nasil-yapilir","to":"/aku-takviyesi-nasil-yapilmali"},{"from":"/tvreklamvideolari?page=1","to":"/tv-reklamlari"},{"from":"/uyarilar","to":"/aku-hakkinda"},{"from":"/akunubul","to":"/akuBulucu/form"},{"from":"/radyojingillari?page=1","to":"/radyo-reklamlari"},{"from":"/aku-depolama-ve-saklama-kosullari","to":"/aku-nasil-saklanmali"},{"from":"/cevre-politikasi","to":"/cevre-politikamiz"},{"from":"/medya","to":"/radyo-reklamlari"},{"from":"/hobi-ve-alternatif-enerji-akuleri/efb/111","to":"/efb-akuler"},{"from